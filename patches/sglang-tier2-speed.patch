+@warmup("kt_extend")
+async def kt_extend(disaggregation_mode: str, tokenizer_manager: TokenizerManager):
+    """patches/sglang-kt-warmup-extend.py: extends of KT_WARMUP_EXTEND token counts (default 130,40) with
+    sampling, so the first user request does not pay the GDN checkpoint kernel compile (> 64 tokens), the
+    hyper-connection mix's dynamic-shape recompile or the sampling module's JIT load."""
+    import os
+    import time
+
+    lens = [int(x) for x in os.environ.get("KT_WARMUP_EXTEND", "130,40").split(",") if x.strip()]
+    rng = np.random.default_rng(0)
+    for n in lens:
+        t0 = time.perf_counter()
+        req = GenerateReqInput(
+            input_ids=rng.integers(1000, 30000, size=[n]).tolist(),
+            sampling_params={"max_new_tokens": 8, "temperature": 1.0, "top_p": 0.95, "top_k": 20},
+        )
+        if disaggregation_mode != "null":
+            req.bootstrap_room = 0
+            req.bootstrap_host = FAKE_BOOTSTRAP_HOST
+        async for _ in tokenizer_manager.generate_request(req, None):
+            pass
+        logger.info(f"[kt-warmup] extend of {n} tokens + 8 sampled in {time.perf_counter() - t0:.2f} s")
