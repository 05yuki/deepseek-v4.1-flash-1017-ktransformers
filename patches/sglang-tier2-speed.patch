+        _wrap(kgd, "attach_hc_fp8", "attach_hc_fp8 (hc int8/fp8 copies)")
+        _wrap(kgd, "attach_ssm_out_perms", "attach_ssm_out_perms")
+    except Exception as e:
+        log(f"kt_gguf_dense not wrapped: {e}")
+    # Safetensors MXFP4 serves (V4.1 / V4-Flash / Vision-Exp / MiMo, 10-12):
+    # kt-kernel's native wrapper, the GPU-streamed prefill's arenas and the
+    # safetensors weight iterator.
+    try:
+        from kt_kernel.utils import amx as kta
