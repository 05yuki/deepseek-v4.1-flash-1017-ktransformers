+def vision_hash_topk(moe, logits, input_ids, topk_output):
+    """Override the hash routing of image tokens with score top-k + VL bias.
+
+    V4.1 has no hash-routed MoE layers, so vision_topk never met one.
+    V4-Flash-Vision-Exp has three, and its reference Gate keeps tid2eid for
+    text while image tokens take (scores + bias_vl).topk -- without this they
+    all go to the fixed experts tid2eid[image_token_id]. Weights follow the
+    hash path: the chosen scores, renormalised, then the routed scale.
+    """
+    hash_topk = moe.topk
+    ids, weights = topk_output.topk_ids, topk_output.topk_weights
+    k = hash_topk.topk
+    if hash_topk.num_fused_shared_experts or ids.shape[-1] != k:
+        raise NotImplementedError(
+            "VL routing in hash layers assumes no fused shared experts"
+        )
