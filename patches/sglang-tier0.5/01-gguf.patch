                 gpu_method = self.quant_method
             elif quant_config is not None:
                 gpu_method = quant_config.get_quant_method(self, prefix)
diff --git a/python/sglang/srt/layers/moe/kt_gguf_dense_v41.py b/python/sglang/srt/layers/moe/kt_gguf_dense_v41.py
new file mode 100644
index 00000000..c5cd5f34
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_gguf_dense_v41.py
@@ -0,0 +1,188 @@
+"""Dense (non-expert) weights of a DeepSeek-V4.1 GGUF (llama.cpp arch "deepseek41") as the checkpoint's own
+tensor names, so DeepseekV4ForCausalLM.load_weights loads a GGUF the way it loads the safetensors checkpoint.
+
+The converter changed no values (every F32 / BF16 tensor is bit-identical to the
+checkpoint) and one shape: wo_a comes as [8, 1024, 4096] for [8192, 4096]. The pack's llama.cpp layout (2026-10-27
+and later) names engram_wkv engram_kv, keeps wo_a 2D, and folds engram_q and engram_k into the F32 engram_gate
+(q * k, exact), which is split back into a bf16 pair with exactly that product (_split_gate) and loaded as
+engram.q_weight / engram.k_weight; its vision router bias (exp_probs_b_vl) is skipped. Quantized tensors (Q5_K, Q8_0, ...)
+are dequantized to bf16 with gguf-py; F32 / BF16 are viewed. Not yielded: the routed experts
+(blk.N.ffn_*_exps, kt-kernel reads them from the same GGUF) and the engram tables (the engram adapter reads its
+rows itself). KT_GGUF_DENSE_THREADS=<n> dequantizes the big tensors in row blocks on n threads.
+
+With a model whose layers carry SGLang's GGUF linear method (quantization_config {"quant_method": "gguf",
+"modules_to_not_convert": [...]}), a quantized tensor whose layer has a .qweight parameter is yielded as its
+GGUF bytes (<name>.qweight, [rows, row bytes] uint8) and type (<name>.qweight_type), so it stays quantized on the
+GPU; everything else is dequantized as above.
+"""
+import glob
+import os
+import re
+from typing import Iterator, Tuple
+
+import numpy as np
+import torch
+
+import gguf.quants
+from gguf import GGUFReader
+
+_LAYER = {
+    "attn_norm": "attn_norm.weight",
+    "ffn_norm": "ffn_norm.weight",
+    "attn_q_a": "attn.wq_a.weight",
+    "attn_q_a_norm": "attn.q_norm.weight",
+    "attn_q_b": "attn.wq_b.weight",
+    "attn_kv": "attn.wkv.weight",
+    "attn_kv_a_norm": "attn.kv_norm.weight",
+    "attn_output_a": "attn.wo_a.weight",
+    "attn_output_b": "attn.wo_b.weight",
+    "attn_sinks": "attn.attn_sink",
+    "attn_compressor_kv": "attn.compressor.wkv.weight",
+    "attn_compressor_gate": "attn.compressor.wgate.weight",
+    "attn_compressor_norm": "attn.compressor.norm.weight",
+    "indexer.attn_q_b": "attn.indexer.wq_b.weight",
+    "indexer.attn_k": "attn.indexer.wk.weight",
+    "indexer.k_norm": "attn.indexer.k_norm.weight",
+    "indexer.proj": "attn.indexer.weights_proj.weight",
+    "ffn_gate_inp": "ffn.gate.weight",
+    "exp_probs_b": "ffn.gate.bias",
+    "ffn_gate_shexp": "ffn.shared_experts.w1.weight",
+    "ffn_down_shexp": "ffn.shared_experts.w2.weight",
+    "ffn_up_shexp": "ffn.shared_experts.w3.weight",
+    "hc_attn_base": "hc_attn_base",
+    "hc_attn_fn": "hc_attn_fn",
+    "hc_attn_scale": "hc_attn_scale",
+    "hc_ffn_base": "hc_ffn_base",
+    "hc_ffn_fn": "hc_ffn_fn",
+    "hc_ffn_scale": "hc_ffn_scale",
+    "engram_q": "engram.q_weight",
+    "engram_k": "engram.k_weight",
+    "engram_wkv": "engram.wkv.weight",
+    # the llama.cpp layout
+    "engram_kv": "engram.wkv.weight",
+    "engram_gate": "engram.gate",  # split into q_weight and k_weight (_split_gate)
+}
+_GLOBAL = {"token_embd": "embed.weight", "output": "head.weight", "output_norm": "norm.weight"}
+_SKIP = ("_exps", "engram_embd", "exp_probs_b_vl")
+
+
+def checkpoint_name(gguf_name: str):
+    """The checkpoint name of a GGUF tensor, or None for what this source does not serve."""
+    stem = re.sub(r"\.(weight|bias)$", "", gguf_name)
+    if stem in _GLOBAL:
+        return _GLOBAL[stem]
+    m = re.match(r"blk\.(\d+)\.(.+)$", stem)
+    if not m:
+        return None  # engram hash tables (engram_token_map / primes / offsets / multipliers): config, not weights
+    layer, key = int(m.group(1)), m.group(2)
+    if key.endswith(_SKIP):
+        return None
+    if key not in _LAYER:
+        raise KeyError(f"no checkpoint name for GGUF tensor {gguf_name}")
+    return f"layers.{layer}.{_LAYER[key]}"
+
+
+def _to_torch(t) -> torch.Tensor:
+    shape = tuple(int(x) for x in reversed(t.shape.tolist()))  # ggml order -> torch order
+    kind = t.tensor_type.name
+    raw = np.asarray(t.data)
+    if kind == "F32":
+        return torch.from_numpy(raw.view(np.float32).reshape(shape).copy())
+    if kind == "F16":
+        return torch.from_numpy(raw.view(np.float16).reshape(shape).copy()).to(torch.bfloat16)
+    if kind == "BF16":
+        return torch.from_numpy(raw.view(np.int16).reshape(shape).copy()).view(torch.bfloat16)
+    threads = int(os.environ.get("KT_GGUF_DENSE_THREADS", "8") or 1)
+    rows = raw.reshape(-1, raw.shape[-1])  # [..., row bytes]: blocks never cross a row
+    if threads > 1 and rows.shape[0] >= 4 * threads and raw.nbytes >= (32 << 20):
+        from concurrent.futures import ThreadPoolExecutor
+
+        parts = np.array_split(rows, 4 * threads, axis=0)
+        with ThreadPoolExecutor(max_workers=threads) as ex:
+            f = np.concatenate(list(ex.map(lambda r: gguf.quants.dequantize(r, t.tensor_type), parts)), axis=0)
+    else:
+        f = gguf.quants.dequantize(rows, t.tensor_type)
+    return torch.from_numpy(f.reshape(shape)).to(torch.bfloat16)
+
+
+_STACKED = ((".gate_proj.", ".gate_up_proj."), (".up_proj.", ".gate_up_proj."))
+
+
+def _quantized_params(model):
+    """Checkpoint name -> True for the tensors whose layer keeps GGUF bytes (has a .qweight)."""
+    if model is None:
+        return lambda name: False
+    params = {n for n, _ in model.named_parameters()}
+    remap = getattr(type(model), "remap_weight_name_to_dpsk_hf_format", None)
+    if remap is None:
+        return lambda name: False
+
+    def quantized(name):
+        if not name.endswith(".weight"):
+            return False
+        pname = remap(name)[: -len(".weight")] + ".qweight"
+        if pname in params:
+            return True
+        return any(a in pname and pname.replace(a, b) in params for a, b in _STACKED)
+
+    return quantized
+
+
+def _split_gate(g: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    """bf16 q, k with q * k == g exactly in fp32. g is a product of two bf16 values, so |g| = n * 2^E with n a product
+    of two integers below 256; any such pair of factors serves (the Engram gate multiplies q and k in fp32 first)."""
+    g = g.float().contiguous()
+    nz = g != 0
+    a = g.abs().masked_fill(~nz, 1.0)
+    _, e = torch.frexp(a)
+    n = torch.ldexp(a, 16 - e).round().long()  # 16-bit integer significand, exact: g has at most 16 significant bits
+    E = e - 16
+    tz = (n & -n).float().log2().long()  # strip the powers of two into the exponent
+    n, E = n >> tz, E + tz
+    d = torch.arange(1, 256, dtype=torch.long)
+    ok = (n.reshape(-1, 1) % d == 0) & (n.reshape(-1, 1) // d <= 255)
+    assert bool(ok.any(dim=1).all()), "engram_gate is not a product of two bf16 values"
+    qa = d[ok.float().argmax(dim=1)].reshape(n.shape)
+    kb = n // qa
+    q = (torch.ldexp(qa.float(), E) * torch.sign(g)).masked_fill(~nz, 0.0).to(torch.bfloat16)
+    k = kb.float().masked_fill(~nz, 1.0).to(torch.bfloat16)
+    assert torch.equal(q.float() * k.float(), g), "engram_gate split is not exact"
+    return q, k
+
+
+def gguf_v41_dense_weights(gguf_dir: str, model=None) -> Iterator[Tuple[str, torch.Tensor]]:
+    shards = sorted(glob.glob(os.path.join(gguf_dir, "*-000??-of-000??.gguf")))
+    if not shards:
+        raise FileNotFoundError(f"no GGUF shards (*-0000N-of-0000M.gguf) in {gguf_dir}")
+    quantized = _quantized_params(model)
+    for path in shards:
+        for t in GGUFReader(path).tensors:
+            name = checkpoint_name(t.name)
+            if name is None:
+                continue
+            if quantized(name):
+                base = name[: -len(".weight")]
+                if t.tensor_type.name in ("F32", "F16", "BF16"):
+                    # a GGUF linear whose weight the GGUF keeps unquantized: the bf16 matrix itself, typed BF16
+                    # (SGLang's GGUF method multiplies those directly)
+                    yield base + ".qweight_type", torch.tensor(30, dtype=torch.uint8)
+                    yield base + ".qweight", _to_torch(t).to(torch.bfloat16)
+                    continue
+                raw = torch.from_numpy(np.asarray(t.data).reshape(-1, np.asarray(t.data).shape[-1]).copy())
+                yield base + ".qweight_type", torch.tensor(int(t.tensor_type), dtype=torch.uint8)
+                yield base + ".qweight", raw
+                continue
+            w = _to_torch(t)
+            if name.endswith(".engram.gate"):
+                q, k = _split_gate(w)
+                yield name[: -len("gate")] + "q_weight", q
+                yield name[: -len("gate")] + "k_weight", k
+                continue
+            if name.endswith("attn.wo_a.weight") and w.dim() == 3:
+                w = w.reshape(-1, w.shape[-1])  # [8, 1024, 4096] -> [8192, 4096]
+            yield name, w
+    if model is not None:
+        # (runs once the loader has taken the last tensor) parameters nothing filled: a name map gap
+        left = [n for n, prm in model.named_parameters() if type(prm).__name__.endswith("UninitializedParameter")]
+        if left:
+            print(f"[kt-gguf-dense] {len(left)} parameters left uninitialized, e.g. {left[:8]}", flush=True)
diff --git a/python/sglang/srt/layers/moe/kt_gguf_dequant.py b/python/sglang/srt/layers/moe/kt_gguf_dequant.py
new file mode 100644
index 00000000..f234a909
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_gguf_dequant.py
@@ -0,0 +1,209 @@
+"""GGUF block dequantization on the GPU (Triton): IQ2_S, IQ3_XXS, IQ3_S,
+IQ4_XS, IQ4_NL and Q2_0 blocks to bf16 rows, for streaming GGUF experts
+through the W16 prefill path.
+
+Block layouts follow ggml-common.h / dequantize_row_* in ggml-quants.c
+(vendored a94e6ff87) and the upstream Q2_0 (type 42, 64-wide, codes -1..2).
+One program handles one block of one expert; raw bytes are expert-major with
+a byte stride, the output is [n, rows, cols] bf16 with contiguous rows, and a
+block covers BLCK consecutive elements of the flattened expert matrix.
+"""
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.layers.moe import kt_gguf_tables as T
+
+QK_K = 256
+
+GGML_IQ2_S = 22
+GGML_IQ3_XXS = 18
+GGML_IQ3_S = 21
+GGML_IQ4_XS = 23
+GGML_IQ4_NL = 20
+GGML_Q2_0 = 42
+
+# type id -> (block elements, block bytes)
+BLOCK_INFO = {
+    GGML_IQ2_S: (256, 82),
+    GGML_IQ3_XXS: (256, 98),
+    GGML_IQ3_S: (256, 110),
+    GGML_IQ4_XS: (256, 136),
+    GGML_IQ4_NL: (32, 18),
+    GGML_Q2_0: (64, 18),
+}
+
+_tables = {}
+
+
+def tables(device):
+    t = _tables.get(device)
+    if t is None:
+        u8 = torch.uint8
+        t = {
+            "iq2s": torch.tensor(T.IQ2S_GRID_BYTES, dtype=u8, device=device),
+            "iq3xxs": torch.tensor(T.IQ3XXS_GRID_BYTES, dtype=u8, device=device),
+            "iq3s": torch.tensor(T.IQ3S_GRID_BYTES, dtype=u8, device=device),
+            "ksigns": torch.tensor(T.KSIGNS_IQ2XS, dtype=u8, device=device),
+            "kvalues": torch.tensor(T.KVALUES_IQ4NL, dtype=torch.int8, device=device),
+        }
+        _tables[device] = t
+    return t
+
+
+@triton.jit
+def _d16(ptr):
+    # the block's fp16 scale at its first two bytes
+    return tl.load(ptr.to(tl.pointer_type(tl.float16))).to(tl.float32)
+
+
+@triton.jit
+def _iq2_s_kernel(raw_ptr, out_ptr, grid_ptr, raw_stride, out_stride, TYPE_SIZE: tl.constexpr):
+    e = tl.program_id(1)
+    b = tl.program_id(0)
+    base = raw_ptr + e * raw_stride + b * TYPE_SIZE
+    d = _d16(base)
+    j = tl.arange(0, 256)
+    ib32 = j // 32
+    l = (j % 32) // 8
+    jj = j % 8
+    qs = tl.load(base + 2 + ib32 * 4 + l).to(tl.int32)
+    sign = tl.load(base + 2 + 32 + ib32 * 4 + l).to(tl.int32)
+    qh = tl.load(base + 2 + 64 + ib32).to(tl.int32)
+    sc = tl.load(base + 2 + 72 + ib32).to(tl.int32)
+    idx = qs | ((qh << (8 - 2 * l)) & 0x300)
+    g = tl.load(grid_ptr + idx * 8 + jj).to(tl.float32)
+    nib = tl.where(l < 2, sc & 0xF, sc >> 4).to(tl.float32)
+    db = d * (0.5 + nib) * 0.25
+    neg = (sign & (tl.full([256], 1, tl.int32) << jj)) != 0
+    y = tl.where(neg, -db * g, db * g)
+    tl.store(out_ptr + e * out_stride + b * 256 + j, y.to(tl.bfloat16))
+
+
+@triton.jit
+def _iq3_xxs_kernel(raw_ptr, out_ptr, grid_ptr, ksigns_ptr, raw_stride, out_stride, TYPE_SIZE: tl.constexpr):
+    e = tl.program_id(1)
+    b = tl.program_id(0)
+    base = raw_ptr + e * raw_stride + b * TYPE_SIZE
+    d = _d16(base)
+    j = tl.arange(0, 256)
+    ib32 = j // 32
+    l = (j % 32) // 8
+    jj = j % 8
+    a0 = tl.load(base + 66 + ib32 * 4 + 0).to(tl.int32)
+    a1 = tl.load(base + 66 + ib32 * 4 + 1).to(tl.int32)
+    a2 = tl.load(base + 66 + ib32 * 4 + 2).to(tl.int32)
+    a3 = tl.load(base + 66 + ib32 * 4 + 3).to(tl.int32)
+    aux = a0 | (a1 << 8) | (a2 << 16) | (a3 << 24)
+    db = d * (0.5 + (a3 >> 4).to(tl.float32)) * 0.5
+    q3 = tl.load(base + 2 + ib32 * 8 + 2 * l + (jj // 4)).to(tl.int32)
+    g = tl.load(grid_ptr + q3 * 4 + (jj % 4)).to(tl.float32)
+    s = tl.load(ksigns_ptr + ((aux >> (7 * l)) & 127)).to(tl.int32)
+    neg = (s & (tl.full([256], 1, tl.int32) << jj)) != 0
+    y = tl.where(neg, -db * g, db * g)
+    tl.store(out_ptr + e * out_stride + b * 256 + j, y.to(tl.bfloat16))
+
+
+@triton.jit
+def _iq3_s_kernel(raw_ptr, out_ptr, grid_ptr, raw_stride, out_stride, TYPE_SIZE: tl.constexpr):
+    e = tl.program_id(1)
+    b = tl.program_id(0)
+    base = raw_ptr + e * raw_stride + b * TYPE_SIZE
+    d = _d16(base)
+    j = tl.arange(0, 256)
+    ib32 = j // 32
+    l = (j % 32) // 8
+    jj = j % 8
+    sub = jj // 4
+    qs = tl.load(base + 2 + ib32 * 8 + 2 * l + sub).to(tl.int32)
+    qh = tl.load(base + 66 + ib32).to(tl.int32)
+    idx = qs | ((qh << (8 - 2 * l - sub)) & 256)
+    g = tl.load(grid_ptr + idx * 4 + (jj % 4)).to(tl.float32)
+    sign = tl.load(base + 74 + ib32 * 4 + l).to(tl.int32)
+    sb = tl.load(base + 106 + ib32 // 2).to(tl.int32)
+    nib = tl.where((ib32 % 2) == 0, sb & 0xF, sb >> 4).to(tl.float32)
+    db = d * (1.0 + 2.0 * nib)
+    neg = (sign & (tl.full([256], 1, tl.int32) << jj)) != 0
+    y = tl.where(neg, -db * g, db * g)
+    tl.store(out_ptr + e * out_stride + b * 256 + j, y.to(tl.bfloat16))
+
+
+@triton.jit
+def _iq4_xs_kernel(raw_ptr, out_ptr, kvalues_ptr, raw_stride, out_stride, TYPE_SIZE: tl.constexpr):
+    e = tl.program_id(1)
+    b = tl.program_id(0)
+    base = raw_ptr + e * raw_stride + b * TYPE_SIZE
+    d = _d16(base)
+    j = tl.arange(0, 256)
+    ib = j // 32
+    jj = j % 32
+    q = tl.load(base + 8 + ib * 16 + (jj % 16)).to(tl.int32)
+    nib = tl.where(jj < 16, q & 0xF, q >> 4)
+    sl = tl.load(base + 4 + ib // 2).to(tl.int32)
+    sl = tl.where((ib % 2) == 0, sl & 0xF, sl >> 4)
+    sh = tl.load(base + 2).to(tl.int32) | (tl.load(base + 3).to(tl.int32) << 8)
+    ls = sl | (((sh >> (2 * ib)) & 3) << 4)
+    dl = d * (ls - 32).to(tl.float32)
+    v = tl.load(kvalues_ptr + nib).to(tl.float32)
+    tl.store(out_ptr + e * out_stride + b * 256 + j, (dl * v).to(tl.bfloat16))
+
+
+@triton.jit
+def _iq4_nl_kernel(raw_ptr, out_ptr, kvalues_ptr, raw_stride, out_stride, TYPE_SIZE: tl.constexpr):
+    # eight 32-wide blocks per program
+    e = tl.program_id(1)
+    b = tl.program_id(0)
+    j = tl.arange(0, 256)
+    bl = b * 8 + j // 32
+    jl = j % 32
+    base = raw_ptr + e * raw_stride + bl * TYPE_SIZE
+    d = tl.load(base.to(tl.pointer_type(tl.float16))).to(tl.float32)
+    q = tl.load(base + 2 + (jl % 16)).to(tl.int32)
+    nib = tl.where(jl < 16, q & 0xF, q >> 4)
+    v = tl.load(kvalues_ptr + nib).to(tl.float32)
+    tl.store(out_ptr + e * out_stride + b * 256 + j, (d * v).to(tl.bfloat16))
+
+
+@triton.jit
+def _q2_0_kernel(raw_ptr, out_ptr, raw_stride, out_stride, TYPE_SIZE: tl.constexpr):
+    # four 64-wide blocks per program
+    e = tl.program_id(1)
+    b = tl.program_id(0)
+    j = tl.arange(0, 256)
+    bl = b * 4 + j // 64
+    jl = j % 64
+    base = raw_ptr + e * raw_stride + bl * TYPE_SIZE
+    d = tl.load(base.to(tl.pointer_type(tl.float16))).to(tl.float32)
+    q = tl.load(base + 2 + jl // 4).to(tl.int32)
+    code = ((q >> (2 * (jl % 4))) & 3).to(tl.float32) - 1.0
+    tl.store(out_ptr + e * out_stride + b * 256 + j, (d * code).to(tl.bfloat16))
+
+
+def dequant_experts(raw: torch.Tensor, raw_stride: int, type_id: int, n: int, rows: int, cols: int,
+                    out: torch.Tensor) -> None:
+    """raw: uint8 device tensor, expert-major, raw_stride bytes per expert
+    (expert bytes = rows * cols / blck * type_size, padding allowed);
+    out: [n, rows, cols] bf16 with contiguous rows (out.stride(0) elements
+    between experts). Runs on the current stream."""
+    blck, tsize = BLOCK_INFO[type_id]
+    assert cols % blck == 0, (type_id, cols, blck)
+    assert out.stride(1) == cols and out.stride(2) == 1
+    assert raw_stride % 2 == 0
+    assert (rows * cols) % 256 == 0, (rows, cols)
+    # every kernel writes 256 elements per program
+    grid = (rows * cols // 256, n)
+    t = tables(out.device)
+    if type_id == GGML_IQ2_S:
+        _iq2_s_kernel[grid](raw, out, t["iq2s"], raw_stride, out.stride(0), TYPE_SIZE=tsize)
+    elif type_id == GGML_IQ3_XXS:
+        _iq3_xxs_kernel[grid](raw, out, t["iq3xxs"], t["ksigns"], raw_stride, out.stride(0), TYPE_SIZE=tsize)
+    elif type_id == GGML_IQ3_S:
+        _iq3_s_kernel[grid](raw, out, t["iq3s"], raw_stride, out.stride(0), TYPE_SIZE=tsize)
+    elif type_id == GGML_IQ4_XS:
+        _iq4_xs_kernel[grid](raw, out, t["kvalues"], raw_stride, out.stride(0), TYPE_SIZE=tsize)
+    elif type_id == GGML_IQ4_NL:
+        _iq4_nl_kernel[grid](raw, out, t["kvalues"], raw_stride, out.stride(0), TYPE_SIZE=tsize)
+    elif type_id == GGML_Q2_0:
+        _q2_0_kernel[grid](raw, out, raw_stride, out.stride(0), TYPE_SIZE=tsize)
+    else:
+        raise ValueError(f"no GPU dequantizer for ggml type {type_id}")
diff --git a/python/sglang/srt/layers/moe/kt_gguf_hot.py b/python/sglang/srt/layers/moe/kt_gguf_hot.py
new file mode 100644
index 00000000..4a1df7d3
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_gguf_hot.py
@@ -0,0 +1,330 @@
+"""Hot GPU experts straight from a GGUF, for the KT hybrid (--kt-method
+LLAMAFILE with KT_GGUF_DENSE): the GPU slots 0..num_gpu_experts-1 hold this
+rank's TP slice of the expert's raw GGUF blocks, and decode runs SGLang's
+MMVQ MoE kernel (sgl_kernel.ggml_moe_a8_vec: int8 activations, every K-quant
+and i-quant type) on them; windows of up to 4 tokens (decode, MTP verify) run
+kt_gguf_moe_multi instead (same sums, one read per expert, CPU routes skipped);
+longer windows (an extend below the streamer threshold) run that kernel's
+per-route build (moe_a8_vec_routes: ggml's IQ3_S vec_dot, which sgl-kernel's
+lacks; KT_GGUF_MOE_ROUTES=0 goes back to ggml_moe_a8_vec and the Q2_0 window loop).
+Prefill above the streamer threshold never gets here.
+With KV-lent hot experts (KT_HOT_KV_LEND=1, kt_hot_kv_lend.py) the layer carries
+per-slot pointer tables (layer.kt_kv_ptr13 / kt_kv_ptr2, slots 0..E_gpu-1 point
+into w13_qweight / w2_qweight, the lent ones into free KV pages) and the window
+kernel and its per-route build read the weights through them; the hot cache
+gives sgl-kernel's ggml_moe_a8_vec (KT_GGUF_MOE_ROUTES=0) resident-only ids.
+
+Layout per layer (E_gpu = num_gpu_experts, N = intermediate per rank, K = hidden):
+  w13_qweight  uint8 [E_gpu, 2N, row_bytes(K, gate/up type)]   rows [gate; up]
+  w2_qweight   uint8 [E_gpu, K,  row_bytes(N, down type)]
+Gate and up must share a type (they do in every llama.cpp quantization).
+The down of the Q2_0 layers (type 42; sgl-kernel has no kernel for it) stays
+2-bit: kt_gguf_moe_multi has a Q2_0 dot product, and those layers run the window
+kernel at every length. KT_GGUF_Q2_NATIVE=0 repacks it losslessly into Q8_0
+instead (same fp16 d, codes -1..2 as int8, two 32-blocks per 64-block, 4x the
+bytes) for the sgl-kernel path.
+"""
+import os
+import time
+from typing import Dict, Tuple
+
+import numpy as np
+import torch
+from torch.nn import Parameter
+
+from sglang.srt.layers.moe import kt_gguf_moe_multi as _multi
+
+# KT_HOT_FUSED_COMBINE=1 (10-13): the route weighting and the sum over top_k as one Triton kernel instead of
+# out.mul_(w) + moe_sum (an elementwise and a 4 us reduce per layer); bit-identical by construction.
+FUSED_COMBINE = os.environ.get("KT_HOT_FUSED_COMBINE", "1") == "1"
+_combine_kernel = None
+
+
+def _combine_kernel_fn():
+    import triton
+    import triton.language as tl
+
+    @triton.jit
+    def _kt_combine_kernel(out_ptr, w_ptr, res_ptr, K, TOPK: tl.constexpr, BLOCK: tl.constexpr):
+        t = tl.program_id(0)
+        offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+        m = offs < K
+        acc = tl.zeros((BLOCK,), dtype=tl.float32)
+        for k in tl.static_range(TOPK):
+            o = tl.load(out_ptr + (t * TOPK + k) * K + offs, mask=m, other=0.0).to(tl.float32)
+            wk = tl.load(w_ptr + t * TOPK + k).to(tl.bfloat16).to(tl.float32)  # mul_ cast w to bf16 first
+            acc += (o * wk).to(tl.bfloat16).to(tl.float32)
+        tl.store(res_ptr + t * K + offs, acc.to(tl.bfloat16), mask=m)
+
+    return _kt_combine_kernel
+
+
+def _combine(out, w):
+    """out [T, top_k, K] bf16 (the routes' rows), w [T, top_k]: sum_k bf16(out * w) in fp32, rounded once."""
+    global _combine_kernel
+    if _combine_kernel is None:
+        _combine_kernel = _combine_kernel_fn()
+    T, top_k, K = out.shape
+    out = out.contiguous()
+    res = torch.empty((T, K), dtype=out.dtype, device=out.device)
+    _combine_kernel[(T, (K + 1023) // 1024)](out, w.contiguous(), res, K, TOPK=top_k, BLOCK=1024)
+    return res
+from sglang.srt.layers.quantization.base_config import FusedMoEMethodBase
+
+GGML_Q8_0 = 8
+GGML_Q2_0 = 42
+BLOCK_INFO = {  # ggml type -> (block elements, block bytes)
+    8: (32, 34), 10: (256, 84), 11: (256, 110), 12: (256, 144), 13: (256, 176), 14: (256, 210),
+    16: (256, 66), 19: (256, 50), 20: (32, 18), 21: (256, 110), 22: (256, 82), 23: (256, 136),
+    18: (256, 98), 42: (64, 18), 17: (256, 74), 29: (256, 56),
+}
+MMVQ_TYPES = {2, 3, 6, 7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 18, 19, 20, 21, 22, 23, 29, 30}
+
+
+def _log(msg):
+    print(f"[kt-gguf-hot {time.strftime('%H:%M:%S')}] {msg}", flush=True)
+
+
+def _row_bytes(cols: int, t: int) -> int:
+    blck, ts = BLOCK_INFO[t]
+    assert cols % blck == 0, (cols, t)
+    return cols // blck * ts
+
+
+def q2_0_to_q8_0(raw: torch.Tensor) -> torch.Tensor:
+    """[..., n_blocks*18] Q2_0 bytes -> [..., n_blocks*2*34] Q8_0 bytes, exact."""
+    shape = raw.shape[:-1]
+    b = raw.reshape(-1, 18).numpy()
+    n = b.shape[0]
+    d = b[:, :2]
+    qs = b[:, 2:]  # 16 bytes, 4 codes each
+    codes = np.stack([(qs >> (2 * s)) & 3 for s in range(4)], axis=2).reshape(n, 64).astype(np.int8) - 1
+    out = np.empty((n, 2, 34), dtype=np.uint8)
+    out[:, :, :2] = d[:, None, :]
+    out[:, 0, 2:] = codes[:, :32].view(np.uint8)
+    out[:, 1, 2:] = codes[:, 32:].view(np.uint8)
+    return torch.from_numpy(out.reshape(*shape, -1))
+
+
+class _GGUFExperts:
+    """One reader shared by all layers of a rank."""
+
+    def __init__(self, path: str):
+        from kt_kernel.utils.loader import GGUFLoader
+
+        self.loader = GGUFLoader(path)
+        cfg = self.loader.get_model_config()
+        self.E = int(cfg["num_experts"])
+        self.inter = int(cfg["moe_intermediate_size"])
+        self.K = int(cfg["hidden_size"])
+
+    def _raw(self, name: str) -> Tuple[torch.Tensor, int]:
+        """The tensor's bytes as a view over the file mapping (the loader's
+        accessor copies; an expert tensor is 1-2 GB)."""
+        import warnings
+
+        info = self.loader.tensor_info[name]
+        t = int(info["dtype"])
+        blck, ts = BLOCK_INFO[t]
+        n_bytes = int(info["n_elements"]) // blck * ts
+        mm = self.loader.file_data_map[self.loader.tensor_file_map[name]]
+        raw = np.frombuffer(mm, dtype=np.uint8, count=n_bytes, offset=int(info["offset"]))
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")  # read-only buffer, only copied out
+            return torch.from_numpy(raw), t
+
+    def types(self, layer_idx: int) -> Tuple[int, int, int]:
+        return tuple(int(self.loader.get_ggml_type(f"blk.{layer_idx}.ffn_{p}_exps.weight")) for p in ("gate", "up", "down"))
+
+    def slice(self, layer_idx: int, proj: str, N: int, rank: int, experts: torch.Tensor) -> torch.Tensor:
+        """Raw bytes of this rank's TP part of the given logical experts: rows
+        [N*rank, N*(rank+1)) of gate/up, the matching K-columns (block-aligned)
+        of down. Returns uint8 [len(experts), rows, part_row_bytes]."""
+        data, t = self._raw(f"blk.{layer_idx}.ffn_{proj}_exps.weight")
+        blck, ts = BLOCK_INFO[t]
+        if proj != "down":
+            v = data.view(self.E, self.inter, (self.K // blck) * ts)[experts, N * rank:N * (rank + 1), :]
+        else:
+            v = data.view(self.E, self.K, self.inter // blck, ts)[experts, :, (N * rank) // blck:(N * (rank + 1)) // blck, :]
+            v = v.reshape(len(experts), self.K, -1)
+        return v.contiguous()
+
+
+_readers: Dict[str, _GGUFExperts] = {}
+
+
+def _reader(path: str) -> _GGUFExperts:
+    r = _readers.get(path)
+    if r is None:
+        r = _readers[path] = _GGUFExperts(path)
+    return r
+
+
+class KTGGUFHotExpertsMethod(FusedMoEMethodBase):
+    """GPU-expert method the KT wrapper wraps when the experts are a GGUF."""
+
+    # at streamed prefill sizes the wrapper skips this method and the GGUF
+    # streamer covers the hot slots too (its banks hold every expert); the
+    # MMVQ kernel is a decode kernel
+    streams_hot_experts = True
+
+    def __init__(self, kt_config, layer):
+        self.kt_config = kt_config
+        self.num_gpu_experts = kt_config.num_gpu_experts
+        self.reader = _reader(kt_config.weight_path)
+        self.rank, self.world = layer.moe_tp_rank, layer.moe_tp_size
+        # KT_GGUF_HOT_EP (on with more than one rank): whole experts on every rank, not a TP slice of each (a GGUF
+        # block of 256 values cannot be cut); kt_kv_hot_lend gives each rank its own experts' routes
+        self.ep = self.world > 1 and os.environ.get("KT_GGUF_HOT_EP", "1") == "1"
+        self.slice_rank = 0 if self.ep else self.rank
+        self.types = self.reader.types(kt_config.layer_idx)
+        if self.types[0] != self.types[1]:
+            raise RuntimeError(f"layer {kt_config.layer_idx}: gate {self.types[0]} and up {self.types[1]} differ")
+        self.type13 = self.types[0]
+        # Q2_0 downs stay 2-bit on the GPU: kt_gguf_moe_multi has a Q2_0 kernel
+        # (KT_GGUF_Q2_NATIVE=0 keeps the 4x Q8_0 repack for sgl-kernel's)
+        self.q2_native = os.environ.get("KT_GGUF_Q2_NATIVE", "1") == "1"
+        if self.types[2] == GGML_Q2_0:
+            self.type2 = GGML_Q2_0 if self.q2_native else GGML_Q8_0
+        else:
+            self.type2 = self.types[2]
+        for t in (self.type13, self.type2):
+            if t not in MMVQ_TYPES and not (t == GGML_Q2_0 and self.q2_native):
+                raise RuntimeError(f"layer {kt_config.layer_idx}: ggml type {t} has no MMVQ MoE kernel")
+        self.moe_runner_config = None
+
+    def create_weights(self, layer, num_experts, hidden_size, intermediate_size_per_partition, params_dtype,
+                       **extra_weight_attrs):
+        E, N, K = num_experts, intermediate_size_per_partition, hidden_size
+        if self.ep:
+            N = N * self.world
+        self.N, self.K = N, K
+        if (N if self.ep else N * self.world) != self.reader.inter or K != self.reader.K:
+            raise RuntimeError(f"GGUF experts {self.reader.inter}x{self.reader.K} vs layer {N}x{self.world} / {K}")
+        if E == 0:
+            return
+        dev = torch.device("cuda", torch.cuda.current_device())
+        # the loader never touches these (no checkpoint tensor maps here);
+        # process_weights_after_loading fills them from the GGUF
+        w13 = Parameter(torch.empty((E, 2 * N, _row_bytes(K, self.type13)), dtype=torch.uint8, device=dev), requires_grad=False)
+        w2 = Parameter(torch.empty((E, K, _row_bytes(N, self.type2)), dtype=torch.uint8, device=dev), requires_grad=False)
+        w13.weight_loader = w2.weight_loader = self._refuse_loader
+        layer.register_parameter("w13_qweight", w13)
+        layer.register_parameter("w2_qweight", w2)
+
+    @staticmethod
+    def _refuse_loader(param, loaded_weight, *a, **k):
+        raise RuntimeError("GGUF hot experts take no checkpoint expert tensors")
+
+    def process_weights_after_loading(self, layer) -> None:
+        E = layer.w13_qweight.shape[0] if hasattr(layer, "w13_qweight") else self.num_gpu_experts
+        if E == 0:
+            return
+        from sglang.srt.eplb.expert_location_dispatch import get_global_expert_location_metadata
+
+        meta = get_global_expert_location_metadata()
+        p2l = meta.physical_to_logical_map_cpu[self.kt_config.layer_idx][:E].to(torch.int64) if meta is not None else torch.arange(E)
+        self.fill_experts(layer, p2l)
+
+    def fill_experts(self, layer, p2l) -> None:
+        """The rows of the logical experts p2l (one a slot of layer.w13_qweight / w2_qweight) from the GGUF."""
+        E = int(p2l.numel())
+        t0 = time.time()
+        li, N = self.kt_config.layer_idx, self.N
+        gate = self.reader.slice(li, "gate", N, self.slice_rank, p2l)
+        up = self.reader.slice(li, "up", N, self.slice_rank, p2l)
+        layer.w13_qweight.data[:, :N].copy_(gate, non_blocking=False)
+        layer.w13_qweight.data[:, N:].copy_(up, non_blocking=False)
+        down = self.reader.slice(li, "down", N, self.slice_rank, p2l)
+        if self.types[2] == GGML_Q2_0 and self.type2 == GGML_Q8_0:
+            down = q2_0_to_q8_0(down)
+        assert tuple(down.shape) == tuple(layer.w2_qweight.shape), (down.shape, layer.w2_qweight.shape)
+        layer.w2_qweight.data.copy_(down)
+        if (li == 0 and E == self.num_gpu_experts) or os.environ.get("KT_GGUF_HOT_LOG") == "1":
+            mb = (layer.w13_qweight.numel() + layer.w2_qweight.numel()) / 1e6
+            _log(f"rank {self.rank}: layer {li} {E} hot experts from the GGUF, types {self.types} -> ({self.type13}, {self.type2}), "
+                 f"{mb:.0f} MB on the GPU, {time.time() - t0:.1f} s")
+
+    def create_moe_runner(self, layer, moe_runner_config):
+        self.moe_runner_config = moe_runner_config
+
+    def apply(self, layer, dispatch_output):
+        from sgl_kernel import ggml_moe_a8_vec, moe_sum, silu_and_mul
+
+        from sglang.srt.layers.moe.token_dispatcher import StandardCombineInput
+
+        x = dispatch_output.hidden_states
+        topk_weights, topk_ids, _ = dispatch_output.topk_output
+        T, top_k = topk_ids.shape
+        # KV-lent slots: the weights through the per-slot pointer tables
+        p13 = getattr(layer, "kt_kv_ptr13", None)
+        if self.ep and self.rank != 0 and p13 is None and not layer.__dict__.get("kt_hot_slots", False):
+            # the resident experts are whole on every rank: rank 0 adds them (the slots come in a shadow layer)
+            return StandardCombineInput(hidden_states=torch.zeros_like(x))
+        tbl = p13 is not None
+        W13 = p13 if tbl else layer.w13_qweight
+        W2 = layer.kt_kv_ptr2 if tbl else layer.w2_qweight
+        if T <= _multi.MAX_TOKENS and _multi.enabled():
+            # decode / MTP verify window: CPU routes (-1) give zero rows, so their
+            # weights need no masking; the routes of one expert share one read
+            # of it (kt_gguf_moe_multi.py)
+            w = topk_weights
+            ids = topk_ids.to(torch.int32)
+            h = _multi.moe_a8_vec_multi(x, W13, ids, top_k, self.type13, 2 * self.N, T, tbl)
+            h = silu_and_mul(h)
+            out = _multi.moe_a8_vec_multi(h, W2, ids, 1, self.type2, self.K, T * top_k, tbl)
+        elif _multi.ROUTES and _multi.enabled():
+            # an extend below the streamer threshold: the per-route build of the
+            # same kernel (identical sums per route to the window above; ggml's
+            # IQ3_S, which sgl-kernel's ggml_moe_a8_vec decodes with the
+            # pre-release grid and scale), CPU routes give zero rows
+            w = topk_weights
+            ids = topk_ids.to(torch.int32)
+            h = _multi.moe_a8_vec_routes(x, W13, ids, top_k, self.type13, 2 * self.N, T, tbl)
+            h = silu_and_mul(h)
+            out = _multi.moe_a8_vec_routes(h, W2, ids, 1, self.type2, self.K, T * top_k, tbl)
+        elif GGML_Q2_0 in (self.type13, self.type2):
+            # sgl-kernel has no Q2_0 kernel: the window kernel, 4 tokens at a time
+            # (an expert holds at most 4 routes of a window because the router's
+            # top-k ids are distinct within a token)
+            w = topk_weights
+            M, outs = _multi.MAX_TOKENS, []
+            for c0 in range(0, T, M):
+                c1 = min(T, c0 + M)
+                ids = topk_ids[c0:c1].to(torch.int32)
+                h = _multi.moe_a8_vec_multi(x[c0:c1], W13, ids, top_k, self.type13, 2 * self.N, c1 - c0, tbl)
+                h = silu_and_mul(h)
+                outs.append(_multi.moe_a8_vec_multi(h, W2, ids, 1, self.type2, self.K, (c1 - c0) * top_k, tbl))
+            out = torch.cat(outs)
+        else:
+            # the wrapper masks CPU experts to -1 and this kernel indexes by id:
+            # route those to slot 0 with weight 0. It reads the ids as int32
+            # without checking (int64 ids give every other route the wrong expert).
+            # It addresses base + id * stride: with KV-lent slots the hot cache
+            # hands this path resident-only ids (kt_gguf_moe_multi.reads_table)
+            on_gpu = topk_ids >= 0
+            w = torch.where(on_gpu, topk_weights, torch.zeros_like(topk_weights))
+            ids = torch.where(on_gpu, topk_ids, torch.zeros_like(topk_ids)).to(torch.int32)
+            h = ggml_moe_a8_vec(x, layer.w13_qweight, ids, top_k, self.type13, 2 * self.N, T)
+            h = silu_and_mul(h)
+            out = ggml_moe_a8_vec(h, layer.w2_qweight, ids, 1, self.type2, self.K, T * top_k)
+        if os.environ.get("KT_GGUF_HOT_DEBUG") == "1" and T <= 4 and not torch.cuda.is_current_stream_capturing():
+            _dbg = globals().setdefault("_DBG", [0])
+            if _dbg[0] < 12:
+                _dbg[0] += 1
+                torch.cuda.synchronize()
+                _log(f"debug layer {getattr(layer, 'layer_id', '?')} T {T} tbl {tbl} ids {topk_ids.tolist()} "
+                     f"w {[round(v, 3) for v in topk_weights.float().flatten().tolist()]} "
+                     f"x nan {int(x.float().isnan().sum())} |x| {float(x.float().abs().max()):.3g} "
+                     f"W13 {tuple(W13.shape)} {W13.dtype} ptr {W13.data_ptr():#x} "
+                     f"w13[0] bytes sum {int(layer.w13_qweight[0].view(torch.uint8).sum())} "
+                     f"w2[0] bytes sum {int(layer.w2_qweight[0].view(torch.uint8).sum())} "
+                     f"out nan {int(out.float().isnan().sum())} |out| {float(out.float().abs().nan_to_num().max()):.3g}")
+        if FUSED_COMBINE and T <= 64:
+            # one kernel for the weighting and the sum over the routes (same roundings and order as
+            # out.mul_(w) in bf16 followed by moe_sum's fp32 accumulation: identical results)
+            return StandardCombineInput(hidden_states=_combine(out.view(T, top_k, self.K), w.view(T, top_k)))
+        out = out.reshape(T, top_k, self.K).mul_(w.view(T, top_k, 1).to(out.dtype))
+        result = torch.empty_like(x)
+        moe_sum(out, result)
+        return StandardCombineInput(hidden_states=result)
