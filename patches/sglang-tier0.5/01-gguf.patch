+    block_size, type_size = gguf.GGML_QUANT_SIZES[qweight_type]
+    K = qweight.shape[1] // type_size * block_size
+    needed = (qweight.shape[0] - 1) * qweight.stride(0) + qweight.shape[1] + mmq_tail_bytes(qweight_type, K)
