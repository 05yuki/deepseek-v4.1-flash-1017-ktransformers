From 4b1a4c672b1320688dc46ed24eb46fded8c8e52f Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Fri, 23 Oct 2026 09:15:04 +0900
Subject: [PATCH] deepseek-v4.1: size the KV pool by the ratio-1/2 layout's own
 entry bytes

The pool configurator priced a ratio-1/2 compressed KV entry at kv_bytes,
the 584 bytes of a V4 FlashMLA slot, whatever layout the pool is built
with. With the V4.1 layouts (KVLayout.V41_FP4 for ratios 1 and 2) an
entry is 288 bytes, so a full token was costed at 1,630 bytes against the
890 the pools allocate, and the pool held 55% of the tokens its budget
covers. The entry is now priced by _get_paged_kv_bytes_per_token(ratio),
as the ratio-4 and ratio-128 pools already are.

DeepSeek-V4.1-Flash-1017 on one RTX 5070 Ti, the same 0.30 GB budget:
98,560 -> 180,480 tokens; the memory left after the pool is unchanged
(2.92 -> 2.86 GB), so the estimate now matches the allocation.

Prerequisites: none (11-v41-kv-layout makes V41_FP4 reachable on SM12x).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 python/sglang/srt/model_executor/pool_configurator.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/python/sglang/srt/model_executor/pool_configurator.py b/python/sglang/srt/model_executor/pool_configurator.py
index f3021ed026..aeb119e042 100644
--- a/python/sglang/srt/model_executor/pool_configurator.py
+++ b/python/sglang/srt/model_executor/pool_configurator.py
@@ -1367,7 +1367,11 @@ class DSV4PoolConfigurator(MemoryPoolConfigurator):
         """Compressed KV (+ indexer) bytes one full token adds per layer of `ratio`;
         compress state is priced per SWA slot (c4) or as fixed bytes (c128, ratio 2)."""
         if ratio in (1, 2):
-            return (self.kv_bytes + self.low_ratio_index_bytes) / ratio
+            # The entry in the pool's own layout: KVLayout.V41_FP4 is 288 bytes, not
+            # the 584 of a V4 FlashMLA slot.
+            return (
+                self._get_paged_kv_bytes_per_token(ratio) + self.low_ratio_index_bytes
+            ) / ratio
         if ratio == 4:
             c4_frac = 1 / (4 * self.c4_shrink_factor)
             return (
