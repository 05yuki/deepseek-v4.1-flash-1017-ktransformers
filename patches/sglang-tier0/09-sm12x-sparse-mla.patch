From c71a4f6c2ff893b96ef8fc73fee20b0969ff814f Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Mon, 19 Oct 2026 16:44:34 +0900
Subject: [PATCH] [tier 0] sm120: page-split the extra KV source and mask lanes
 past topk_length in sparse MLA

Only GPUs of compute capability 12.x run this file. The page-split
scratch converts the extra KV source (128-token pages) to 64-token pages
too, in its own buffer; without it the first prefill of DeepSeek-V4.1
stops with "Unsupported sparse-MLA prefill configuration". Index lanes
past topk_length are masked (a FlashInfer 0.6.18 bug corrupts prompts
over 64 tokens otherwise), and the reserved padding page is zeroed on
every conversion (dsv41-flash-dual-epyc#3 by f-wunderlich).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 .../kernels/ops/attention/flash_mla_sm120.py  | 47 ++++++++++++++++++-
 1 file changed, 45 insertions(+), 2 deletions(-)

diff --git a/python/sglang/kernels/ops/attention/flash_mla_sm120.py b/python/sglang/kernels/ops/attention/flash_mla_sm120.py
index 906d4aa2..1dcaec4c 100644
--- a/python/sglang/kernels/ops/attention/flash_mla_sm120.py
+++ b/python/sglang/kernels/ops/attention/flash_mla_sm120.py
@@ -246,6 +246,33 @@ def _flash_mla_sm120_prefill(
         if extra_indices is not None and extra_indices.dim() == 3
         else extra_indices
     )
+    # FlashInfer 0.6.18's SM120 prefill orchestrator does not bound the index
+    # lanes past topk_length (flashinfer-ai/flashinfer#5095, fix pending in
+    # #5075): prompts over 64 tokens read stale lanes and come back corrupted.
+    # Mask them to -1 here, which the kernel already treats as "no entry".
+    if topk_length is not None:
+        ar = torch.arange(idx.shape[-1], device=idx.device)
+        idx = torch.where(ar[None, :] < topk_length.view(-1, 1), idx, torch.full_like(idx, -1))
+    if extra_idx is not None and extra_topk_length is not None:
+        ar = torch.arange(extra_idx.shape[-1], device=extra_idx.device)
+        extra_idx = torch.where(
+            ar[None, :] < extra_topk_length.view(-1, 1), extra_idx, torch.full_like(extra_idx, -1)
+        )
+    # V4.1 ratio-1/2 sources use 256/128-token pages. The prefill
+    # specialization needs 64-token pages for both sources, with independent
+    # scratch buffers so converting the extra source cannot overwrite SWA.
+    # V4-Flash's ratio-128 source has 2-entry pages, which the decode path
+    # already hands over unconverted; only pages that are a multiple of 64
+    # get split (09-16).
+    if (
+        extra_kv_u8 is not None
+        and extra_kv_u8.shape[1] > _PBS_DST
+        and extra_kv_u8.shape[1] % _PBS_DST == 0
+    ):
+        extra_kv_u8 = _split_kv_pages_to_64(
+            extra_kv_u8, extra_kv_u8.shape[1],
+            touched_indices=extra_idx, buffer_tag="extra",
+        )
     output = q2.new_empty((num_tokens, num_heads, head_dim_v), dtype=torch.bfloat16)
     out_lse = torch.empty((num_tokens, num_heads), dtype=torch.float32, device=dev)
     _sparse_mla_sm120_paged_attention(
@@ -391,6 +418,21 @@ def _page_split_kernel(
     if page_idx >= N_pages:
         return
 
+    # SGLang's paged allocator reserves page 0 for padding. FlashInfer maps
+    # negative indices to entry 0 before masking scores; a masked NaN value
+    # still poisons XV (0 * NaN). The touched-page optimization otherwise
+    # leaves this scratch page uninitialized, or copies dummy-token garbage.
+    # Clear it on every conversion, including captured replays, without an
+    # extra launch. Other sub-pages keep their existing conversion behavior.
+    # (dsv41-flash-dual-epyc#3)
+    if pid == 0:
+        sentinel = dst_ptr.to(tl.pointer_type(tl.uint64))
+        for start in tl.range(0, dst_stride0 // 8, BLOCK_SIZE):
+            offs = start + tl.arange(0, BLOCK_SIZE)
+            tl.store(sentinel + offs, tl.full((BLOCK_SIZE,), 0, tl.uint64),
+                     mask=offs < dst_stride0 // 8)
+        return
+
     if HAS_MASK:
         if tl.load(mask_ptr + page_idx) == 0:
             return
@@ -449,6 +491,7 @@ def _split_kv_pages_to_64(
     kv_u8: torch.Tensor,
     src_pbs: int,
     touched_indices: Optional[torch.Tensor] = None,
+    buffer_tag: str = "primary",
 ) -> torch.Tensor:
     """Split pbs=N footer-format pages into pbs=64 footer-format pages.
 
@@ -472,7 +515,7 @@ def _split_kv_pages_to_64(
     # Pre-allocated grow-only buffer for page-split output per device.
     dev = kv_u8.device
     buffers = get_resources().buffers
-    key = f"flash_mla_sm120_split:{dev}"
+    key = f"flash_mla_sm120_split:{dev}:{buffer_tag}"
     buf = buffers.get(key)
     if buf is None or buf.shape[0] < num_dst_pages:
         # The first allocation can happen under inference mode (autotune), but
@@ -501,7 +544,7 @@ def _split_kv_pages_to_64(
     if use_mask:
         # Persistent per-device int8 mask, zeroed each call (cheap memset,
         # captured cleanly by CUDA graph). 1 = page is referenced this step.
-        mkey = f"flash_mla_sm120_mask:{dev}"
+        mkey = f"flash_mla_sm120_mask:{dev}:{buffer_tag}"
         mbuf = buffers.get(mkey)
         if mbuf is None or mbuf.shape[0] < N:
             # The first allocation can happen under inference mode (autotune),
