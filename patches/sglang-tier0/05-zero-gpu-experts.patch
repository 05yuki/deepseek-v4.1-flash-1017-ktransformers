From ea7ecdda93e2f963aca4954b4e13e90728af00c2 Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Mon, 19 Oct 2026 16:44:33 +0900
Subject: [PATCH] [tier 0] kt: run with zero GPU experts (--kt-num-gpu-experts
 0)

With no resident GPU experts there is nothing to run on the GPU side,
and the FlashInfer MXFP4 runner refuses a zero-expert workspace. The GPU
call is skipped and the CPU output is the result.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 python/sglang/srt/layers/moe/kt_ep_wrapper.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/python/sglang/srt/layers/moe/kt_ep_wrapper.py b/python/sglang/srt/layers/moe/kt_ep_wrapper.py
index 168f277b..97982532 100644
--- a/python/sglang/srt/layers/moe/kt_ep_wrapper.py
+++ b/python/sglang/srt/layers/moe/kt_ep_wrapper.py
@@ -403,11 +403,15 @@ class KTEPWrapperMethod(FusedMoEMethodBase):
         )
 
         # Step 3: Execute GPU expert computation (any quantization method)
-        # This runs in parallel with CPU computation
-        gpu_combine_input = self.gpu_method.apply(layer, masked_dispatch_output)
+        # This runs in parallel with CPU computation. With no resident GPU
+        # experts (--kt-num-gpu-experts 0) there is nothing to run, and the
+        # FlashInfer MXFP4 runner refuses a zero-expert workspace.
+        if self.num_gpu_experts > 0:
+            output = self.gpu_method.apply(layer, masked_dispatch_output).hidden_states
+        else:
+            output = torch.zeros_like(x)
 
         # Step 4: Synchronize CPU results and merge with GPU results
-        output = gpu_combine_input.hidden_states
         if self.tp_rank == 0:
             cpu_output = self.sync(x)
             output = output + cpu_output
