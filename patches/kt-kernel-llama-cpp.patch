+// MXFP4 (OCP microscaling FP4): E2M1 LUT scaled by two so the factor of one
+// half can be folded into the E8M0 scale conversion below.
+static const int8_t kvalues_mxfp4[16] = {0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12};
+
+static inline float ggml_e8m0_to_fp32_half(uint8_t x) {
+    uint32_t bits;
+    if (x < 2) {
+        bits = (uint32_t) 0x00200000 << x;
+    } else {
+        bits = (uint32_t) (x - 1) << 23;
+    }
+    float result;
+    memcpy(&result, &bits, sizeof(float));
+    return result;
+}
+#define GGML_E8M0_TO_FP32_HALF(x) ggml_e8m0_to_fp32_half(x)
+
+void dequantize_row_mxfp4(const block_mxfp4 * restrict x, float * restrict y, int64_t k) {
+    assert(k % QK_MXFP4 == 0);
+    const int64_t nb = k / QK_MXFP4;
+
+    for (int i = 0; i < nb; i++) {
+        const uint8_t * qs = x[i].qs;
+        const float d = GGML_E8M0_TO_FP32_HALF(x[i].e);
+        for (int j = 0; j < QK_MXFP4/2; ++j) {
+            y[j]              = d * kvalues_mxfp4[qs[j] & 0xf];
+            y[j + QK_MXFP4/2] = d * kvalues_mxfp4[qs[j] >> 4];
+        }
+        y += QK_MXFP4;
+    }
+}
+
+// Q2_0 (upstream type 42): codes 0..3 map to -1, 0, +1, +2 times the block scale.
+// ====================== kt IQ4_LUT: decode repack of IQ2_S / IQ3_XXS / IQ3_S
+// nibble = sign<<3 | index into the source grid's magnitude table; one type per grid
+
+const int8_t kvalues_iq4lut3s[16] = {1, 3, 5, 7, 9, 11, 13, 15, -1, -3, -5, -7, -9, -11, -13, -15};
+const int8_t kvalues_iq4lut3x[16] = {4, 12, 20, 28, 36, 44, 52, 62, -4, -12, -20, -28, -36, -44, -52, -62};
+const int8_t kvalues_iq4lut2s[16] = {8, 25, 43, 0, 0, 0, 0, 0, -8, -25, -43, 0, 0, 0, 0, 0};
+
+static void dequantize_row_iq4_lut_impl(const block_iq4_lut * restrict x, float * restrict y, int64_t k, const int8_t * lut) {
+    assert(k % QK_K == 0);
+    const int64_t nb = k / QK_K;
+    for (int64_t i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+        const uint8_t * qs = x[i].qs;
+        for (int ib = 0; ib < QK_K/32; ++ib) {
+            const float d0 = d * x[i].scales[2*ib], d1 = d * x[i].scales[2*ib+1];
+            for (int j = 0; j < 16; ++j) {
+                y[j]    = d0 * lut[qs[j] & 0xf];
+                y[j+16] = d1 * lut[qs[j] >> 4];
+            }
+            y += 32; qs += 16;
+        }
+    }
+}
+
+static void ggml_vec_dot_iq4_lut_impl(int n, float * restrict s, const void * restrict vx, const void * restrict vy, const int8_t * lut) {
+    const block_iq4_lut * restrict x = vx;
+    const block_q8_K    * restrict y = vy;
+    const int nb = n / QK_K;
+    float sumf = 0;
+    for (int i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d) * y[i].d;
+        const uint8_t * qs = x[i].qs;
+        const int8_t  * q8 = y[i].qs;
+        int32_t sumi = 0;
+        for (int ib = 0; ib < QK_K/32; ++ib) {
+            int32_t s0 = 0, s1 = 0;
+            for (int j = 0; j < 16; ++j) {
+                s0 += q8[j]    * lut[qs[j] & 0xf];
+                s1 += q8[j+16] * lut[qs[j] >> 4];
+            }
+            sumi += s0 * x[i].scales[2*ib] + s1 * x[i].scales[2*ib+1];
+            qs += 16; q8 += 32;
+        }
+        sumf += d * sumi;
+    }
+    *s = sumf;
+}
+
+#define KT_IQ4LUT_FUNCS(suffix, table) \
