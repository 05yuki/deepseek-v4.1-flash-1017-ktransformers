+        for (int h = 0; h < 2; ++h) {
+            const __m128i bytes8 = _mm_loadl_epi64((const __m128i *)(x[ib].qs + 8*h));
+            const __m256i lo = _mm256_and_si256(_mm256_srli_epi16(_mm256_mullo_epi16(_mm256_cvtepu8_epi16(_mm_shuffle_epi8(bytes8, rep_lo)), factors), 6), m3);
+            const __m256i hi = _mm256_and_si256(_mm256_srli_epi16(_mm256_mullo_epi16(_mm256_cvtepu8_epi16(_mm_shuffle_epi8(bytes8, rep_hi)), factors), 6), m3);
+            const __m256i q = _mm256_sub_epi8(_mm256_permute4x64_epi64(_mm256_packus_epi16(lo, hi), 0xd8), mone);
