+    for (int64_t i = 0; i < nb; i++) {
+        block_iq4_lut * o = dst + i;
+        if (src_type == GGML_TYPE_IQ3_XXS) {
+            const block_iq3_xxs * x = (const block_iq3_xxs *)src + i;
+            // y = d * (0.5 + s) * 0.5 * grid = d/4 * (2s+1) * grid
+            o->d = GGML_FP32_TO_FP16(GGML_FP16_TO_FP32(x->d) * 0.25f);
+            const uint8_t * qs = x->qs;
+            const uint8_t * sas = qs + QK_K/4;
+            for (int ib32 = 0; ib32 < QK_K/32; ++ib32) {
+                uint32_t aux32; memcpy(&aux32, sas + 4*ib32, sizeof(uint32_t));
+                o->scales[2*ib32] = o->scales[2*ib32+1] = (int8_t)(2*(aux32 >> 28) + 1);
+                for (int l = 0; l < 4; ++l) {
+                    const uint8_t signs = ksigns_iq2xs[(aux32 >> 7*l) & 127];
+                    const uint8_t * g1 = (const uint8_t *)(iq3xxs_grid + qs[2*l+0]);
+                    const uint8_t * g2 = (const uint8_t *)(iq3xxs_grid + qs[2*l+1]);
+                    int8_t * v = vals + 32*ib32 + 8*l;
+                    for (int j = 0; j < 4; ++j) {
+                        v[j]   = (signs & kmask_iq2xs[j])   ? -(int8_t)g1[j] : (int8_t)g1[j];
+                        v[j+4] = (signs & kmask_iq2xs[j+4]) ? -(int8_t)g2[j] : (int8_t)g2[j];
+                    }
+                }
+                qs += 8;
+            }
+        } else if (src_type == GGML_TYPE_IQ3_S) {
+            const block_iq3_s * x = (const block_iq3_s *)src + i;
+            // y = d * (1 + 2s) * grid
+            o->d = x->d;
+            const uint8_t * qs = x->qs;
+            const uint8_t * qh = x->qh;
+            const uint8_t * signs = x->signs;
+            for (int ib32 = 0; ib32 < QK_K/32; ++ib32) {
+                const int sc = (ib32 & 1) ? (x->scales[ib32/2] >> 4) : (x->scales[ib32/2] & 0xf);
+                o->scales[2*ib32] = o->scales[2*ib32+1] = (int8_t)(1 + 2*sc);
+                for (int l = 0; l < 4; ++l) {
+                    const uint8_t * g1 = (const uint8_t *)(iq3s_grid + (qs[2*l+0] | ((qh[ib32] << (8-2*l)) & 256)));
+                    const uint8_t * g2 = (const uint8_t *)(iq3s_grid + (qs[2*l+1] | ((qh[ib32] << (7-2*l)) & 256)));
+                    int8_t * v = vals + 32*ib32 + 8*l;
+                    for (int j = 0; j < 4; ++j) {
+                        v[j]   = (signs[l] & kmask_iq2xs[j])   ? -(int8_t)g1[j] : (int8_t)g1[j];
+                        v[j+4] = (signs[l] & kmask_iq2xs[j+4]) ? -(int8_t)g2[j] : (int8_t)g2[j];
+                    }
+                }
+                qs += 8; signs += 4;
+            }
+        } else if (src_type == GGML_TYPE_IQ2_S) {
+            const block_iq2_s * x = (const block_iq2_s *)src + i;
+            // y = d * (0.5 + s) * 0.25 * grid = d/8 * (2s+1) * grid, s per 16 weights
+            o->d = GGML_FP32_TO_FP16(GGML_FP16_TO_FP32(x->d) * 0.125f);
+            const uint8_t * qs = x->qs;
+            const uint8_t * qh = x->qh;
+            const uint8_t * signs = qs + QK_K/8;
+            for (int ib32 = 0; ib32 < QK_K/32; ++ib32) {
+                o->scales[2*ib32]   = (int8_t)(2*(x->scales[ib32] & 0xf) + 1);
+                o->scales[2*ib32+1] = (int8_t)(2*(x->scales[ib32] >>  4) + 1);
