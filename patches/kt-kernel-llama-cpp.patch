+                sumi += ((int)((byte >> 2) & 3) - 1) * yb->qs[4*b + 1];
+                sumi += ((int)((byte >> 4) & 3) - 1) * yb->qs[4*b + 2];
+                sumi += ((int)((byte >> 6) & 3) - 1) * yb->qs[4*b + 3];
+            }
+            sumf += dx * GGML_FP16_TO_FP32(yb->d) * sumi;
+        }
+    }
+    *s = sumf;
+}
