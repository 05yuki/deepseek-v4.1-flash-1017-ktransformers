+        case GGML_TYPE_IQ3_S:   return GGML_TYPE_IQ4_LUT3S;
+        case GGML_TYPE_IQ3_XXS: return GGML_TYPE_IQ4_LUT3X;
+        case GGML_TYPE_IQ2_S:   return GGML_TYPE_IQ4_LUT2S;
