+// magnitude -> index in the (positive half of the) table; the grids hold only these values
+static inline uint8_t iq4lut_nibble(int v, const int8_t * lut) {
+    const int a = v < 0 ? -v : v;
+    for (int m = 0; m < 8; ++m) {
+        if (lut[m] == a) return (uint8_t)((v < 0 ? 8 : 0) | m);
+    }
+    GGML_ASSERT(false && "kt_repack_to_iq4_lut: grid value outside the magnitude table");
+    return 0;
+}
