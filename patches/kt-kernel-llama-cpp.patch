+void kt_repack_to_iq4_lut(const void * restrict src, enum ggml_type src_type, block_iq4_lut * restrict dst, int64_t k) {
+    assert(k % QK_K == 0);
+    const int64_t nb = k / QK_K;
+    const int8_t * lut = src_type == GGML_TYPE_IQ3_S ? kvalues_iq4lut3s : src_type == GGML_TYPE_IQ3_XXS ? kvalues_iq4lut3x : kvalues_iq4lut2s;
