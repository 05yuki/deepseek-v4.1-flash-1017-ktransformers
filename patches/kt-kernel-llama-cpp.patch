+                }
+                qs += 4; signs += 4;
+            }
+        } else {
+            GGML_ASSERT(false && "kt_repack_to_iq4_lut: unsupported source type");
+        }
+        for (int ib = 0; ib < QK_K/32; ++ib) {
+            const int8_t * v = vals + 32*ib;
+            for (int j = 0; j < 16; ++j) {
+                o->qs[16*ib + j] = (uint8_t)(iq4lut_nibble(v[j], lut) | (iq4lut_nibble(v[j+16], lut) << 4));
+            }
+        }
+    }
+}
