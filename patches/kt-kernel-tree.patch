+// The TP split of the intermediate dimension for GGUF experts: one block of
+// the down projection's type, so every part contracts over whole blocks
+// (256 for the K/IQ types, 32 for IQ4_NL, 64 for Q2_0).
+inline int llamafile_split_granularity(const GeneralMOEConfig& config) {
+  return ggml_blck_size((ggml_type)config.down_type);
+}
+
+// Rows per work item in forward_many: the widest of 256/128/64/32 that
+// divides the row count, so intermediate sizes like 320 (640 split in two)
+// are covered completely instead of truncated to a multiple of 256.
+inline int llamafile_row_block(int rows) {
+  for (int b = 256; b > 32; b /= 2) {
+    if (rows % b == 0) return b;
+  }
+  return 32;
+}
+
+// forward_many row tiles for small windows (decode batches, MTP verify): a few
+// experts must still make enough tasks for the part's threads
+// (kt-llamafile-many-small-block.py)
+inline int many_env_int(const char* name, int dflt) {
+  const char* e = getenv(name);
