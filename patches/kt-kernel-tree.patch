+// EXL3 (ExLlamaV3 "mul1" trellis) expert GEMV core for kt-kernel, AVX2 tier.
+// Port of exllamav3/exllamav3_ext/cpu/moe_mul1.cpp (v1.6.1, the group-2 + planar AVX2 kernel):
+// the mul1 codebook is affine in a byte-sum, w(s) = (bytesum(s * 0x83DCD12D) - 510) * k_inv, so
+// with int8 activations x8 (one scale q per row) the dequant and the product fuse into integer
+// dot products: sum_k w_kn x_k = k_inv * q * (sum_k bytesum(s_kn * M) * x8_k - 510 * sum_k x8_k).
+// No torch, no pool: the caller owns threads and hands tile ranges in.
+#pragma once
+#include <immintrin.h>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace exl3 {
+
+constexpr uint32_t MUL1_MULT = 0x83DCD12Du;
+constexpr float HAD_SCALE = 0.088388347648f;  // 1 / sqrt(128)
+
+#define EXL3_AVX2 __attribute__((target("avx2,fma,f16c")))
+#define EXL3_INLINE inline __attribute__((always_inline))
+
+inline float fp16_to_float(uint16_t h) { return _cvtsh_ss(h); }
+inline float mul1_k_inv() { return fp16_to_float(0x1eee); }
+
+// A quantized matrix [k, n] (k inputs, n outputs) in 16x16 tiles of 256 weights, each tile
+// 16 * bits u16 words. Native layout: tile (kt, nt) at (kt * tiles_n + nt) * tile_u16.
+// Packed (group-2 planar) layout, what the kernel reads: tile at ((nt / 2) * tiles_k + kt) * 2
+// + nt % 2, and inside the tile dword w moved to 8 * (w % bits) + w / bits.
+struct Mat {
+  const uint16_t* trellis = nullptr;  // packed, see above
+  const uint16_t* suh = nullptr;      // [k] fp16 input signs
+  const uint16_t* svh = nullptr;      // [n] fp16 output signs
+  int k = 0, n = 0, bits = 0;
+};
+
+constexpr int tile_u16(int bits) { return 16 * bits; }
+constexpr int tile_words32(int bits) { return 8 * bits; }
+
+// ---- format tables (compile-time), as in moe_mul1.cpp ----
+
+constexpr std::array<uint16_t, 256> make_tc_perm() {
+  std::array<uint16_t, 256> p{};
+  for (int t = 0; t < 32; ++t) {
+    const int r0 = (t % 4) * 2, r1 = r0 + 1, r2 = r0 + 8, r3 = r0 + 9;
+    const int c0 = t / 4, c1 = c0 + 8;
+    p[t * 8 + 0] = r0 * 16 + c0; p[t * 8 + 1] = r1 * 16 + c0;
+    p[t * 8 + 2] = r2 * 16 + c0; p[t * 8 + 3] = r3 * 16 + c0;
+    p[t * 8 + 4] = r0 * 16 + c1; p[t * 8 + 5] = r1 * 16 + c1;
+    p[t * 8 + 6] = r2 * 16 + c1; p[t * 8 + 7] = r3 * 16 + c1;
+  }
+  return p;
+}
+constexpr std::array<uint16_t, 256> make_tc_perm_inv() {
+  std::array<uint16_t, 256> inv{};
+  const auto perm = make_tc_perm();
+  for (int i = 0; i < 256; ++i) inv[perm[i]] = i;
+  return inv;
+}
+constexpr int rate_k2(int bits) { return 2 * bits; }
+constexpr int state_end(int bits, int t) { return (((t + 1) * rate_k2(bits)) >> 1) + 128 * rate_k2(bits); }
+
+template <int bits, int row, bool second_word>
+constexpr std::array<int32_t, 16> make_row_indices() {
+  std::array<int32_t, 16> idx{};
+  const auto inv = make_tc_perm_inv();
+  constexpr int words32 = tile_words32(bits);
+  for (int col = 0; col < 16; ++col) {
+    const int t = inv[row * 16 + col];
+    const int b1 = state_end(bits, t);
+    const int b0 = b1 - 16;
+    idx[col] = (second_word ? (b1 - 1) / 32 : b0 / 32) % words32;
+  }
+  return idx;
+}
+template <int bits, int row>
+constexpr int row_shift(int col) {
+  const auto inv = make_tc_perm_inv();
+  const int t = inv[row * 16 + col];
+  const int b1 = state_end(bits, t);
+  return ((b1 - 1) / 32 + 1) * 32 - b1;
+}
+
+// scalar decode (reference / tests)
+inline uint32_t load_u32_(const uint16_t* ptr, int index) {
+  uint32_t v; std::memcpy(&v, ptr + index * 2, sizeof(v)); return v;
+}
+template <int bits>
+inline uint16_t decode_state_scalar(const uint16_t* packed_native_tile, int t) {
+  constexpr int words32 = tile_words32(bits);
+  const int b1 = state_end(bits, t);
+  const int b0 = b1 - 16;
+  const int shift = ((b1 - 1) / 32 + 1) * 32 - b1;
+  const uint64_t merged = (static_cast<uint64_t>(load_u32_(packed_native_tile, (b0 / 32) % words32)) << 32) |
+                          load_u32_(packed_native_tile, ((b1 - 1) / 32) % words32);
+  return static_cast<uint16_t>(merged >> shift);
+}
+inline float decode_mul1_scalar(uint16_t state) {
+  const uint32_t x = static_cast<uint32_t>(state) * MUL1_MULT;
+  const int sum = (x & 0xff) + ((x >> 8) & 0xff) + ((x >> 16) & 0xff) + (x >> 24);
+  return (static_cast<float>(sum) - 510.0f) * mul1_k_inv();
+}
+// weight (row kk, col nn) of a NATIVE-layout matrix, dequantized (no Hadamard / signs)
+template <int bits>
+inline float native_weight(const uint16_t* trellis_native, int tiles_n, int kk, int nn) {
+  constexpr auto perm_inv = make_tc_perm_inv();
+  const uint16_t* tile = trellis_native + (static_cast<size_t>(kk / 16) * tiles_n + nn / 16) * tile_u16(bits);
+  const int t = perm_inv[(kk % 16) * 16 + (nn % 16)];
+  return decode_mul1_scalar(decode_state_scalar<bits>(tile, t));
+}
+
+// ---- repack native -> group-2 planar (what the AVX2 kernel reads) ----
+template <int bits>
+inline void repack_group2_planar(const uint16_t* src_native, uint16_t* dst, int tiles_k, int tiles_n) {
+  constexpr int wd = tile_words32(bits);  // 8 * bits dwords per tile
+  for (int nt = 0; nt < tiles_n; ++nt)
+    for (int kt = 0; kt < tiles_k; ++kt) {
+      const uint32_t* s = reinterpret_cast<const uint32_t*>(src_native + (static_cast<size_t>(kt) * tiles_n + nt) * tile_u16(bits));
+      uint32_t* d = reinterpret_cast<uint32_t*>(dst + ((static_cast<size_t>(nt / 2) * tiles_k + kt) * 2 + nt % 2) * tile_u16(bits));
+      for (int w = 0; w < wd; ++w) d[8 * (w % bits) + w / bits] = s[w];
+    }
+}
+
+// ---- Hadamard-128 ----
+EXL3_AVX2 inline void hadamard_128_avx2(float* v) {
+  __m256 r[16];
+  for (int i = 0; i < 16; ++i) r[i] = _mm256_loadu_ps(v + i * 8);
+  for (int i = 0; i < 16; ++i) {
+    const __m256 t = _mm256_permute_ps(r[i], 0b10110001);
+    r[i] = _mm256_blend_ps(_mm256_add_ps(r[i], t), _mm256_sub_ps(t, r[i]), 0b10101010);
+  }
+  for (int i = 0; i < 16; ++i) {
+    const __m256 t = _mm256_permute_ps(r[i], 0b01001110);
+    r[i] = _mm256_blend_ps(_mm256_add_ps(r[i], t), _mm256_sub_ps(t, r[i]), 0b11001100);
+  }
+  for (int i = 0; i < 16; ++i) {
+    const __m256 t = _mm256_permute2f128_ps(r[i], r[i], 0x01);
+    r[i] = _mm256_blend_ps(_mm256_add_ps(r[i], t), _mm256_sub_ps(t, r[i]), 0b11110000);
+  }
+  for (int width = 1; width < 16; width *= 2)
+    for (int base = 0; base < 16; base += 2 * width)
+      for (int i = 0; i < width; ++i) {
+        const __m256 a = r[base + i];
+        const __m256 b = r[base + width + i];
+        r[base + i] = _mm256_add_ps(a, b);
+        r[base + width + i] = _mm256_sub_ps(a, b);
+      }
+  for (int i = 0; i < 16; ++i) _mm256_storeu_ps(v + i * 8, r[i]);
+}
+
+// ---- prepared input row: int8 activations ----
+struct PreparedRow {
+  int32_t* splat_dup;  // [k] x8 as i16 in both 16-bit slots of the dword
+  float q;             // row scale
+  int32_t sum_x8;      // sum of the int8 activations
+};
+
+EXL3_AVX2 inline int32_t hsum_epi32(__m256i v) {
+  alignas(32) int32_t s[8]; _mm256_store_si256(reinterpret_cast<__m256i*>(s), v);
+  return s[0] + s[1] + s[2] + s[3] + s[4] + s[5] + s[6] + s[7];
+}
+
+// dst[k] = hadamard_128 blockwise(src * suh) * HAD_SCALE ; src fp32
+EXL3_AVX2 inline void prepare_transform(const float* src, const uint16_t* suh, float* dst, int k) {
+  const __m256 hs = _mm256_set1_ps(HAD_SCALE);
+  for (int block = 0; block < k; block += 128) {
+    for (int i = 0; i < 128; i += 8) {
+      const __m256 x = _mm256_loadu_ps(src + block + i);
+      const __m256 s = _mm256_cvtph_ps(_mm_loadu_si128(reinterpret_cast<const __m128i*>(suh + block + i)));
+      _mm256_storeu_ps(dst + block + i, _mm256_mul_ps(x, s));
+    }
+    hadamard_128_avx2(dst + block);
+    for (int i = 0; i < 128; i += 8)
+      _mm256_storeu_ps(dst + block + i, _mm256_mul_ps(_mm256_loadu_ps(dst + block + i), hs));
+  }
+}
+
+// int8 quantization of a transformed row (plain rows; the "wide" two-row split of the original
+// is not ported: EXL3_MOE_CPU_WIDE=0 semantics)
+EXL3_AVX2 inline void quantize_row(const float* t, int k, PreparedRow& p) {
+  __m256 vmax = _mm256_setzero_ps();
+  const __m256 sign = _mm256_set1_ps(-0.0f);
+  for (int i = 0; i < k; i += 8) vmax = _mm256_max_ps(vmax, _mm256_andnot_ps(sign, _mm256_loadu_ps(t + i)));
+  alignas(32) float mx[8]; _mm256_store_ps(mx, vmax);
+  float amax = 0.0f;
+  for (int i = 0; i < 8; ++i) amax = std::max(amax, mx[i]);
+  const float q = amax > 0.0f ? amax * (1.0f / 127.0f) : 1.0f;
+  const __m256 rq = _mm256_set1_ps(amax > 0.0f ? 127.0f / amax : 1.0f);
+  const __m256i lo = _mm256_set1_epi32(-127), hi = _mm256_set1_epi32(127);
+  const __m256i m16 = _mm256_set1_epi32(0xffff);
+  __m256i vsum = _mm256_setzero_si256();
+  for (int i = 0; i < k; i += 8) {
+    __m256i v = _mm256_cvtps_epi32(_mm256_mul_ps(_mm256_loadu_ps(t + i), rq));
+    v = _mm256_min_epi32(hi, _mm256_max_epi32(lo, v));
+    vsum = _mm256_add_epi32(vsum, v);
+    const __m256i low16 = _mm256_and_si256(v, m16);
+    _mm256_storeu_si256(reinterpret_cast<__m256i*>(p.splat_dup + i), _mm256_or_si256(low16, _mm256_slli_epi32(low16, 16)));
+  }
+  p.sum_x8 = hsum_epi32(vsum);
+  p.q = q;
+}
+
+// out[n] (GEMV result, fp32) -> hadamard_128 blockwise * HAD_SCALE * svh, columns [c0, c1) (128-aligned)
+EXL3_AVX2 inline void transform_out(const uint16_t* svh, float* v, int c0, int c1) {
+  const __m256 hs = _mm256_set1_ps(HAD_SCALE);
+  for (int block = c0; block < c1; block += 128) {
+    hadamard_128_avx2(v + block);
+    for (int i = 0; i < 128; i += 8) {
+      const __m256 s = _mm256_cvtph_ps(_mm_loadu_si128(reinterpret_cast<const __m128i*>(svh + block + i)));
+      _mm256_storeu_ps(v + block + i, _mm256_mul_ps(_mm256_mul_ps(_mm256_loadu_ps(v + block + i), hs), s));
+    }
+  }
+}
+
+// ---- the AVX2 group-2 planar GEMV, m = 1 ----
+
+template <int bits, int row, bool second_word, int half>
+constexpr int planar_reg() {
+  constexpr auto idx = make_row_indices<bits, row, second_word>();
+  const int r = idx[half * 8] % bits;
+  for (int c = 1; c < 8; ++c)
+    if (idx[half * 8 + c] % bits != r) return -1;
+  return r;
+}
+template <int bits, int row, bool second_word, int half>
+constexpr bool planar_identity() {
+  constexpr auto idx = make_row_indices<bits, row, second_word>();
+  for (int c = 0; c < 8; ++c)
+    if (idx[half * 8 + c] / bits != c) return false;
+  return true;
+}
+template <int bits, int row, bool second_word, int half>
+EXL3_AVX2 EXL3_INLINE __m256i gather_half_planar(const __m256i (&preg)[bits]) {
+  static_assert(planar_reg<bits, row, second_word, half>() >= 0, "half-row words span registers");
+  if constexpr (planar_identity<bits, row, second_word, half>())
+    return preg[planar_reg<bits, row, second_word, half>()];
+  constexpr auto idx = make_row_indices<bits, row, second_word>();
+  const __m256i lane = _mm256_setr_epi32(
+      idx[half * 8 + 0] / bits, idx[half * 8 + 1] / bits, idx[half * 8 + 2] / bits, idx[half * 8 + 3] / bits,
+      idx[half * 8 + 4] / bits, idx[half * 8 + 5] / bits, idx[half * 8 + 6] / bits, idx[half * 8 + 7] / bits);
+  return _mm256_permutevar8x32_epi32(preg[planar_reg<bits, row, second_word, half>()], lane);
+}
+template <int bits, int row>
+EXL3_AVX2 EXL3_INLINE void row_codes_planar(const __m256i (&preg)[bits], __m256i& codes_lo, __m256i& codes_hi) {
+  const __m256i a_lo = gather_half_planar<bits, row, false, 0>(preg);
+  const __m256i b_lo = gather_half_planar<bits, row, true, 0>(preg);
+  const __m256i a_hi = gather_half_planar<bits, row, false, 1>(preg);
+  const __m256i b_hi = gather_half_planar<bits, row, true, 1>(preg);
+  const __m256i mask16 = _mm256_set1_epi32(0xffff);
+  constexpr int s0 = row_shift<bits, row>(0);
+  constexpr int s1 = row_shift<bits, row>(8);
+  codes_lo = _mm256_and_si256(_mm256_or_si256(_mm256_srli_epi32(b_lo, s0), _mm256_slli_epi32(a_lo, 32 - s0)), mask16);
+  codes_hi = _mm256_and_si256(_mm256_or_si256(_mm256_srli_epi32(b_hi, s1), _mm256_slli_epi32(a_hi, 32 - s1)), mask16);
+}
+// one k-row of a tile: 16 states -> product bytes -> pair sums (<= 510) -> * x (i16) -> i32
+EXL3_AVX2 EXL3_INLINE void accum_row(__m256i codes_lo, __m256i codes_hi, int32_t xdup, __m256i (&acc)[2],
+                                      const __m256i& mult, const __m256i& ones32) {
+  const __m256i p_lo = _mm256_maddubs_epi16(_mm256_mullo_epi32(codes_lo, mult), ones32);
+  const __m256i p_hi = _mm256_maddubs_epi16(_mm256_mullo_epi32(codes_hi, mult), ones32);
+  const __m256i xs = _mm256_set1_epi32(xdup);
+  acc[0] = _mm256_add_epi32(acc[0], _mm256_madd_epi16(p_lo, xs));
+  acc[1] = _mm256_add_epi32(acc[1], _mm256_madd_epi16(p_hi, xs));
+}
+template <int bits, int row = 0>
+EXL3_AVX2 EXL3_INLINE void rows_accum_planar(const __m256i (&preg)[bits], const int32_t* dup, __m256i (&acc)[2],
+                                              const __m256i& mult, const __m256i& ones32) {
+  if constexpr (row < 16) {
+    __m256i codes_lo, codes_hi;
+    row_codes_planar<bits, row>(preg, codes_lo, codes_hi);
+    accum_row(codes_lo, codes_hi, dup[row], acc, mult, ones32);
+    rows_accum_planar<bits, row + 1>(preg, dup, acc, mult, ones32);
+  }
+}
+
+// GEMV of one row over tile columns [tn0, tn1) (even, 2-aligned): tout[n] for those columns
+template <int bits>
+EXL3_AVX2 void gemv_m1(const Mat& mat, const PreparedRow& in, float* tout, int tn0, int tn1) {
+  const int tiles_k = mat.k / 16;
+  constexpr int packed_size = tile_u16(bits);
+  const __m256i mult = _mm256_set1_epi32(static_cast<int32_t>(MUL1_MULT));
+  const __m256i ones32 = _mm256_set1_epi32(0x01010101);
+  const int32_t* splat_dup = in.splat_dup;
+  const size_t step = static_cast<size_t>(2) * packed_size;
+  const float scale = mul1_k_inv() * in.q;
+  const __m256 vscale = _mm256_set1_ps(scale);
+  const __m256 corr = _mm256_set1_ps(-510.0f * static_cast<float>(in.sum_x8) * scale);
+
+  for (int pair = tn0; pair < tn1; pair += 2) {
+    __m256i accA[2] = {_mm256_setzero_si256(), _mm256_setzero_si256()};
+    __m256i accB[2] = {_mm256_setzero_si256(), _mm256_setzero_si256()};
+    const uint16_t* pA = mat.trellis + static_cast<size_t>(pair >> 1) * tiles_k * 2 * packed_size;
+    const uint16_t* pB = pA + packed_size;
+    for (int tile_k = 0; tile_k < tiles_k; ++tile_k, pA += step, pB += step) {
+      const int32_t* dup = splat_dup + tile_k * 16;
+      __m256i preg[bits];
+      for (int i = 0; i < bits; ++i) preg[i] = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(pA + i * 16));
+      rows_accum_planar<bits>(preg, dup, accA, mult, ones32);
+      for (int i = 0; i < bits; ++i) preg[i] = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(pB + i * 16));
+      rows_accum_planar<bits>(preg, dup, accB, mult, ones32);
+    }
+    float* outA = tout + pair * 16;
+    _mm256_storeu_ps(outA, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accA[0]), vscale, corr));
+    _mm256_storeu_ps(outA + 8, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accA[1]), vscale, corr));
+    _mm256_storeu_ps(outA + 16, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accB[0]), vscale, corr));
+    _mm256_storeu_ps(outA + 24, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accB[1]), vscale, corr));
+  }
+}
+
+// ---- the same GEMV over Rows (<= 4) token rows sharing one weight stream ----
+template <int Rows>
+EXL3_AVX2 EXL3_INLINE void accum_rows(__m256i codes_lo, __m256i codes_hi, const PreparedRow* in, int kk,
+                                       __m256i (&acc)[Rows][2], const __m256i& mult, const __m256i& ones32) {
+  const __m256i p_lo = _mm256_maddubs_epi16(_mm256_mullo_epi32(codes_lo, mult), ones32);
+  const __m256i p_hi = _mm256_maddubs_epi16(_mm256_mullo_epi32(codes_hi, mult), ones32);
+#define EXL3_ACC_ROW(i) \
+  if constexpr ((i) < Rows) { \
+    const __m256i xs = _mm256_set1_epi32(in[i].splat_dup[kk]); \
+    acc[i][0] = _mm256_add_epi32(acc[i][0], _mm256_madd_epi16(p_lo, xs)); \
+    acc[i][1] = _mm256_add_epi32(acc[i][1], _mm256_madd_epi16(p_hi, xs)); \
+  }
+  EXL3_ACC_ROW(0) EXL3_ACC_ROW(1) EXL3_ACC_ROW(2) EXL3_ACC_ROW(3)
+#undef EXL3_ACC_ROW
+}
+template <int bits, int Rows, int row = 0>
+EXL3_AVX2 EXL3_INLINE void rows_accum_planar_m(const __m256i (&preg)[bits], const PreparedRow* in, int k0,
+                                                __m256i (&acc)[Rows][2], const __m256i& mult, const __m256i& ones32) {
+  if constexpr (row < 16) {
+    __m256i codes_lo, codes_hi;
+    row_codes_planar<bits, row>(preg, codes_lo, codes_hi);
+    accum_rows<Rows>(codes_lo, codes_hi, in, k0 + row, acc, mult, ones32);
+    rows_accum_planar_m<bits, Rows, row + 1>(preg, in, k0, acc, mult, ones32);
+  }
+}
+// Rows token rows (in[r].splat_dup, q, sum_x8) -> tout[r * n + col] for tile columns [tn0, tn1)
+template <int bits, int Rows>
+EXL3_AVX2 void gemv_rows(const Mat& mat, const PreparedRow* in, float* tout, int tn0, int tn1) {
+  const int tiles_k = mat.k / 16;
+  constexpr int packed_size = tile_u16(bits);
+  const __m256i mult = _mm256_set1_epi32(static_cast<int32_t>(MUL1_MULT));
+  const __m256i ones32 = _mm256_set1_epi32(0x01010101);
+  const size_t step = static_cast<size_t>(2) * packed_size;
+  for (int pair = tn0; pair < tn1; pair += 2) {
+    __m256i accA[Rows][2], accB[Rows][2];
+    for (int r = 0; r < Rows; ++r) {
+      accA[r][0] = accA[r][1] = _mm256_setzero_si256();
+      accB[r][0] = accB[r][1] = _mm256_setzero_si256();
+    }
+    const uint16_t* pA = mat.trellis + static_cast<size_t>(pair >> 1) * tiles_k * 2 * packed_size;
+    const uint16_t* pB = pA + packed_size;
+    for (int tile_k = 0; tile_k < tiles_k; ++tile_k, pA += step, pB += step) {
+      __m256i preg[bits];
+      for (int i = 0; i < bits; ++i) preg[i] = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(pA + i * 16));
+      rows_accum_planar_m<bits, Rows>(preg, in, tile_k * 16, accA, mult, ones32);
+      for (int i = 0; i < bits; ++i) preg[i] = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(pB + i * 16));
+      rows_accum_planar_m<bits, Rows>(preg, in, tile_k * 16, accB, mult, ones32);
+    }
+    for (int r = 0; r < Rows; ++r) {
+      const float scale = mul1_k_inv() * in[r].q;
+      const __m256 vscale = _mm256_set1_ps(scale);
+      const __m256 corr = _mm256_set1_ps(-510.0f * static_cast<float>(in[r].sum_x8) * scale);
+      float* o = tout + static_cast<size_t>(r) * mat.n + pair * 16;
+      _mm256_storeu_ps(o, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accA[r][0]), vscale, corr));
+      _mm256_storeu_ps(o + 8, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accA[r][1]), vscale, corr));
+      _mm256_storeu_ps(o + 16, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accB[r][0]), vscale, corr));
+      _mm256_storeu_ps(o + 24, _mm256_fmadd_ps(_mm256_cvtepi32_ps(accB[r][1]), vscale, corr));
+    }
+  }
+}
+template <int bits>
+inline void gemv_rows_m(const Mat& mat, const PreparedRow* in, int m, float* tout, int tn0, int tn1) {
+  switch (m) {
+    case 1: gemv_rows<bits, 1>(mat, in, tout, tn0, tn1); break;
+    case 2: gemv_rows<bits, 2>(mat, in, tout, tn0, tn1); break;
+    case 3: gemv_rows<bits, 3>(mat, in, tout, tn0, tn1); break;
+    case 4: gemv_rows<bits, 4>(mat, in, tout, tn0, tn1); break;
+    default: __builtin_trap();
+  }
+}
+// m <= 4 rows, weights streamed once
+inline void gemv_dispatch(const Mat& mat, const PreparedRow* in, int m, float* tout, int tn0, int tn1) {
+  switch (mat.bits) {
+    case 2: gemv_rows_m<2>(mat, in, m, tout, tn0, tn1); break;
+    case 3: gemv_rows_m<3>(mat, in, m, tout, tn0, tn1); break;
+    case 4: gemv_rows_m<4>(mat, in, m, tout, tn0, tn1); break;
+    case 5: gemv_rows_m<5>(mat, in, m, tout, tn0, tn1); break;
+    case 6: gemv_rows_m<6>(mat, in, m, tout, tn0, tn1); break;
+    case 8: gemv_rows_m<8>(mat, in, m, tout, tn0, tn1); break;
+    default: __builtin_trap();
+  }
+}
+constexpr int MAX_ROWS = 4;
+
+inline void gemv_m1_dispatch(const Mat& mat, const PreparedRow& in, float* tout, int tn0, int tn1) {
+  switch (mat.bits) {
+    case 2: gemv_m1<2>(mat, in, tout, tn0, tn1); break;
+    case 3: gemv_m1<3>(mat, in, tout, tn0, tn1); break;
+    case 4: gemv_m1<4>(mat, in, tout, tn0, tn1); break;
+    case 5: gemv_m1<5>(mat, in, tout, tn0, tn1); break;
+    case 6: gemv_m1<6>(mat, in, tout, tn0, tn1); break;
+    case 8: gemv_m1<8>(mat, in, tout, tn0, tn1); break;
+    default: __builtin_trap();
+  }
+}
+inline void repack_dispatch(int bits, const uint16_t* src, uint16_t* dst, int tiles_k, int tiles_n) {
+  switch (bits) {
+    case 2: repack_group2_planar<2>(src, dst, tiles_k, tiles_n); break;
+    case 3: repack_group2_planar<3>(src, dst, tiles_k, tiles_n); break;
+    case 4: repack_group2_planar<4>(src, dst, tiles_k, tiles_n); break;
+    case 5: repack_group2_planar<5>(src, dst, tiles_k, tiles_n); break;
+    case 6: repack_group2_planar<6>(src, dst, tiles_k, tiles_n); break;
+    case 8: repack_group2_planar<8>(src, dst, tiles_k, tiles_n); break;
+    default: __builtin_trap();
+  }
+}
+
+inline float silu(float g) { return g / (1.0f + std::exp(std::min(-g, 80.0f))); }
+
+}  // namespace exl3
