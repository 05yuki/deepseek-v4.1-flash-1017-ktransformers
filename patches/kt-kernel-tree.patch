+/**
+ * EXL3 (ExLlamaV3 trellis, mul1 codebook) routed experts on the CPU, AVX2.
+ *
+ * Per expert the checkpoint holds, for each of gate / up / down, `trellis` (int16, [K/16, N/16, 16*bits]),
+ * `suh` (fp16 [K], input signs) and `svh` (fp16 [N], output signs); the matrix is
+ *   W = diag(suh) H_128 W~ H_128 diag(svh) / 128   (blockwise Hadamard of size 128 on both sides).
+ * The kernel (exl3_moe_core.hpp, ported from exllamav3's moe_mul1.cpp) decodes the trellis inside an int8
+ * dot product. Weights arrive through GeneralMOEConfig as per-expert pointer lists: gate_projs = trellis,
+ * gate_scales = suh, gate_zeros = svh (same for up / down); gate_type / up_type / down_type carry the bits.
+ *
+ * NUMA split (TP_MOE_Common, TP_BLOCK = 128): each socket holds a 128-aligned slice of the intermediate
+ * dimension: gate / up by output columns, down by input rows; the down partial sums are added in
+ * merge_results. The slices are repacked at load into the group-2 planar tile order the kernel reads,
+ * into memory the socket's own threads first-touch.
+ */
+#ifndef CPUINFER_OPERATOR_EXL3_MOE_H
+#define CPUINFER_OPERATOR_EXL3_MOE_H
+
+#include <immintrin.h>
+#include <sys/mman.h>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <algorithm>
+
+#include "../../cpu_backend/shared_mem_buffer.h"
+#include "../common.hpp"
+#include "../moe-tp.hpp"
+#include "exl3_moe_core.hpp"
+#include "llama.cpp/ggml.h"
+
+class EXL3_MOE_TP {
+ public:
+  using input_t = ggml_bf16_t;
+  using output_t = float;
+  static constexpr int TP_BLOCK = 128;  // Hadamard block: the smallest slice of the intermediate dimension
+
+  GeneralMOEConfig config_;
+  int tp_part_idx;
+
+ private:
+  int K_ = 0;        // hidden
+  int I_ = 0;        // this socket's intermediate slice
+  int I_off_ = 0;    // its offset in the full intermediate
+  int E_ = 0;
+  int bits_g_ = 0, bits_u_ = 0, bits_d_ = 0;
+  // packed arenas (group-2 planar), one allocation per projection: [E][tiles...]
+  uint16_t* gate_ = nullptr;
+  uint16_t* up_ = nullptr;
+  uint16_t* down_ = nullptr;
+  size_t gate_bytes_ = 0, up_bytes_ = 0, down_bytes_ = 0;
+  // signs, fp16: [E][K] / [E][I] slices
+  std::vector<uint16_t> gate_suh_, gate_svh_, up_suh_, up_svh_, down_suh_, down_svh_;
+
+  // scratch for a slice of tokens: the routes of a slice are grouped by expert into units of up to
+  // MAX_ROWS token rows that share one read of the expert's weights (decode: one row per unit;
+  // speculative verification / prefill: several). Unit u owns rows [u * MAX_ROWS, u * MAX_ROWS + m).
+  static constexpr int SLICE = 16;
+  struct Unit { int e; int m; int tok[exl3::MAX_ROWS]; float w[exl3::MAX_ROWS]; };
+  std::vector<Unit> units_;
+  int rows_cap_ = 0;
+  float* x32_ = nullptr;             // [SLICE][K]
+  float* tin_g_ = nullptr;           // [rows_cap][K] transformed rows for gate
+  float* tin_u_ = nullptr;           // [rows_cap][K] for up
+  int32_t* dup_g_ = nullptr;         // [rows_cap][K]
+  int32_t* dup_u_ = nullptr;         // [rows_cap][K]
+  float* tdown_ = nullptr;           // [rows_cap][I]
+  int32_t* dup_d_ = nullptr;         // [rows_cap][I]
+  float* g_ = nullptr;               // [rows_cap][I]
+  float* u_ = nullptr;               // [rows_cap][I]
+  float* d_ = nullptr;               // [rows_cap][K]
+  std::vector<exl3::PreparedRow> pg_, pu_, pd_;
+
+  static uint16_t* map_arena(size_t bytes) {
+    size_t b = (bytes + (1 << 21)) & ~((size_t(1) << 21) - 1);
+    void* m = mmap(nullptr, b, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED) throw std::runtime_error("EXL3 arena mmap failed");
+    madvise(m, b, MADV_HUGEPAGE);
+    return static_cast<uint16_t*>(m);
+  }
+  static void unmap_arena(uint16_t* p, size_t bytes) {
+    if (!p) return;
+    size_t b = (bytes + (1 << 21)) & ~((size_t(1) << 21) - 1);
+    munmap(p, b);
+  }
+  static int bits_of(int type) {
+    if (type < 1 || type > 8) throw std::runtime_error("EXL3: bits per weight out of range: " + std::to_string(type));
+    return type;
+  }
+
+ public:
+  EXL3_MOE_TP(GeneralMOEConfig config, int tp_part_idx) : config_(config), tp_part_idx(tp_part_idx) {
+    K_ = config_.hidden_size;
+    I_ = config_.intermediate_size;
+    E_ = config_.expert_num;
+    bits_g_ = bits_of(config_.gate_type);
+    bits_u_ = bits_of(config_.up_type);
+    bits_d_ = bits_of(config_.down_type);
+    if (K_ % 128 != 0 || I_ % 128 != 0) throw std::runtime_error("EXL3: hidden and intermediate slice must be multiples of 128");
+    const int topk = config_.num_experts_per_tok;
+    rows_cap_ = SLICE * topk * exl3::MAX_ROWS;
+    MemoryRequest req;
+    req.append_pointer(&x32_, sizeof(float) * SLICE * K_);
+    req.append_pointer(&tin_g_, sizeof(float) * rows_cap_ * K_);
+    req.append_pointer(&tin_u_, sizeof(float) * rows_cap_ * K_);
+    req.append_pointer(&dup_g_, sizeof(int32_t) * rows_cap_ * K_);
+    req.append_pointer(&dup_u_, sizeof(int32_t) * rows_cap_ * K_);
+    req.append_pointer(&tdown_, sizeof(float) * rows_cap_ * I_);
+    req.append_pointer(&dup_d_, sizeof(int32_t) * rows_cap_ * I_);
+    req.append_pointer(&g_, sizeof(float) * rows_cap_ * I_);
+    req.append_pointer(&u_, sizeof(float) * rows_cap_ * I_);
+    req.append_pointer(&d_, sizeof(float) * rows_cap_ * K_);
+    shared_mem_buffer_numa.alloc(tp_part_idx, this, req);
+    pg_.resize(rows_cap_); pu_.resize(rows_cap_); pd_.resize(rows_cap_);
+    for (int r = 0; r < rows_cap_; ++r) {
+      pg_[r].splat_dup = dup_g_ + static_cast<size_t>(r) * K_;
+      pu_[r].splat_dup = dup_u_ + static_cast<size_t>(r) * K_;
+      pd_[r].splat_dup = dup_d_ + static_cast<size_t>(r) * I_;
+    }
+    units_.reserve(SLICE * topk);
+  }
+
+  ~EXL3_MOE_TP() {
+    shared_mem_buffer_numa.dealloc(tp_part_idx, this);
+    unmap_arena(gate_, gate_bytes_);
+    unmap_arena(up_, up_bytes_);
+    unmap_arena(down_, down_bytes_);
+  }
+
+  // Copy this socket's slice of every expert out of the checkpoint views (native tile order) into the
+  // packed arenas. full_I: the model's intermediate size; I_off: this slice's offset.
+  void load_weights(int full_I, int I_off) {
+    I_off_ = I_off;
+    if (config_.gate_projs.empty() || config_.gate_scales.empty() || config_.gate_zeros.empty())
+      throw std::runtime_error("EXL3: per-expert trellis / suh / svh pointer lists required");
+    const uint64_t* p2l = static_cast<const uint64_t*>(config_.physical_to_logical_map);
+    const size_t gu_u16 = static_cast<size_t>(K_ / 16) * (I_ / 16);  // tiles per gate/up slice
+    const size_t d_u16 = gu_u16;
+    gate_bytes_ = gu_u16 * exl3::tile_u16(bits_g_) * 2 * E_;
+    up_bytes_ = gu_u16 * exl3::tile_u16(bits_u_) * 2 * E_;
+    down_bytes_ = d_u16 * exl3::tile_u16(bits_d_) * 2 * E_;
+    gate_ = map_arena(gate_bytes_);
+    up_ = map_arena(up_bytes_);
+    down_ = map_arena(down_bytes_);
+    gate_suh_.assign(static_cast<size_t>(E_) * K_, 0); up_suh_.assign(static_cast<size_t>(E_) * K_, 0);
+    gate_svh_.assign(static_cast<size_t>(E_) * I_, 0); up_svh_.assign(static_cast<size_t>(E_) * I_, 0);
+    down_suh_.assign(static_cast<size_t>(E_) * I_, 0); down_svh_.assign(static_cast<size_t>(E_) * K_, 0);
+
+    const int tiles_k = K_ / 16, tiles_n = I_ / 16, full_tiles_n = full_I / 16, nt0 = I_off / 16;
+    auto pool = config_.pool->get_subpool(tp_part_idx);
+    pool->do_work_stealing_job(E_, [&](int e) {
+      const uint64_t lid = expert_map(p2l, e);
+      if (lid >= config_.gate_projs[0].size()) throw std::runtime_error("EXL3: expert map out of range");
+      // gate / up: native [K/16][full_I/16][tile] -> slice columns [nt0, nt0 + tiles_n)
+      for (int which = 0; which < 2; ++which) {
+        const int bits = which ? bits_u_ : bits_g_;
+        const int tw = exl3::tile_u16(bits);
+        const uint16_t* src = static_cast<const uint16_t*>(which ? config_.up_projs[0][lid] : config_.gate_projs[0][lid]);
+        std::vector<uint16_t> nat(static_cast<size_t>(tiles_k) * tiles_n * tw);
+        for (int kt = 0; kt < tiles_k; ++kt)
+          std::memcpy(nat.data() + static_cast<size_t>(kt) * tiles_n * tw,
+                      src + (static_cast<size_t>(kt) * full_tiles_n + nt0) * tw, static_cast<size_t>(tiles_n) * tw * 2);
+        uint16_t* dst = (which ? up_ : gate_) + static_cast<size_t>(e) * gu_u16 * tw;
+        exl3::repack_dispatch(bits, nat.data(), dst, tiles_k, tiles_n);
+        const uint16_t* suh = static_cast<const uint16_t*>(which ? config_.up_scales[0][lid] : config_.gate_scales[0][lid]);
+        const uint16_t* svh = static_cast<const uint16_t*>(which ? config_.up_zeros[0][lid] : config_.gate_zeros[0][lid]);
+        std::memcpy((which ? up_suh_ : gate_suh_).data() + static_cast<size_t>(e) * K_, suh, sizeof(uint16_t) * K_);
+        std::memcpy((which ? up_svh_ : gate_svh_).data() + static_cast<size_t>(e) * I_, svh + I_off, sizeof(uint16_t) * I_);
+      }
+      // down: native [full_I/16][K/16][tile] -> slice rows [nt0, nt0 + tiles_n), all K columns
+      {
+        const int tw = exl3::tile_u16(bits_d_);
+        const uint16_t* src = static_cast<const uint16_t*>(config_.down_projs[0][lid]);
+        const uint16_t* nat = src + static_cast<size_t>(nt0) * tiles_k * tw;  // rows are contiguous
+        uint16_t* dst = down_ + static_cast<size_t>(e) * d_u16 * tw;
+        exl3::repack_dispatch(bits_d_, nat, dst, tiles_n, tiles_k);
+        const uint16_t* suh = static_cast<const uint16_t*>(config_.down_scales[0][lid]);
+        const uint16_t* svh = static_cast<const uint16_t*>(config_.down_zeros[0][lid]);
+        std::memcpy(down_suh_.data() + static_cast<size_t>(e) * I_, suh + I_off, sizeof(uint16_t) * I_);
+        std::memcpy(down_svh_.data() + static_cast<size_t>(e) * K_, svh, sizeof(uint16_t) * K_);
+      }
+    });
+  }
+
+  exl3::Mat gate_mat(int e) const {
+    return {gate_ + static_cast<size_t>(e) * (K_ / 16) * (I_ / 16) * exl3::tile_u16(bits_g_),
+            gate_suh_.data() + static_cast<size_t>(e) * K_, gate_svh_.data() + static_cast<size_t>(e) * I_, K_, I_, bits_g_};
+  }
+  exl3::Mat up_mat(int e) const {
+    return {up_ + static_cast<size_t>(e) * (K_ / 16) * (I_ / 16) * exl3::tile_u16(bits_u_),
+            up_suh_.data() + static_cast<size_t>(e) * K_, up_svh_.data() + static_cast<size_t>(e) * I_, K_, I_, bits_u_};
+  }
+  exl3::Mat down_mat(int e) const {
+    return {down_ + static_cast<size_t>(e) * (I_ / 16) * (K_ / 16) * exl3::tile_u16(bits_d_),
+            down_suh_.data() + static_cast<size_t>(e) * I_, down_svh_.data() + static_cast<size_t>(e) * K_, I_, K_, bits_d_};
+  }
+
+  void warm_up() {}
+
+  // A slice of up to SLICE tokens: the socket's partial MoE output (fp32 [qlen][K]) for its
+  // intermediate slice.
+  void forward_slice(int qlen, int k, const int64_t* expert_ids, const float* weights, const ggml_bf16_t* input,
+                     float* output) {
+    auto pool = config_.pool->get_subpool(tp_part_idx);
+    units_.clear();
+    std::memset(output, 0, sizeof(float) * K_ * qlen);
+    // group the routes by expert, MAX_ROWS rows per unit
+    for (int t = 0; t < qlen; ++t) {
+      ggml_bf16_to_fp32_row(input + static_cast<size_t>(t) * K_, x32_ + static_cast<size_t>(t) * K_, K_);
+      for (int i = 0; i < k; ++i) {
+        const int64_t e = expert_ids[static_cast<size_t>(t) * k + i];
+        if (config_.should_skip_expert(e)) continue;
+        Unit* u = nullptr;
+        for (auto it = units_.rbegin(); it != units_.rend(); ++it)
+          if (it->e == e) { if (it->m < exl3::MAX_ROWS) u = &*it; break; }
+        if (!u) { units_.push_back(Unit{static_cast<int>(e), 0, {}, {}}); u = &units_.back(); }
+        u->tok[u->m] = t;
+        u->w[u->m] = weights[static_cast<size_t>(t) * k + i];
+        ++u->m;
+      }
+    }
+    const int nu = static_cast<int>(units_.size());
+    if (nu == 0) return;
+    const int pairs_gu = I_ / 32, pairs_d = K_ / 32;
+
+    // 1. transformed + quantized input rows, per (unit, gate|up): the signs differ per matrix
+    pool->do_work_stealing_job(nu * 2, [&](int j) {
+      const Unit& un = units_[j >> 1];
+      const bool up = j & 1;
+      const exl3::Mat m = up ? up_mat(un.e) : gate_mat(un.e);
+      for (int r = 0; r < un.m; ++r) {
+        const size_t row = static_cast<size_t>(j >> 1) * exl3::MAX_ROWS + r;
+        float* t = (up ? tin_u_ : tin_g_) + row * K_;
+        exl3::prepare_transform(x32_ + static_cast<size_t>(un.tok[r]) * K_, m.suh, t, K_);
+        exl3::quantize_row(t, K_, (up ? pu_ : pg_)[row]);
+      }
+    });
+    // 2. gate + up GEMV over (unit, tile pair), all rows of the unit on one weight stream
+    pool->do_work_stealing_job(nu * 2 * pairs_gu, [&](int w) {
+      const int j = w / pairs_gu, pair = (w % pairs_gu) * 2, ui = j >> 1;
+      const Unit& un = units_[ui];
+      const size_t row0 = static_cast<size_t>(ui) * exl3::MAX_ROWS;
+      if (j & 1) exl3::gemv_dispatch(up_mat(un.e), &pu_[row0], un.m, u_ + row0 * I_, pair, pair + 2);
+      else exl3::gemv_dispatch(gate_mat(un.e), &pg_[row0], un.m, g_ + row0 * I_, pair, pair + 2);
+    });
+    // 3. output transforms, silu(gate) * up, the down input rows
+    pool->do_work_stealing_job(nu, [&](int ui) {
+      const Unit& un = units_[ui];
+      const exl3::Mat gm = gate_mat(un.e), um = up_mat(un.e), dm = down_mat(un.e);
+      for (int r = 0; r < un.m; ++r) {
+        const size_t row = static_cast<size_t>(ui) * exl3::MAX_ROWS + r;
+        float* gg = g_ + row * I_;
+        float* uu = u_ + row * I_;
+        exl3::transform_out(gm.svh, gg, 0, I_);
+        exl3::transform_out(um.svh, uu, 0, I_);
+        for (int i = 0; i < I_; ++i) gg[i] = exl3::silu(gg[i]) * uu[i];
+        exl3::prepare_transform(gg, dm.suh, tdown_ + row * I_, I_);
+        exl3::quantize_row(tdown_ + row * I_, I_, pd_[row]);
+      }
+    });
+    // 4. down GEMV over (unit, tile pair)
+    pool->do_work_stealing_job(nu * pairs_d, [&](int w) {
+      const int ui = w / pairs_d, pair = (w % pairs_d) * 2;
+      const Unit& un = units_[ui];
+      const size_t row0 = static_cast<size_t>(ui) * exl3::MAX_ROWS;
+      exl3::gemv_dispatch(down_mat(un.e), &pd_[row0], un.m, d_ + row0 * K_, pair, pair + 2);
+    });
+    // 5. output transform per 128-block and the routing-weighted sums; each task owns its block
+    pool->do_work_stealing_job(K_ / 128, [&](int b) {
+      const int c0 = b * 128;
+      for (int ui = 0; ui < nu; ++ui) {
+        const Unit& un = units_[ui];
+        const uint16_t* svh = down_mat(un.e).svh;
+        for (int r = 0; r < un.m; ++r) {
+          float* dd = d_ + (static_cast<size_t>(ui) * exl3::MAX_ROWS + r) * K_;
+          exl3::transform_out(svh, dd, c0, c0 + 128);
+          float* out = output + static_cast<size_t>(un.tok[r]) * K_;
+          const __m256 w = _mm256_set1_ps(un.w[r]);
+          for (int c = c0; c < c0 + 128; c += 8)
+            _mm256_storeu_ps(out + c, _mm256_fmadd_ps(w, _mm256_loadu_ps(dd + c), _mm256_loadu_ps(out + c)));
+        }
+      }
+    });
+  }
+
+  void forward(int qlen, int k, const int64_t* expert_ids, const float* weights, const void* input, void* output) {
+    for (int t0 = 0; t0 < qlen; t0 += SLICE) {
+      const int n = std::min(SLICE, qlen - t0);
+      forward_slice(n, k, expert_ids + static_cast<size_t>(t0) * k, weights + static_cast<size_t>(t0) * k,
+                    static_cast<const ggml_bf16_t*>(input) + static_cast<size_t>(t0) * K_,
+                    static_cast<float*>(output) + static_cast<size_t>(t0) * K_);
+    }
+  }
+};
+
+template <>
+class TP_MOE<EXL3_MOE_TP> : public TP_MOE_Common<EXL3_MOE_TP> {
+ public:
+  using TP_MOE_Common<EXL3_MOE_TP>::TP_MOE_Common;
+
+  void load_weights() override {
+    auto pool = this->config.pool;
+    std::vector<int> offsets(this->tp_count);
+    int acc = 0;
+    for (int i = 0; i < this->tp_count; i++) {
+      offsets[i] = acc;
+      acc += this->tp_configs[i].intermediate_size;
+    }
+    pool->dispense_backend()->do_numa_job([this, offsets](int tp_id) {
+      this->tps[tp_id]->config_.physical_to_logical_map = this->config.physical_to_logical_map;
+      this->tps[tp_id]->config_.gpu_experts_mask = this->config.gpu_experts_mask;
+      this->tps[tp_id]->load_weights(this->config.intermediate_size, offsets[tp_id]);
+    });
+    this->weights_loaded = true;
+  }
+
+  // fp32 partial sums of the sockets -> bf16 output (incremental: add the bf16 output already there)
+  void merge_results(int qlen, void* output, bool incremental) override {
+    const int H = this->config.hidden_size;
+    auto merge_fn = [this, output, incremental, H](int t) {
+      float* to = this->local_output_numa[0] + static_cast<size_t>(t) * H;
+      ggml_bf16_t* out = static_cast<ggml_bf16_t*>(output) + static_cast<size_t>(t) * H;
+      if (incremental) {
+        float tmp[8192];
+        for (int e = 0; e < H; e += 4096) {
+          const int n = std::min(4096, H - e);
+          ggml_bf16_to_fp32_row(out + e, tmp, n);
+          for (int i = 0; i < n; ++i) to[e + i] += tmp[i];
+        }
+      }
+      for (int i = 1; i < this->tp_count; i++) {
+        const float* from = this->local_output_numa[i] + static_cast<size_t>(t) * H;
+        for (int e = 0; e < H; e += 8) _mm256_storeu_ps(to + e, _mm256_add_ps(_mm256_loadu_ps(to + e), _mm256_loadu_ps(from + e)));
+      }
+      ggml_fp32_to_bf16_row(to, out, H);
+    };
+    if (qlen < 10) {
+      for (int i = 0; i < qlen; i++) merge_fn(i);
+    } else {
+      this->config.pool->do_work_stealing_job(qlen, nullptr, merge_fn, nullptr);
+    }
+  }
+  void merge_results(int qlen, void* output) override { merge_results(qlen, output, false); }
+};
+
+#endif
