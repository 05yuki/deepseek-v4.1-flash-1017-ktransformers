+  else if (a <= 1.25f) q = 1.f;
+  else if (a < 1.75f) q = 1.5f;
+  else if (a <= 2.5f) q = 2.f;
+  else if (a < 3.5f) q = 3.f;
+  else if (a <= 5.f) q = 4.f;
+  else q = 6.f;
