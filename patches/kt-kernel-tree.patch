+    void* h = dlopen("libcuda.so.1", RTLD_NOW | RTLD_GLOBAL);
+    if (h != nullptr) {
+      write32_ = (StreamValueFn)dlsym(h, "cuStreamWriteValue32_v2");
+      wait32_ = (StreamValueFn)dlsym(h, "cuStreamWaitValue32_v2");
