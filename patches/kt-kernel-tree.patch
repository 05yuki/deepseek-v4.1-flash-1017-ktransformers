+"""Python factory policy for native BF16 routed-expert activations."""
+
+import pytest
+import torch
+
+import kt_kernel.experts as experts
+
+
+class _CapturedNativeWrapper:
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+
+
+def _create(monkeypatch, *, method="BF16", activation="silu"):
+    monkeypatch.setattr(experts, "NativeMoEWrapper", _CapturedNativeWrapper)
+    return experts._create_inference_wrapper(
+        layer_idx=0,
+        num_experts=4,
+        num_experts_per_tok=2,
+        hidden_size=64,
+        moe_intermediate_size=70,
+        gpu_experts_mask=torch.zeros(4, dtype=torch.bool),
+        cpuinfer_threads=4,
+        threadpool_count=1,
+        weight_path="/unused",
+        chunked_prefill_size=32,
+        cpu_save=False,
+        max_deferred_experts_per_token=0,
+        method=method,
+        activation=activation,
+    )
+
+
+def test_gelu_tanh_is_forwarded_for_bf16(monkeypatch):
+    wrapper = _create(monkeypatch, activation="gelu_pytorch_tanh")
+    assert wrapper.kwargs["activation"] == "gelu_pytorch_tanh"
+
+
+def test_silu_remains_the_bf16_default(monkeypatch):
+    wrapper = _create(monkeypatch)
+    assert wrapper.kwargs["activation"] == "silu"
+
+
+def test_gelu_tanh_rejected_for_non_bf16(monkeypatch):
+    with pytest.raises(ValueError, match="only with method='BF16'"):
+        _create(monkeypatch, method="MXFP4", activation="gelu_pytorch_tanh")
+
+
+def test_unknown_activation_rejected(monkeypatch):
+    with pytest.raises(ValueError, match="Unsupported activation"):
+        _create(monkeypatch, activation="gelu_exact")
