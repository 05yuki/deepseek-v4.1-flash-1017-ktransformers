From cc598875f046812465c71e8d258b2c69be3416db Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Mon, 19 Oct 2026 16:44:35 +0900
Subject: [PATCH] engram-row-prefetch: start the engram row lookups with the
 forward, on a side stream

Each engram layer's rank-local row lookup starts at the beginning of the
forward on a side stream instead of when its layer comes: in decode, and
in a prefill chunk (SGLANG_DSV41_ENGRAM_PREFETCH_PREFILL, on), where the
later engram layer's rows are read while the layers before it run. The
all-reduce, `wkv` and the gate stay where they were. Only with one
pipeline stage, no DP attention and engram tables that are not shared;
a prefill chunk also not under context parallelism or a breakable CUDA
graph.

Numerics: Bit-identical: only the lookup moves. Checked in prefill:
teacher-forced log-probs of 12K-token pieces identical token for token
with SGLANG_DSV41_ENGRAM_PREFETCH_PREFILL=0 and 1.

Effect in prefill, alone, on two 16 GB cards: a 35K prompt in 9,216-token
chunks 972 -> 1,084 tok/s (12,288-token chunks 1,011 -> 1,022). Most of
the engram read time goes with the engram adapter's next-chunk warm-up.

Prerequisites: none; applies alone on tier 0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 python/sglang/srt/layers/engram.py      |  6 ++
 python/sglang/srt/models/deepseek_v4.py | 75 ++++++++++++++++++++++---
 2 files changed, 74 insertions(+), 7 deletions(-)

diff --git a/python/sglang/srt/layers/engram.py b/python/sglang/srt/layers/engram.py
index 7d8e7c4b..6b1331dd 100644
--- a/python/sglang/srt/layers/engram.py
+++ b/python/sglang/srt/layers/engram.py
@@ -1503,6 +1503,12 @@ class Engram(nn.Module):
             # Nothing to gate, and the MXFP8 quantize behind wkv rejects an
             # empty M.
             return x
+        return self.gate_rows(x, emb, input_ids)
+
+    def gate_rows(
+        self, x: torch.Tensor, emb: torch.Tensor, input_ids: torch.Tensor
+    ) -> torch.Tensor:
+        """The layer's output from its looked-up rows `emb` (the tail of forward)."""
         kv, _ = self.wkv(emb.flatten(-2))
         image_ids = input_ids if self.image_token_id is not None else None
         return engram_gate(
diff --git a/python/sglang/srt/models/deepseek_v4.py b/python/sglang/srt/models/deepseek_v4.py
index d85dd86c..991b3e51 100644
--- a/python/sglang/srt/models/deepseek_v4.py
+++ b/python/sglang/srt/models/deepseek_v4.py
@@ -3,6 +3,7 @@ from __future__ import annotations
 import concurrent.futures
 import functools
 import logging
+import os
 import time
 from array import array
 from contextlib import contextmanager, nullcontext
@@ -3862,6 +3863,26 @@ class DeepseekV4Model(nn.Module):
                 self.engram_layout,
                 image_token_id=_engram_image_token_id(config),
             )
+        # Decode: the engram row lookups of the rank-local (not shared) tables
+        # start with the token on a side stream instead of at their layers.
+        self.engram_rows_stream = None
+        if (
+            _is_cuda
+            and os.environ.get("SGLANG_DSV41_ENGRAM_PREFETCH_ROWS", "1") == "1"
+            and self.pp_group.world_size == 1
+            and not is_dp_attention_enabled()
+            and any(
+                self.layers[i].engram is not None
+                and not self.layers[i].engram.embed._shared
+                for i in range(self.start_layer, self.end_layer)
+            )
+        ):
+            self.engram_rows_stream = torch.cuda.Stream()
+            logger.info("Engram row lookups start with the token in decode")
+        self.engram_rows_prefill = (
+            self.engram_rows_stream is not None
+            and os.environ.get("SGLANG_DSV41_ENGRAM_PREFETCH_PREFILL", "1") == "1"
+        )
 
         if not _is_cuda:
             self.use_fused_mhc_post_pre = (
@@ -4017,6 +4038,37 @@ class DeepseekV4Model(nn.Module):
                 bcg_deepseek_v4_engram_hash_ids(self.engram_hasher, input_ids, hash_ids)
             else:
                 hash_ids = self.engram_hasher(input_ids, forward_batch)
+        # {layer: (rows, event)}: this rank's rows, looked up on the side stream
+        prefetched_rows = {}
+        mode = forward_batch.forward_mode
+        if (
+            self.engram_rows_stream is not None
+            and hash_ids is not None
+            and hash_ids.shape[0] > 0
+            and (
+                mode.is_decode()
+                # a prefill chunk's later engram layers read their rows while the
+                # layers before them run
+                or (
+                    self.engram_rows_prefill
+                    and mode.is_extend_without_speculative()
+                    and not cp_extend
+                    and not is_in_breakable_cuda_graph()
+                )
+            )
+        ):
+            rows_stream = self.engram_rows_stream
+            rows_stream.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(rows_stream):
+                for j in range(self.start_layer, self.end_layer):
+                    eng = self.layers[j].engram
+                    if eng is None or eng.embed._shared:
+                        continue
+                    rows = eng.embed._owned_rows(hash_ids[:, eng.layer_hash_index])
+                    ev = torch.cuda.Event()
+                    ev.record(rows_stream)
+                    prefetched_rows[j] = (rows, ev)
+            hash_ids.record_stream(rows_stream)
         tail = None
         if (
             self.late_layer_start is not None
@@ -4195,13 +4247,22 @@ class DeepseekV4Model(nn.Module):
             if engram is not None:
                 # No local name holds the pre-Engram residual: it would stay alive
                 # until the next Engram layer.
-                hidden_states = engram(
-                    state.residual,
-                    hash_ids[:, engram.layer_hash_index],
-                    forward_batch,
-                    input_ids=input_ids,
-                    cp_all_tokens=cp_extend,
-                )
+                if i in prefetched_rows:
+                    rows, ev = prefetched_rows.pop(i)
+                    main_stream = torch.cuda.current_stream()
+                    main_stream.wait_event(ev)
+                    rows.record_stream(main_stream)
+                    if engram.embed.tp_size > 1:
+                        rows = engram.embed._reduce_owned_rows(rows)
+                    hidden_states = engram.gate_rows(state.residual, rows, input_ids)
+                else:
+                    hidden_states = engram(
+                        state.residual,
+                        hash_ids[:, engram.layer_hash_index],
+                        forward_batch,
+                        input_ids=input_ids,
+                        cp_all_tokens=cp_extend,
+                    )
                 state = state.with_residual(hidden_states)
                 if _is_cuda:
                     hidden_states = residual_batch.set_written(state, forward_batch)
