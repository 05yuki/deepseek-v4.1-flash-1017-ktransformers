+#include "mmq-load-tiles.cuh"
+#include "mmq-vec-dot.cuh"
+
+// dst may hold GGML_TYPE_F32, GGML_TYPE_F16 or GGML_TYPE_BF16 values (dst_type). The float sums are rounded
+// to nearest even once, when stored; partial sums of the stream-k fixup stay in fp32.
+static __device__ __forceinline__ float * ggml_cuda_mmq_dst_offset(float * dst, const int64_t offset, const ggml_type dst_type) {
+    return dst_type == GGML_TYPE_F32 ? dst + offset : (float *) ((char *) dst + offset*2);
+}
+
+static __device__ __forceinline__ void ggml_cuda_mmq_store(float * dst, const int64_t i, const float v, const ggml_type dst_type) {
+    if (dst_type == GGML_TYPE_F32) {
+        dst[i] = v;
+    } else {
+        ((unsigned short *) dst)[i] = dst_type == GGML_TYPE_BF16 ? __bfloat16_as_ushort(__float2bfloat16_rn(v))
+                                                                : __half_as_ushort(__float2half_rn(v));
+    }
+}
+
+template <ggml_type type, int J, bool fallback, ggml_prec prec_src1> static __device__ __forceinline__ void ggml_cuda_mmq_write_back_dp4a(
+        const float * __restrict__ sum, const int32_t * __restrict__ ids_dst, float * __restrict__ dst,
+        const float * __restrict__ y_scale, const int stride, const int i_max, const int j_max, const ggml_type dst_type) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps    = ggml_cuda_mmq_get_nthreads(type, J, fallback, prec_src1) / warp_size;
+    constexpr int I         = ggml_cuda_mmq_get_I(type, J, fallback, prec_src1);
+
+    const bool y_scale_used = y_scale != nullptr;
+
+#pragma unroll
+    for (int j0 = 0; j0 < J; j0 += nwarps) {
+        const int j = j0 + threadIdx.y;
+
+        if (j > j_max) {
+            return;
+        }
+
+#pragma unroll
+        for (int i0 = 0; i0 < I; i0 += warp_size) {
+            const int i = i0 + threadIdx.x;
+
+            if (fallback && i > i_max) {
+                continue;
+            }
+
+            if constexpr (type == GGML_TYPE_NVFP4) {
+                if (y_scale_used) {
+                    ggml_cuda_mmq_store(dst, ids_dst[j]*stride + i, y_scale[j] * sum[(j0/nwarps) * (I/warp_size) + i0/warp_size], dst_type);
+                } else {
+                    ggml_cuda_mmq_store(dst, ids_dst[j]*stride + i, sum[(j0/nwarps) * (I/warp_size) + i0/warp_size], dst_type);
+                }
+            } else {
+                ggml_cuda_mmq_store(dst, ids_dst[j]*stride + i, sum[(j0/nwarps) * (I/warp_size) + i0/warp_size], dst_type);
+                GGML_UNUSED(y_scale_used);
+            }
+        }
+    }
+}
+
+template<ggml_type type, int J, bool fallback, ggml_prec prec_src1>
+static __device__ __forceinline__ void ggml_cuda_mmq_write_back_mma(
+            const float * __restrict__ sum, const int * __restrict__ ids_dst, float * __restrict__ dst,
+            const float * __restrict__ y_scale, const int stride, const int i_max, const int j_max, const ggml_type dst_type) {
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    typedef tile<16, 16, int, DATA_LAYOUT_J_MAJOR> tile_C;
+#else
+    typedef tile<16,  8, int> tile_C;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+
+    constexpr int rows_per_warp = ggml_cuda_mmq_get_rows_per_warp(type, J, fallback, prec_src1);
+    constexpr int ntx           = rows_per_warp/tile_C::I; // Number of x minitiles per warp.
+
+    const int i0 = (threadIdx.y / ntx) * (ntx*tile_C::I);
+
+    const bool y_scale_used = y_scale != nullptr;
+
+#pragma unroll
+    for (int j0 = 0; j0 < J; j0 += ntx*tile_C::J) {
+#pragma unroll
+        for (int n = 0; n < ntx; ++n) {
+#pragma unroll
+            for (int l = 0; l < tile_C::ne; ++l) {
+                const int j = j0 + (threadIdx.y % ntx) * tile_C::J + tile_C::get_j(l);
+
+                if (j > j_max) {
+                    continue;
+                }
+
+                const int i = i0 + n*tile_C::I + tile_C::get_i(l);
+
+                if (fallback && i > i_max) {
+                    continue;
+                }
+
+                if constexpr (type == GGML_TYPE_NVFP4) {
+                    if (y_scale_used) {
+                        ggml_cuda_mmq_store(dst, ids_dst[j]*stride + i, y_scale[j] * sum[(j0/tile_C::J + n)*tile_C::ne + l], dst_type);
+                    } else {
+                        ggml_cuda_mmq_store(dst, ids_dst[j]*stride + i, sum[(j0/tile_C::J + n)*tile_C::ne + l], dst_type);
+                    }
+                } else {
+                    ggml_cuda_mmq_store(dst, ids_dst[j]*stride + i, sum[(j0/tile_C::J + n)*tile_C::ne + l], dst_type);
+                    GGML_UNUSED(y_scale_used);
+                }
+            }
+        }
+    }
+}
