+
+
+def _arena_load_parts_batched(st, L: _Layer, e: int, w13, s13, w2, s2, order: int) -> None:
+    """_arena_load_parts for whole parts (_parts_whole), the same bytes: the gate/up rows go
+    straight into the slot as there; every part's fp32 scales land in one staging buffer in
+    the slot's order and become e8m0 bytes in place (shift, mask, cast: 3 kernels for w13 and
+    3 for w2, not 4 a part and projection), and the down projection's parts land side by side
+    and are scattered into their column blocks by one strided copy (not one a part).
+
+    Kernels for an all8 expert (8 parts): 48 host-to-device copies + 7, against 48 + 104."""
+    n, k = w13.shape[0] // 2, w2.shape[0]
+    a, b = (0, 1) if order == 0 else (1, 0)
+    segs, parts = st._segs, st._arena_parts[L.layer_idx]
+    P, m = len(segs), segs[0][4]
+    kb, kg = w13.shape[1], s13.shape[1]  # bytes and scale groups a gate/up row
+    dev = w13.device
+    st13 = _bstage("bst13", 2 * n * kg, torch.float32, dev)
+    st2 = _bstage("bst2", P * k * (m // 32), torch.float32, dev)
+    sb = _bstage("bsb", P * k * (m // 2), torch.uint8, dev)
+    for p, ((_, lo, c, d, _), ar) in enumerate(zip(segs, parts)):
+        ws, ss = ar[0][1], ar[3][1]
+        for src, row0 in ((a, 0), (b, n)):
+            w13[row0 + d:row0 + d + c].view(-1).copy_(ar[src][0][e * ws:e * ws + c * kb], non_blocking=True)
+            st13[(row0 + d) * kg:(row0 + d + c) * kg].view(torch.uint8).copy_(
+                ar[3 + src][0][e * ss:e * ss + 4 * c * kg], non_blocking=True)
+        sb[p * k * (m // 2):(p + 1) * k * (m // 2)].copy_(ar[2][0][e * ws:e * ws + k * m // 2], non_blocking=True)
+        st2[p * k * (m // 32):(p + 1) * k * (m // 32)].view(torch.uint8).copy_(
+            ar[5][0][e * ss:e * ss + 4 * k * (m // 32)], non_blocking=True)
+    for stg, out, perm in ((st13, s13.view(-1), None), (st2, s2.view(k, P, m // 32), (P, k, m // 32))):
+        i32 = stg.view(torch.int32)
+        torch.bitwise_right_shift(i32, 23, out=i32)
+        torch.bitwise_and(i32, 0xFF, out=i32)
+        out.copy_(i32 if perm is None else i32.view(perm).permute(1, 0, 2))
+    w2.view(k, P, m // 2).copy_(sb.view(P, k, m // 2).permute(1, 0, 2))
+
+
+# -- copies as jobs (KT_KV_HOT_DYN_DEFER / _ASYNC / KT_KV_HOT_DYN_REFILL_FAST) --------------
+# A job is one round's swaps or one refill: items (layer, 0: slot / 1: resident row, its
+# index, expert, "arena" | "bank") copied on DYN["stream"] after ev_unmap (recorded on the
+# decode stream once the places' old experts left the tables), then ev recorded; pub lists
+# the table entries (layer, expert, place) that go in once ev is done.
+
+
+def _job_new(kind: str) -> dict:
+    return {"kind": kind, "items": [], "pub": {0: [], 1: []}, "enq": False, "thread": None, "error": None,
+            "ev_unmap": torch.cuda.Event(), "ev": torch.cuda.Event(), "t0": time.perf_counter(), "t_enq": 0.0}
+
+
+def _copy_item(L: _Layer, w: int, i: int, e: int, src: str) -> None:
+    if src == "bank":
+        for _, nm in L.names:
+            L.slots[nm][i].copy_(L.banks[nm][i], non_blocking=True)
+        return
+    if w == 0:
+        dst = {key: L.slots[nm][i] for key, nm in DYN["roles"][L.idx].items()}
+    else:
+        dst = {key: t[i] for key, t in L.res_t.items()}
+    _arena_load(L, e, dst, DYN["order"])
+
+
+def _job_start(job: dict, dev) -> None:
+    """Enqueue a job's copies: on this thread, or (KT_KV_HOT_DYN_ASYNC) on a worker thread
+    while the scheduler goes on; either way they run on the side stream behind ev_unmap."""
+    job["ev_unmap"].record(torch.cuda.current_stream(dev))
+    side = DYN["stream"]
+
+    def run():
+        t0 = time.perf_counter()
+        try:
+            with torch.cuda.device(dev), torch.cuda.stream(side):
+                side.wait_event(job["ev_unmap"])
+                for it in job["items"]:
+                    _copy_item(*it)
+                job["ev"].record(side)
+        except BaseException as ex:  # raised again on the scheduler's thread (_job_check)
+            job["error"] = ex
+        finally:
+            job["t_enq"] = time.perf_counter() - t0
+            job["enq"] = True  # after the record: an unrecorded event reads as done
+
+    DYN["job"] = job
+    DYN["jobs"] = DYN.get("jobs", 0) + 1
+    if DYN_ASYNC:
+        th = threading.Thread(target=run, name="kt-kv-hot-copy", daemon=True)
+        job["thread"] = th
+        th.start()
+    else:
+        run()
+
+
+def _job_check(job: dict) -> None:
+    if job.get("error") is not None:
+        raise RuntimeError(f"kt_kv_hot_lend: a {job['kind']} job's copies failed to enqueue") from job["error"]
+
+
+def _job_join() -> None:
+    """Wait until the job's copies are enqueued (not done): before anything else touches the
+    slots' memory, the staging buffers or the tables from this thread."""
+    job = DYN.get("job")
+    if job is not None and job.get("thread") is not None:
+        job["thread"].join()
+        job["thread"] = None
+    if job is not None:
+        _job_check(job)
+
+
+def _tbl_write(table, rows, dev) -> None:
+    """table[layer, expert] = value for rows [(layer, expert, value)], through pinned memory:
+    no host sync (a pageable .to(dev) syncs the stream)."""
+    if table is None or not rows:
+        return
+    t = torch.tensor(rows, dtype=torch.int64).pin_memory().to(dev, non_blocking=True)
+    table[t[:, 0], t[:, 1]] = t[:, 2]
+
+
+def _job_publish(dev) -> bool:
+    """The job's entries into the tables once its copies are done (an event query, no wait)."""
+    job = DYN.get("job")
+    if job is None or not job["enq"]:
+        return False
+    _job_check(job)
+    if not job["ev"].query():
+        return False
+    if job.get("thread") is not None:
+        job["thread"].join()
+        job["thread"] = None
+    torch.cuda.current_stream(dev).wait_event(job["ev"])  # done already: ordering only
+    _tbl_write(STATE["tbl"], job["pub"][0], dev)
+    _tbl_write(STATE.get("rtbl"), job["pub"][1], dev)
+    DYN["job"] = None
+    lat = time.perf_counter() - job["t0"]
+    st = DYN.setdefault("pubstat", {"n": 0, "lat": 0.0, "enq": 0.0, "items": 0})
+    st["n"] += 1
+    st["lat"] += lat
+    st["enq"] += job["t_enq"]
+    st["items"] += len(job["items"])
+    if job["kind"] == "refill":
+        DYN["refills"] = DYN.get("refills", 0) + 1
+        if DYN["refills"] in (1, 2, 10, 100, 1000):
+            _log(f"refill {DYN['refills']}: {len(job['items'])} experts copied on the side stream and in the "
+                 f"tables {lat * 1e3:.0f} ms after the lend (enqueue {job['t_enq'] * 1e3:.0f} ms"
+                 f"{', worker thread' if DYN_ASYNC else ''})")
+    return True
+
+
+# -- the swap plan -------------------------------------------------------------------
+
+def _plan_layer(sc, places, cur: dict, n: int, res: bool, budget: int, hyst: float, ok=None) -> list:
+    """One layer's swaps, as the round before the hot_slots port chose them: the best-scored
+    experts not on the GPU, each into an empty place or else in place of the lowest-scored
+    expert held (that is not dwelling: ok(place)), while it scores more than hyst x that one;
+    a place takes at most one expert a round. cur: place -> expert (-1: empty), not changed.
+    [(place, expert out, expert in, score gain)] in the order chosen (gains fall along it)."""
+    cur = dict(cur)
+    hs, changed, out = set(cur.values()), set(), []
+    for e in np.argsort(-sc, kind="stable").tolist():
+        if len(out) >= budget or sc[e] <= 0:
+            break
+        if (e < n and not res) or e in hs:
+            continue
+        opts = [p for p in places if p not in changed]
+        if not opts:
+            break
+        empty = [p for p in opts if cur[p] < 0]
+        if empty:
+            p = empty[0]
+        else:
+            if ok is not None:
+                opts = [p for p in opts if ok(p)]
+                if not opts:
+                    break
+            p = min(opts, key=lambda q: (sc[cur[q]], q))
+            if not sc[e] > sc[cur[p]] * hyst:
+                break
+        old = cur[p]
+        out.append((p, old, e, float(sc[e] - (sc[old] if old >= 0 else 0.0))))
+        hs.discard(old)
+        hs.add(e)
+        cur[p] = e
+        changed.add(p)
+    return out
+
+
+def _byte_cut(plans: list, cap: int, per_expert) -> list:
+    """The plans' swaps within cap bytes over all layers, the largest gains first; a layer
+    keeps a prefix of its own plan (its later swaps assumed its earlier ones)."""
+    heads = [0] * len(plans)
+    spent = 0
+    while True:
+        best = None
+        for i, (L, plan) in enumerate(plans):
+            if heads[i] < len(plan) and (best is None or plan[heads[i]][3] > plans[best][1][heads[best]][3]):
+                best = i
+        if best is None:
+            break
+        cost = per_expert(plans[best][0])
+        if spent and spent + cost > cap:  # (a cap below one expert still lets one through)
+            break
+        spent += cost
+        heads[best] += 1
+    DYN["round_bytes"] = spent
+    return [(L, plan[:h]) for (L, plan), h in zip(plans, heads)]
+
+
+def _h2d_bytes(L: _Layer) -> int:
+    """Host-to-device bytes of one expert's copy: the weights, and the scales as fp32."""
+    return sum(L.sz[nm] * (4 if "scale" in nm else 1) for _, nm in L.names)
+
+
+def _plan_round() -> list:
+    """This round's swaps over every layer [(layer, 0 slot / 1 row, index, out, in)]; the
+    held lists say what each place is to hold from now on (as before the port)."""
+    budget = DYN_SWAPS * DYN_EVERY
+    rnd = DYN["rounds"]
+    plans = []
+    for L in LAYERS:
+        k = L.k
+        if not k:
+            continue
+        # the places a layer's GPU experts sit in: its lent slots, and with the dynamic
+        # resident rows those rows too (one pool: the lowest score anywhere goes)
+        res = bool(DYN.get("res")) and L.res_t is not None
+        places = [(0, j) for j in range(k)] + ([(1, r) for r in range(L.n)] if res else [])
+        cur = {p: (L.held[p[1]] if p[0] == 0 else L.res_held[p[1]]) for p in places}
+        ok = None
+        if DYN_DWELL > 0:
+            def ok(p, since=L.since):
+                return rnd - since.get(p, -(1 << 30)) > DYN_DWELL
+        plans.append((L, _plan_layer(DYN["scores"][L.idx], places, cur, L.n, res, budget, DYN_HYST, ok)))
+    if DYN_BYTES > 0:
+        plans = _byte_cut(plans, DYN_BYTES, _h2d_bytes)
+    swaps = []
+    for L, plan in plans:
+        for p, old, e, _ in plan:
+            swaps.append((L, p[0], p[1], old, e))
+            if p[0] == 0:
+                L.held[p[1]] = e
+            else:
+                L.res_held[p[1]] = e
+            L.since[p] = rnd
+    return swaps
+
+
+def _refill_choose(sc, held: list, k: int, n: int, banks: int, excl) -> list:
+    """KT_KV_HOT_DYN_REFILL_FAST: what a refilled layer's k slots hold, from the scores saved
+    across the window: the k best-scored experts that no resident row holds (excl), then
+    what the slots held before, then the placement's next ones; an expert keeps its old slot
+    when it is among them (a slot with its bank's expert copies from the bank)."""
+    want, seen = [], set(excl)
+    if sc is not None:
+        for e in np.argsort(-sc, kind="stable").tolist():
+            if len(want) >= k or sc[e] <= 0:
+                break
+            if e not in seen:
+                want.append(e)
+                seen.add(e)
+    for e in list(held) + [n + j for j in range(len(sc) if sc is not None else 0)]:
+        if len(want) >= k:
+            break
+        if 0 <= e and e not in seen and (sc is None or e < len(sc)):
+            want.append(e)
+            seen.add(e)
+    out = [-1] * k
+    left = set(want)
+    for j in range(min(k, len(held))):
+        if held[j] in left:
+            out[j] = held[j]
+            left.discard(held[j])
+    rest = [e for e in want if e in left]
+    for j in range(k):
+        if out[j] < 0 and rest:
+            out[j] = rest.pop(0)
+    return out
+
+
+def _dyn_setup(dev) -> None:
+    """First lend: whether the arenas give the bytes the slots hold. Experts N, N+1
+    of the first layer loaded from the arenas against their banks (the method's
+    processed form), in both row orders; on only when every rank found the same."""
+    from sglang.srt.layers.moe import kt_stream_prefill
+
+    order, why = -1, ""
+    L = LAYERS[0]
+    roles = _roles(L)
+    st = getattr(kt_stream_prefill, "_instance", None)
+    if st is None or L.layer_idx not in getattr(st, "_arenas", {}):
+        why = "no zero-copy arenas (KT_GPU_STREAM_ZEROCOPY=1 with KT_EXPERT_SHM=1)"
+    elif roles is None:
+        why = f"slot tensors {[(nm, str(L.slots[nm].dtype)) for _, nm in L.names]} are not packed MXFP4 bytes"
+    else:
+        DYN["stage"] = torch.empty(max(L.slots[roles[("w13", True)]][0].numel() // 2 + 1,
+                                       L.slots[roles[("w2", True)]][0].numel()), dtype=torch.float32, device=dev)
+        diff = {}
+        for o in (0, 1):
+            good = True
+            for j in range(min(2, L.b)):
+                dst = {key: torch.empty_like(L.slots[nm][j]) for key, nm in roles.items()}
+                _arena_load(L, L.n + j, dst, o)
+                torch.cuda.synchronize(dev)
+                for key, nm in roles.items():
+                    bad = int((dst[key].view(torch.uint8).cpu() != L.banks[nm][j].view(torch.uint8)).sum())
+                    if bad:
+                        good = False
+                        diff[(o, nm)] = diff.get((o, nm), 0) + bad
+            if good:
+                order = o
+                break
+        if order < 0:
+            why = f"arena bytes differ from the banks (row order, slot name: bytes): {diff}"
+    lo, hi = _over_ranks([order, order], torch.distributed.ReduceOp.MIN)[0], \
+        _over_ranks([order], torch.distributed.ReduceOp.MAX)[0]
+    DYN["on"] = lo >= 0 and lo == hi
+    if DYN["on"]:
+        DYN["order"] = order
+        DYN["roles"] = {M.idx: _roles(M) for M in LAYERS}
+        DYN["stream"] = torch.cuda.Stream(device=dev)
+        DYN["ev_unmap"], DYN["ev_copy"], DYN["ev_cnt"] = torch.cuda.Event(), torch.cuda.Event(), None
+        DYN["buf"] = torch.zeros(tuple(STATE["cnt"].shape), dtype=torch.float32, pin_memory=True)
+        DYN["scores"] = np.zeros(tuple(STATE["cnt"].shape))
+        _log(f"dynamic slots on: arena experts match the banks ({'gate' if order == 0 else 'up'} rows first), "
+             f"a round every {DYN_EVERY} forwards, up to {DYN_SWAPS * DYN_EVERY} swaps a layer, "
+             f"half-life {DYN_HALF_LIFE:g}")
+        knobs = [f"{nm} {v}" for nm, v in (("hysteresis", DYN_HYST), ("dwell", DYN_DWELL)) if v]
+        knobs += [nm for nm, v in (("deferred tables", DYN_DEFER), ("worker-thread copies", DYN_ASYNC),
+                                   ("fast refill", REFILL_FAST), ("batched part loads", BATCH_LOAD),
+                                   ("route fold", ROUTE_FOLD)) if v]
+        if DYN_BYTES:
+            knobs.append(f"{DYN_BYTES >> 20} MiB a round")
+        if DYNAMIC:
+            _log("dynamic slots: " + (", ".join(knobs) or "as before"))
+        if PIN_ARENAS:
+            # every layer's arenas registered now, not at a round's first swap into the layer
+            t0, n0 = time.perf_counter(), len(getattr(st, "_registered", ()))
+            for M in LAYERS:
+                st._register_arenas(M.layer_idx)
+            _log(f"KT_KV_HOT_DYN_PIN_ARENAS: {len(st._registered) - n0} layers' arenas registered now "
+                 f"({len(LAYERS)} in use) in {time.perf_counter() - t0:.1f} s")
+    if DYN_RES:
+        # the resident rows swap when experts 0, 1 from the arenas match what the rows hold
+        ok, why = 1, ""
+        L = LAYERS[0]
+        if not DYN["on"]:
+            ok, why = 0, "the dynamic slots are off"
+        elif L.res_t is None:
+            ok, why = 0, "the resident tensors are not the packed layout"
+        else:
+            for r in range(min(2, L.n)):
+                dst = {key: torch.empty_like(t[r]) for key, t in L.res_t.items()}
+                _arena_load(L, r, dst, order)
+                torch.cuda.synchronize(dev)
+                bad = {str(key): int((dst[key].view(torch.uint8) != t[r].view(torch.uint8)).sum())
+                       for key, t in L.res_t.items()}
+                if any(bad.values()):
+                    ok, why = 0, f"arena expert {r} differs from resident row {r} (bytes by role): {bad}"
+                    break
+        if os.environ.get("KT_KV_HOT_DYN_RES_SWAP", "1") == "0":
+            # (diagnosis: the CPU holds every expert and route sends it -1, but the rows stay)
+            ok, why = 0, "KT_KV_HOT_DYN_RES_SWAP=0"
+        DYN["res"] = bool(_over_ranks([ok], torch.distributed.ReduceOp.MIN)[0])
+        _log("dynamic resident rows " + ("on: experts 0, 1 from the arenas match their rows" if DYN["res"]
+                                          else f"off: {why or 'another rank could not'}; they hold 0..N-1"))
+    else:
+        for M in LAYERS:
+            # the placement's experts, as many as there are banks
+            M.x = M.b
+            M.held = [M.n + j for j in range(M.x)]
+        _log(f"dynamic slots off: {why or 'another rank could not load from its arenas'}; "
+             f"the slots hold the placement's experts")
+
+
+def _dyn_fill(L: _Layer, k: int) -> None:
+    """A lend's copy into a layer's k slots: what each held before the window, from
+    its bank when it is still the placement's expert, else from the arenas."""
+    # an expert held twice (a slot past an earlier lend's k kept its expert while a
+    # round put it in a lower slot, 10-21) takes one slot; the other is left empty
+    seen = set(L.res_held) if DYN.get("res") and L.res_t is not None else set()
+    for j in range(k):
+        if L.held[j] in seen:
+            L.held[j] = -1
+        elif L.held[j] >= 0:
+            seen.add(L.held[j])
+    for j in range(k):
+        e = L.held[j]
+        if (e == L.n + j or not DYN["on"]) and j < L.b:
+            L.held[j] = L.n + j
+            for _, nm in L.names:
+                L.slots[nm][j].copy_(L.banks[nm][j], non_blocking=True)
+        elif not DYN["on"]:
+            L.held[j] = -1
+        elif e >= 0:
+            _arena_load(L, e, {key: L.slots[nm][j] for key, nm in DYN["roles"][L.idx].items()}, DYN["order"])
+    for j in range(k, L.x):
+        L.held[j] = -1  # unmapped: what it held is gone
+    if DYN.get("res") and L.res_t is not None:
+        # the resident rows back to what they held before the window (res_guard put
+        # 0..N-1 in them for the streamer)
+        for r in range(L.n):
+            if L.res_now[r] != L.res_held[r]:
+                _arena_load(L, L.res_held[r], {key: t[r] for key, t in L.res_t.items()}, DYN["order"])
+                L.res_now[r] = L.res_held[r]
+
+
+def _refill(L: _Layer, k: int, job: dict, pending: set) -> None:
+    """KT_KV_HOT_DYN_REFILL_FAST: _dyn_fill as a job. The resident rows go back to what they
+    held before the window; the k slots take the best-scored experts by the scores saved
+    across the window (_refill_choose); every copy is a job item, its place in pending."""
+    res = bool(DYN.get("res")) and L.res_t is not None
+    if res:
+        for r in range(L.n):
+            if L.res_now[r] != L.res_held[r]:
+                job["items"].append((L, 1, r, L.res_held[r], "arena"))
+                job["pub"][1].append((L.idx, L.res_held[r], r))
+                pending.add((L.idx, 1, r))
+                L.res_now[r] = L.res_held[r]
+                L.since[(1, r)] = DYN["rounds"]
+    excl = set(L.res_held) if res else set(range(L.n))
+    sc = DYN["scores"][L.idx] if DYN["scores"] is not None and DYN["scores"][L.idx].max() > 0 else None
+    new = _refill_choose(sc, L.held, k, L.n, L.b, excl)
+    for j in range(k):
+        L.held[j] = e = new[j]
+        if e < 0:
+            continue
+        job["items"].append((L, 0, j, e, "bank" if (e == L.n + j and j < L.b) else "arena"))
+        job["pub"][0].append((L.idx, e, j))
+        pending.add((L.idx, 0, j))
+        L.since[(0, j)] = DYN["rounds"]
+    for j in range(k, L.x):
+        L.held[j] = -1  # unmapped: what it held is gone
+
+
+def _dyn_table(dev, pending=frozenset()) -> None:
+    """The slot table from what each lent slot holds, and the resident rows' table; a place
+    in pending ((layer, 0 slot / 1 row, index): a fast refill's copy in flight) stays out
+    of both (its job puts it in)."""
+    tbl = STATE["tbl"]
+    tbl.fill_(-1)
+    rows = [(L.idx, L.held[j], j) for L in LAYERS for j in range(L.k) if L.held[j] >= 0
+            and (L.idx, 0, j) not in pending]
+    if rows:
+        t = torch.tensor(rows, dtype=torch.int64).to(dev)
+        tbl[t[:, 0], t[:, 1]] = t[:, 2]
+    if DYN_RES:
+        rtbl = STATE["rtbl"]
+        rtbl.fill_(-1)
+        rows = [(L.idx, L.res_now[r], r) for L in LAYERS for r in range(L.n) if (L.idx, 1, r) not in pending]
+        if rows:
+            t = torch.tensor(rows, dtype=torch.int64).to(dev)
