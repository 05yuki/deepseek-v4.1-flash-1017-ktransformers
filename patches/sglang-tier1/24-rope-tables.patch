From 1b4e208eb86082fa8598fd1ce1ff35e58ad36f9b Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Wed, 4 Nov 2026 10:31:24 +0900
Subject: [PATCH] rope-tables: map the RoPE tables as the context grows, and
 build no unused one

Every DeepSeek-V4 attention layer reads one of two complex64 freqs_cis tables (the plain
base and the compressed YaRN base), each built for max_position_embeddings (1M on V4.1:
256 MiB each) whatever context is served. Each layer also built rotary_emb, whose fp32
cos/sin cache holds the same angles again (another 512 MiB); on CUDA nothing reads it (the
compressor and the C4 indexer store it unused; its readers are the NPU and ROCm paths), so
it is no longer built there.

With SGLANG_DSV4_ROPE_LAZY=1 each freqs_cis table moves after loading to a kv_vmm shadow
range of the same size, with 2 MiB chunks mapped only for the rows a forward can reach
(the first 65,536, then the batch's longest sequence plus 16,384), filled from a pinned
host copy. The kernels, views and CUDA graphs keep their addresses. ensure() runs before
every forward next to kt_lend.before_forward. SGLANG_DSV4_ROPE_LAZY_VERIFY=1 compares the
mapped rows with the host copy after each growth.

Checked on RTX 5070 Ti, one and two GPUs, 1M context: tools/qualify.sh passes; a 35K
prompt with the first mapping cut to 16,384 rows grew the tables three times, each equal
to the host copy, 6-32 ms a growth.
---
 python/sglang/srt/layers/lazy_rope_table.py   | 127 ++++++++++++++++++
 .../sglang/srt/model_executor/model_runner.py |   4 +
 python/sglang/srt/models/deepseek_v4.py       |  37 +++--
 3 files changed, 160 insertions(+), 8 deletions(-)
 create mode 100644 python/sglang/srt/layers/lazy_rope_table.py

diff --git a/python/sglang/srt/layers/lazy_rope_table.py b/python/sglang/srt/layers/lazy_rope_table.py
new file mode 100644
index 00000000..3272c976
--- /dev/null
+++ b/python/sglang/srt/layers/lazy_rope_table.py
@@ -0,0 +1,127 @@
+"""DeepSeek-V4 RoPE tables mapped as the context grows.
+
+Every V4 attention layer reads one of two complex64 freqs_cis tables (the plain base and the
+compressed YaRN base) indexed by position, each built for max_position_embeddings (1M on
+V4.1: 256 MiB each), whatever context is served. With SGLANG_DSV4_ROPE_LAZY=1 each table moves
+to a kv_vmm shadow range of the same size (one virtual range: the tensor, its views and the
+CUDA graphs that read it never move) with physical chunks mapped only for the rows a forward
+can reach; a pinned host copy of the table fills each new chunk, so the values are the table's
+bytes. ensure(forward_batch) runs before every forward (model_runner, next to
+kt_lend.before_forward) and maps up to the batch's longest sequence plus one step.
+
+An unmapped row of a shadow range reads as zero, so a forward must never reach past what
+ensure mapped: positions are below seq_len, and capture-time dummy batches stay inside the
+first INITIAL_ROWS.
+"""
+import logging
+import os
+import time
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+STEP = int(os.environ.get("SGLANG_DSV4_ROPE_LAZY_STEP", "16384"))
+INITIAL_ROWS = int(os.environ.get("SGLANG_DSV4_ROPE_LAZY_INITIAL", "65536"))
+_TABLES = []
+
+
+def enabled() -> bool:
+    return os.environ.get("SGLANG_DSV4_ROPE_LAZY", "0") == "1"
+
+
+def _map(ent, rows: int) -> None:
+    dev = ent["dev"]
+    rows = min(dev.shape[0], -(-rows // STEP) * STEP)
+    have = ent["rows"]
+    if rows <= have:
+        return
+    from sglang.srt.layers.moe import kt_kv_vmm
+
+    rb = ent["row_bytes"]
+    if kt_kv_vmm.restore(dev, have * rb, (rows - have) * rb) < 0:
+        raise torch.OutOfMemoryError(
+            f"RoPE table: mapping rows {have}..{rows} on {dev.device}"
+        )
+    dev[have:rows].copy_(ent["host"][have:rows])
+    ent["rows"] = rows
+    if os.environ.get("SGLANG_DSV4_ROPE_LAZY_VERIFY", "0") == "1":
+        same = torch.equal(dev[:rows].cpu(), ent["host"][:rows])
+        logger.info("RoPE table check: rows 0..%d %s the host copy", rows, "equal" if same else "DIFFER from")
+
+
+def make_lazy(table: torch.Tensor) -> torch.Tensor:
+    """A shadow-range copy of table with its first INITIAL_ROWS mapped."""
+    from sglang.srt.layers.moe import kt_kv_vmm
+
+    host = torch.empty(table.shape, dtype=table.dtype, pin_memory=True)
+    host.copy_(table)
+    dev = kt_kv_vmm.shadow_tensor(table.shape, table.dtype, table.device.index)
+    ent = dict(dev=dev, host=host, rows=0, row_bytes=table[0].numel() * table.element_size())
+    _map(ent, INITIAL_ROWS)
+    torch.cuda.synchronize(table.device)
+    _TABLES.append(ent)
+    return dev
+
+
+def ensure(forward_batch) -> None:
+    if not _TABLES:
+        return
+    lens = getattr(forward_batch, "seq_lens_cpu", None)
+    if lens is not None and lens.numel():
+        need = int(lens.max())
+    else:
+        lens = getattr(forward_batch, "seq_lens", None)
+        if lens is None or not lens.numel():
+            return
+        need = int(lens.max().item())
+    need += STEP
+    if all(need <= ent["rows"] or ent["rows"] >= ent["dev"].shape[0] for ent in _TABLES):
+        return
+    t0 = time.perf_counter()
+    for ent in _TABLES:
+        _map(ent, need)
+    logger.info(
+        "RoPE tables: %d rows mapped (%.1f MiB a table) in %.1f ms",
+        _TABLES[0]["rows"],
+        _TABLES[0]["rows"] * _TABLES[0]["row_bytes"] / 2**20,
+        (time.perf_counter() - t0) * 1e3,
+    )
+
+
+def install(model) -> int:
+    """Every freqs_cis table of model's modules (buffers and plain attributes) moved to a
+    lazily mapped range; returns the device bytes no longer resident."""
+    if not enabled() or not torch.cuda.is_available():
+        return 0
+    found = {}
+    for mod in model.modules():
+        for name, buf in list(mod._buffers.items()):
+            if name == "freqs_cis" and torch.is_tensor(buf) and buf.is_cuda:
+                found.setdefault(buf.data_ptr(), buf)
+        v = vars(mod).get("freqs_cis")
+        if torch.is_tensor(v) and v.is_cuda:
+            found.setdefault(v.data_ptr(), v)
+    if not found:
+        return 0
+    new = {ptr: make_lazy(t) for ptr, t in found.items()}
+    for mod in model.modules():
+        for name, buf in list(mod._buffers.items()):
+            if torch.is_tensor(buf) and buf.is_cuda and buf.data_ptr() in new and buf.shape == new[buf.data_ptr()].shape:
+                mod._buffers[name] = new[buf.data_ptr()]
+        for k, v in list(vars(mod).items()):
+            if k == "_buffers" or k == "_parameters":
+                continue
+            if torch.is_tensor(v) and v.is_cuda and v.data_ptr() in new and v.shape == new[v.data_ptr()].shape:
+                setattr(mod, k, new[v.data_ptr()])
+    freed = sum(t.numel() * t.element_size() for t in found.values())
+    try:
+        from sglang.kernels.ops.attention.dsv4.rope import precompute_freqs_cis
+
+        precompute_freqs_cis.cache_clear()
+    except Exception:
+        pass
+    found.clear()
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
+    return freed
diff --git a/python/sglang/srt/model_executor/model_runner.py b/python/sglang/srt/model_executor/model_runner.py
index e6d3a43e..2adfdafa 100644
--- a/python/sglang/srt/model_executor/model_runner.py
+++ b/python/sglang/srt/model_executor/model_runner.py
@@ -1943,6 +1943,10 @@ class ModelRunner:
             from sglang.srt.layers.moe import kt_lend
 
             kt_lend.before_forward(forward_batch)
+            # the lazily mapped RoPE tables reach this batch's positions
+            from sglang.srt.layers import lazy_rope_table
+
+            lazy_rope_table.ensure(forward_batch)
             output = self._forward_raw(forward_batch, pp_proxy_tensors)
             if self.enable_elastic_ep:
                 output = self._maybe_rebalance_after_rank_fault(
diff --git a/python/sglang/srt/models/deepseek_v4.py b/python/sglang/srt/models/deepseek_v4.py
index fa29c6ab..25e9608f 100644
--- a/python/sglang/srt/models/deepseek_v4.py
+++ b/python/sglang/srt/models/deepseek_v4.py
@@ -608,6 +608,19 @@ def _vision_offload(model) -> None:
         pass
 
 
+def _rope_lazy(model) -> None:
+    """SGLANG_DSV4_ROPE_LAZY=1: the freqs_cis tables mapped as the context grows
+    (layers/lazy_rope_table.py); 0.54 GB a GPU at 1M until a context needs them."""
+    from sglang.srt.layers import lazy_rope_table
+
+    nbytes = lazy_rope_table.install(model)
+    if nbytes:
+        logger.info(
+            "RoPE tables mapped as the context grows: %.1f MiB no longer resident",
+            nbytes / 2**20,
+        )
+
+
 @contextmanager
 def _vision_on_gpu(model):
     """Around an image batch: the tower's parameters back on the GPU, freed after."""
@@ -1726,14 +1739,21 @@ class MQALayer(MqaAttentionBase):
         if self.compress_ratio:
             active_rope_scaling = dict(self.rope_scaling or {})
             active_rope_scaling["rope_type"] = "deepseek_yarn"
-        self.rotary_emb = get_rope_wrapper(
-            head_size=self.rope_head_dim,
-            rotary_dim=self.rope_head_dim,
-            max_position=config.max_position_embeddings,
-            base=self.rope_base,
-            rope_scaling=active_rope_scaling,
-            is_neox_style=False,
-            device=get_device().device,
+        # On CUDA nothing reads rotary_emb: the compressor and the C4 indexer keep it unused, and
+        # the cos/sin consumers are the NPU and ROCm paths. Its fp32 cos/sin cache over the full
+        # max_position_embeddings (two RoPE bases: 0.54 GB a GPU at 1M) is not built there.
+        self.rotary_emb = (
+            None
+            if _is_cuda
+            else get_rope_wrapper(
+                head_size=self.rope_head_dim,
+                rotary_dim=self.rope_head_dim,
+                max_position=config.max_position_embeddings,
+                base=self.rope_base,
+                rope_scaling=active_rope_scaling,
+                is_neox_style=False,
+                device=get_device().device,
+            )
         )
         if _GGUF_ROPE and isinstance(getattr(self.rotary_emb, "cos_sin_cache", None), torch.Tensor):
             # the served context's rows only, as freqs_cis
@@ -5673,6 +5693,7 @@ class DeepseekV4ForCausalLM(nn.Module):
     def post_load_weights(self, is_nextn=False, weight_names=None):
         if not is_nextn:
             _vision_offload(self)
+            _rope_lazy(self)
             _setup_wo_a_native(self)
         if self.wo_a_fp8:
             self._setup_fp8_wo_a_scales(is_nextn)
