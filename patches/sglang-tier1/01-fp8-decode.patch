+
     configs = get_w8a8_block_fp8_configs(N, K, block_size[0], block_size[1])
     if configs:
         # If an optimal configuration map has been found, look up the
@@ -819,9 +838,39 @@ def w8a8_block_fp8_matmul_triton(
             "num_stages": 3,
         }
 
+    # Skinny GEMMs (decode: M is the batch, 1 here) with the default tiling
+    # launch only N/128 CTAs, each streaming a K x 128 strip alone: on the
+    # RTX 5070 Ti (no tuned config) that is 250-500 GB/s against ~900. For
+    # M <= 16 use the split-K kernel with a 16-row tile: measured 3-6x faster
+    # on N=2048..7168 and ~1.2x on N=16384+. SGLANG_FP8_SKINNY=0 turns it off;
+    # SGLANG_FP8_SKINNY_SPLIT_K / _BLOCK_N override the tile.
+    skinny = (
+        not configs
+        and M <= 16
+        and not _is_hip
+        and not _is_gfx1250
+        and os.environ.get("SGLANG_FP8_SKINNY", "1") == "1"
