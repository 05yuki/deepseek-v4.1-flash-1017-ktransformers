+    # by one, 32 on V4.1-1017); SGLANG_FP8_GEMV=0 turns it off.
+    if (
+        M <= 4
+        and _FP8_GEMV
+        and not _is_hip
+        and not _is_gfx1250
+        and As.dtype == torch.float
+        and Bs.dtype == torch.float
