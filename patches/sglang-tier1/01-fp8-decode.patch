 logger = logging.getLogger(__name__)
 
 
@@ -773,6 +774,9 @@ def w8a8_mxfp8_matmul_deepgemm(
     return C
 
 
+_skinny_seen = set()
+
+
 def w8a8_block_fp8_matmul_triton(
     A: torch.Tensor,
     B: torch.Tensor,
@@ -802,6 +806,21 @@ def w8a8_block_fp8_matmul_triton(
 
     block_n, block_k = block_size
 
