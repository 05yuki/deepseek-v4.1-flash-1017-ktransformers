From 0705bf0f224dd15f56705176e81d62519f30c402 Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Mon, 19 Oct 2026 22:58:32 +0900
Subject: [PATCH] wo-a-fp8: keep wo_a in the checkpoint's FP8, read by a GEMV
 in decode

DeepSeek V4 attention's `wo_a` in FP8
(`deepseek_common/wo_a_fp8_gemv.py`). `SGLANG_DSV4_WO_A_FP8_NATIVE=1`
keeps the checkpoint's FP8 `wo_a` as loaded (no bf16 copy), whatever
its block size: decode reads it with an FP8 GEMV, prefill dequantizes it
into one shared bf16 buffer per device. (The FP8 absorb GEMM already in
SGLang takes 128 x 128 blocks only; DeepSeek-V4.1-Flash-1017 has 32 x
32.)

Numerics: Decode GEMV not bit-identical (fp32 summation order; 99.98% of
outputs equal, the rest 1 ulp). The prefill dequantize path is
bit-identical (the same bf16 values).

Prerequisites: none.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 .../models/deepseek_common/wo_a_fp8_gemv.py   |  73 +++++++++++++
 python/sglang/srt/models/deepseek_v4.py       | 103 +++++++++++++++++-
 2 files changed, 174 insertions(+), 2 deletions(-)
 create mode 100644 python/sglang/srt/models/deepseek_common/wo_a_fp8_gemv.py

diff --git a/python/sglang/srt/models/deepseek_common/wo_a_fp8_gemv.py b/python/sglang/srt/models/deepseek_common/wo_a_fp8_gemv.py
new file mode 100644
index 0000000000..8ff875faee
--- /dev/null
+++ b/python/sglang/srt/models/deepseek_common/wo_a_fp8_gemv.py
@@ -0,0 +1,73 @@
+"""V4 wo_a from FP8 weights (patches/sglang-dsv4-wo-a-fp8-gemv.py,
+patches/sglang-dsv4-wo-a-fp8-block.py)."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+def fp8_blocks_from_bf16(w: torch.Tensor, blocks=(128, 32)):
+    """[G, R, D] bf16 -> ([G, R, D] e4m3, [G, R/b, D/b] fp32) by the converter's rule
+    (scale 2^ceil(log2(amax / 448)) per b x b block), at the first block size b that
+    reproduces w exactly; None if none does."""
+    G, R, D = w.shape
+    for b in blocks:
+        if R % b or D % b:
+            continue
+        tiles = w.float().view(G, R // b, b, D // b, b)
+        amax = tiles.abs().amax(dim=(2, 4))
+        exp = torch.ceil(torch.log2(torch.where(amax > 0, amax / 448.0, torch.ones_like(amax))))
+        exp = torch.where(amax > 0, exp, torch.full_like(exp, -127.0))
+        scale = torch.exp2(exp)
+        q = (tiles / scale[:, :, None, :, None]).to(torch.float8_e4m3fn)
+        back = (q.float() * scale[:, :, None, :, None]).view(G, R, D).to(torch.bfloat16)
+        del tiles
+        if torch.equal(back, w):
+            return q.view(G, R, D).contiguous(), scale.contiguous()
+    return None
+
+
+@triton.jit
+def _wo_a_fp8_gemv_kernel(x_ptr, w_ptr, s_ptr, o_ptr, R, D, SB: tl.constexpr,
+                          BLOCK_R: tl.constexpr, BLOCK_D: tl.constexpr):
+    g = tl.program_id(0)
+    rb = tl.program_id(1)
+    rows = rb * BLOCK_R + tl.arange(0, BLOCK_R)
+    acc = tl.zeros([BLOCK_R, BLOCK_D], dtype=tl.float32)
+    for d0 in range(0, D, BLOCK_D):
+        cols = d0 + tl.arange(0, BLOCK_D)
+        x = tl.load(x_ptr + g * D + cols).to(tl.float32)
+        w = tl.load(w_ptr + (g * R + rows[:, None]) * D + cols[None, :]).to(tl.float32)
+        s = tl.load(s_ptr + (g * (R // SB) + rows[:, None] // SB) * (D // SB) + cols[None, :] // SB)
+        acc += w * s * x[None, :]
+    tl.store(o_ptr + g * R + rows, tl.sum(acc, axis=1).to(o_ptr.dtype.element_ty))
+
+
+def wo_a_fp8_gemv(o: torch.Tensor, q: torch.Tensor, s: torch.Tensor) -> torch.Tensor:
+    """o [1, G, D] bf16, q [G, R, D] e4m3, s [G, R/b, D/b] -> [1, G, R] bf16."""
+    G, R, D = q.shape
+    x = o.reshape(G, D).contiguous()
+    out = torch.empty((1, G, R), device=o.device, dtype=o.dtype)
+    _wo_a_fp8_gemv_kernel[(G, R // 16)](x, q, s, out, R, D, SB=R // s.shape[1],
+                                        BLOCK_R=16, BLOCK_D=256, num_warps=4)
+    return out
+
+
+@triton.jit
+def _wo_a_fp8_dequant_kernel(w_ptr, s_ptr, o_ptr, R, D, SB: tl.constexpr,
+                             BLOCK_R: tl.constexpr, BLOCK_D: tl.constexpr):
+    g = tl.program_id(0)
+    rows = tl.program_id(1) * BLOCK_R + tl.arange(0, BLOCK_R)
+    cols = tl.program_id(2) * BLOCK_D + tl.arange(0, BLOCK_D)
+    offs = (g * R + rows[:, None]).to(tl.int64) * D + cols[None, :]
+    w = tl.load(w_ptr + offs).to(tl.float32)
+    s = tl.load(s_ptr + (g * (R // SB) + rows[:, None] // SB) * (D // SB) + cols[None, :] // SB)
+    tl.store(o_ptr + offs, (w * s).to(o_ptr.dtype.element_ty))
+
+
+def wo_a_fp8_dequant(q: torch.Tensor, s: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    """q [G, R, D] e4m3, s [G, R/b, D/b] -> out [G, R, D] bf16 (exact: s is a power of two)."""
+    G, R, D = q.shape
+    _wo_a_fp8_dequant_kernel[(G, R // 32, D // 128)](q, s, out, R, D, SB=R // s.shape[1],
+                                                     BLOCK_R=32, BLOCK_D=128, num_warps=4)
+    return out
diff --git a/python/sglang/srt/models/deepseek_v4.py b/python/sglang/srt/models/deepseek_v4.py
index d903035837..3ea1f9e74a 100644
--- a/python/sglang/srt/models/deepseek_v4.py
+++ b/python/sglang/srt/models/deepseek_v4.py
@@ -486,6 +486,68 @@ def _o_fp8_qdq_block() -> int:
 _O_FP8_QDQ_BLOCK = _o_fp8_qdq_block()
 
 
+def _wo_a_fp8_native() -> bool:
+    """SGLANG_DSV4_WO_A_FP8_NATIVE=1: wo_a stays in the checkpoint's FP8 blocks (any block
+    size), read by a GEMV in single-token decode and dequantized for other forwards."""
+    import os
+
+    return os.environ.get("SGLANG_DSV4_WO_A_FP8_NATIVE", "0") == "1"
+
+
+_WO_A_FP8_NATIVE = _wo_a_fp8_native()
+
+
+class _WoANativeKeep:
+    """wo_a's quant method under SGLANG_DSV4_WO_A_FP8_NATIVE: nothing after loading."""
+
+    def process_weights_after_loading(self, layer) -> None:
+        return None
+
+
+def _setup_wo_a_native(model) -> None:
+    """After loading: each native-FP8 wo_a's scales as fp32 [G, R/b, D/b] (powers of
+    two, exact), and one bf16 scratch per device for the forwards that dequantize."""
+    scratch, n = {}, 0
+    for module in model.modules():
+        if not getattr(module, "_wo_a_native_fp8", False):
+            continue
+        w, sc = module.wo_a.weight, module.wo_a.weight_scale_inv
+        G, R = module.n_local_groups, module.o_lora_rank
+        D = w.shape[-1]
+        if w.dtype != torch.float8_e4m3fn or w.shape[0] != G * R or sc.dim() != 2:
+            raise RuntimeError(
+                f"SGLANG_DSV4_WO_A_FP8_NATIVE: wo_a {tuple(w.shape)} {w.dtype}, "
+                f"scales {tuple(sc.shape)} {sc.dtype}: not the checkpoint's FP8 blocks"
+            )
+        b, bk = (G * R) // sc.shape[0], D // sc.shape[1]
+        if b != bk or R % b or b * sc.shape[0] != G * R:
+            raise RuntimeError(
+                f"SGLANG_DSV4_WO_A_FP8_NATIVE: {b} x {bk} blocks over [{G * R}, {D}]"
+            )
+        if sc.dtype in (torch.uint8, torch.float8_e8m0fnu):  # E8M0 exponents
+            scf = torch.exp2(sc.view(torch.uint8).float() - 127)
+        else:
+            scf = sc.float()
+        module._wo_a_native_s = scf.reshape(G, R // b, D // b).contiguous()
+        key = (w.device, G, R, D)
+        if key not in scratch:
+            scratch[key] = torch.empty((G, R, D), dtype=torch.bfloat16, device=w.device)
+        module._wo_a_fp8_scratch = scratch[key]
+        n += 1
+    if n:
+        logger.info(
+            "wo_a in the checkpoint's FP8: %d layers, %.1f MB of scratch",
+            n,
+            sum(t.numel() * 2 for t in scratch.values()) / 2**20,
+        )
+
+
+from sglang.srt.models.deepseek_common.wo_a_fp8_gemv import (  # noqa: E402
+    wo_a_fp8_dequant,
+    wo_a_fp8_gemv,
+)
+
+
 def _apply_wo_a_bf16_matmul(
     o: torch.Tensor,
     wo_a: torch.Tensor,
@@ -1062,6 +1124,16 @@ class MqaAttentionBase(nn.Module):
         else:
             wo_a_quant_config = None
 
+        self._wo_a_native_fp8 = (
+            _WO_A_FP8_NATIVE
+            and not quantize_wo_a
+            and wo_a_fp8 is None
+            and wo_a_keeps_quant_config is None
+            and isinstance(quant_config, Fp8Config)
+            and quant_config.weight_block_size is not None
+        )
+        if self._wo_a_native_fp8:
+            wo_a_quant_config = quant_config
         self.fuse_wqa_wkv = fuse
         self.wo_a_fp8 = fp8
 
@@ -1107,8 +1179,17 @@ class MqaAttentionBase(nn.Module):
             quant_config=wo_a_quant_config,
             prefix=add_prefix("wo_a", prefix),
             parallel_group="attn_tp",
-            **({} if quantize_wo_a else {"params_dtype": torch.bfloat16}),
+            **(
+                {}
+                if quantize_wo_a or self._wo_a_native_fp8
+                else {"params_dtype": torch.bfloat16}
+            ),
         )
+        if self._wo_a_native_fp8:
+            # applied by forward() below, never through the linear method: keep the
+            # weight and its scales as loaded (no requantization, no relayout)
+            self.wo_a.keep_plain_weight_layout = True
+            self.wo_a.quant_method = _WoANativeKeep()
         if quantize_wo_a:
             assert hasattr(self.wo_a, "weight_scale_inv"), (
                 "FP8 quant_config must create weight_scale_inv"
@@ -3004,7 +3085,20 @@ class MQALayer(MqaAttentionBase):
 
                     o = o_fp8_qdq_(o, _O_FP8_QDQ_BLOCK)
                 wo_a_weight = getattr(self.wo_a, "weight", None)
-                if wo_a_weight is not None:
+                if getattr(self, "_wo_a_native_s", None) is not None:
+                    # the weight is viewed here, every call: the prefill lend
+                    # points it elsewhere while it streams
+                    q = wo_a_weight.view(self.n_local_groups, self.o_lora_rank, -1)
+                    if o.shape[0] == 1 and forward_batch.forward_mode.is_decode():
+                        o = wo_a_fp8_gemv(o, q, self._wo_a_native_s)
+                    else:
+                        wo_a = wo_a_fp8_dequant(
+                            q, self._wo_a_native_s, self._wo_a_fp8_scratch
+                        )
+                        o = _apply_wo_a_bf16_matmul(
+                            o, wo_a, is_decode=forward_batch.forward_mode.is_decode()
+                        )
+                elif wo_a_weight is not None:
                     if (
                         _NPU_BF16_WO_A_GEMM
                         and forward_batch.forward_mode.is_decode()
@@ -5083,6 +5177,8 @@ class DeepseekV4ForCausalLM(nn.Module):
                 attn.wo_a.weight_scale_inv.format_ue8m0 = False
 
     def post_load_weights(self, is_nextn=False, weight_names=None):
+        if not is_nextn:
+            _setup_wo_a_native(self)
         if self.wo_a_fp8:
             self._setup_fp8_wo_a_scales(is_nextn)
 
@@ -5799,6 +5895,9 @@ def _prepare_deepseek_v4_weights(
         return weights
     if quant_config is not None and quant_config.get_name() == "quark":
         weights = _rename_quark_fp8_block_scales(weights)
+    if _WO_A_FP8_NATIVE and isinstance(quant_config, Fp8Config):
+        # wo_a loads as the checkpoint has it
+        return weights
     return _dequant_fp8_wo_a_streaming(weights)
 
 
