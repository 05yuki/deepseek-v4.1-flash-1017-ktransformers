From 234df43bd63b870f975706872d8461fb8e498582 Mon Sep 17 00:00:00 2001
From: 05yuki <ceu.azul.samu@gmail.com>
Date: Mon, 19 Oct 2026 16:44:35 +0900
Subject: [PATCH] thinking-default-parser: reasoning parser falls back to
 SGLANG_DEFAULT_THINKING

When a request sends no thinking toggle in `chat_template_kwargs`, the
reasoning parser falls back to `SGLANG_DEFAULT_THINKING`, the same
fallback the DeepSeek V4 encoder uses to decide whether the prompt opens
a thinking block, so the parser and the prompt agree. Before, a missing
toggle always meant no thinking for the parser.

Numerics: No switch of its own. Identical unless
`SGLANG_DEFAULT_THINKING=1`.

Prerequisites: none; applies alone on tier 0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 python/sglang/srt/entrypoints/openai/serving_chat.py | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/python/sglang/srt/entrypoints/openai/serving_chat.py b/python/sglang/srt/entrypoints/openai/serving_chat.py
index 50ef9458..a520cf2f 100644
--- a/python/sglang/srt/entrypoints/openai/serving_chat.py
+++ b/python/sglang/srt/entrypoints/openai/serving_chat.py
@@ -3579,10 +3579,12 @@ class OpenAIServingChat(OpenAIServingBase):
                 )
             if mode in ("explicit_thinking", "explicit_enable_thinking"):
                 toggle = mode.replace("explicit_", "")
-                return (
-                    request.chat_template_kwargs is not None
-                    and request.chat_template_kwargs.get(toggle) is True
-                )
+                # Same fallback the DSV4 encoder uses to decide whether the
+                # prompt opens a thinking block, so the parser and the prompt
+                # agree when the client sends no toggle.
+                return (request.chat_template_kwargs or {}).get(
+                    toggle, envs.SGLANG_DEFAULT_THINKING.get()
+                ) is True
             logger.warning(
                 "Unknown reasoning_default mode '%s', defaulting to reasoning disabled",
                 mode,
