+    model = get_server_args().model_path
+    idx = _ckpt_cache.get("index")
+    if idx is None:
+        idx = json.load(open(os.path.join(model, "model.safetensors.index.json")))["weight_map"]
+        _ckpt_cache["index"] = idx
