+            for k in range(ids64.shape[1]):
+                e = int(ids64[t, k])
+                if e >= n_hot:
+                    continue
+                if e not in cache:
+                    cache[e] = _ckpt_expert(layer_idx, p2l[e], streamer.rank, streamer.world, N, K, x.device)
