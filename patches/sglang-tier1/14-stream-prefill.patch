+    base = f"layers.{layer_idx}.ffn.experts.{logical}."
+    r0, r1 = rank * N, (rank + 1) * N
+    g = deq(load(base + "w1.weight")[r0:r1], load(base + "w1.scale")[r0:r1], N, K)
+    u = deq(load(base + "w3.weight")[r0:r1], load(base + "w3.scale")[r0:r1], N, K)
