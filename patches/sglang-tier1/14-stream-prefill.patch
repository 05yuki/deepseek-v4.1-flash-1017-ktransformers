+                wgt = float(topk_weights[t, k])
+                gx, ux = xf[t] @ g_w.t(), xf[t] @ u_w.t()
+                lim = getattr(streamer, "swiglu_limit_value", None)
+                if SWIGLU_CLAMP and lim is not None:
+                    gx, ux = gx.clamp(max=lim), ux.clamp(-lim, lim)
+                h = torch.nn.functional.silu(gx) * ux
