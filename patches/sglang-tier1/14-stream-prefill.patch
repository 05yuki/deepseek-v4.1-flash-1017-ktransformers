+        logger.warning(
+            "shared CUTLASS MoE workspace too small or missing (%d MB needed, %s); "
+            "falling back to a per-call allocation",
+            nbytes >> 20,
+            "none" if ws is None else f"{ws.numel() >> 20} MB",
+        )
