+    total = host.numel()
+    mv = memoryview(host.numpy())
+    tail = total % 4096
+    body = total - tail
+    t0 = time.perf_counter()
+    off = 0
+    while off < body:
+        w = os.pwritev(fd, [mv[off : off + min(_MPIECE, body - off)]], off)
+        if w <= 0:
+            raise IOError(f"mirror write failed at {off}")
+        off += w
