Date: Mon, 19 Oct 2026 16:44:35 +0900
Subject: [PATCH] [tier 2] engram-row-prefetch: start decode's engram row
 lookups with the token, on a side stream

In decode, each engram layer's rank-local row lookup starts at the
beginning of the token on a side stream instead of when its layer comes.
The all-reduce, `wkv` and the gate stay where they were. Only with one
pipeline stage, no DP attention and engram tables that are not shared.

Numerics: Bit-identical: only the lookup moves.

Prerequisites: none; applies alone on tier 1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C2UBZdnrDZSBh8yQz8rc9g
---
 python/sglang/srt/layers/engram.py      |  4 ++
 python/sglang/srt/models/deepseek_v4.py | 58 ++++++++++++++++++++++---
 2 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/python/sglang/srt/layers/engram.py b/python/sglang/srt/layers/engram.py
index 453d63811d..fe6931dfc9 100644
--- a/python/sglang/srt/layers/engram.py
+++ b/python/sglang/srt/layers/engram.py
@@ -1072,6 +1072,10 @@ class Engram(nn.Module):
             # Nothing to gate, and the MXFP8 quantize behind wkv rejects an
             # empty M.
             return x
+        return self.gate_rows(x, emb)
+
+    def gate_rows(self, x: torch.Tensor, emb: torch.Tensor) -> torch.Tensor:
+        """The layer's output from its looked-up rows `emb` (the tail of forward)."""
         kv, _ = self.wkv(emb.flatten(-2))
         return engram_gate(
             x, kv, self.q_weight, self.k_weight, self.eps, self.clamp_value
diff --git a/python/sglang/srt/models/deepseek_v4.py b/python/sglang/srt/models/deepseek_v4.py
index 0d3f8ffcc5..f7e49fa288 100644
--- a/python/sglang/srt/models/deepseek_v4.py
+++ b/python/sglang/srt/models/deepseek_v4.py
@@ -3,6 +3,7 @@ from __future__ import annotations
 import concurrent.futures
 import functools
 import logging
+import os
 import time
 from array import array
 from contextlib import contextmanager, nullcontext
@@ -3672,6 +3673,22 @@ class DeepseekV4Model(nn.Module):
                     else None
                 ),
             )
+        # Decode: the engram row lookups of the rank-local (not shared) tables
+        # start with the token on a side stream instead of at their layers.
+        self.engram_rows_stream = None
+        if (
+            _is_cuda
+            and os.environ.get("SGLANG_DSV41_ENGRAM_PREFETCH_ROWS", "1") == "1"
+            and self.pp_group.world_size == 1
+            and not is_dp_attention_enabled()
+            and any(
+                self.layers[i].engram is not None
+                and not self.layers[i].engram.embed._shared
+                for i in range(self.start_layer, self.end_layer)
+            )
+        ):
+            self.engram_rows_stream = torch.cuda.Stream()
+            logger.info("Engram row lookups start with the token in decode")
 
         if not _is_cuda:
             self.use_fused_mhc_post_pre = (
@@ -3831,6 +3848,26 @@ class DeepseekV4Model(nn.Module):
                 )
             else:
                 hash_ids = self.engram_hasher(input_ids, forward_batch)
+        # {layer: (rows, event)}: this rank's rows, looked up on the side stream
+        prefetched_rows = {}
+        if (
+            self.engram_rows_stream is not None
+            and hash_ids is not None
+            and hash_ids.shape[0] > 0
+            and forward_batch.forward_mode.is_decode()
+        ):
+            rows_stream = self.engram_rows_stream
+            rows_stream.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(rows_stream):
+                for j in range(self.start_layer, self.end_layer):
+                    eng = self.layers[j].engram
+                    if eng is None or eng.embed._shared:
+                        continue
+                    rows = eng.embed._owned_rows(hash_ids[:, eng.layer_hash_index])
+                    ev = torch.cuda.Event()
+                    ev.record(rows_stream)
+                    prefetched_rows[j] = (rows, ev)
+            hash_ids.record_stream(rows_stream)
         tail = None
         if (
             self.late_layer_start is not None
@@ -3952,12 +3989,21 @@ class DeepseekV4Model(nn.Module):
             engram = self.layers[i].engram
             if engram is not None:
                 before_engram = state.residual
-                hidden_states = engram(
-                    state.residual,
-                    hash_ids[:, engram.layer_hash_index],
-                    forward_batch,
-                    cp_all_tokens=cp_extend,
-                )
+                if i in prefetched_rows:
+                    rows, ev = prefetched_rows.pop(i)
+                    main_stream = torch.cuda.current_stream()
+                    main_stream.wait_event(ev)
+                    rows.record_stream(main_stream)
+                    if engram.embed.tp_size > 1:
+                        rows = engram.embed._reduce_owned_rows(rows)
+                    hidden_states = engram.gate_rows(state.residual, rows)
+                else:
+                    hidden_states = engram(
+                        state.residual,
+                        hash_ids[:, engram.layer_hash_index],
+                        forward_batch,
+                        cp_all_tokens=cp_extend,
+                    )
                 if (
                     self.config.model_type == "deepseek_v41"
                     and self.config.vision_n_layers > 0
