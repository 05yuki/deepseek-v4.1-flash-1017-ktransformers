+        scores[:, :full].unflatten(-1, (nb, block_size)).masked_fill_(
+            ~mask[:, :nb, None], -torch.inf
+        )
+    if full < w:
+        scores[:, full:].masked_fill_(~mask[:, nb : nb + 1], -torch.inf)
