+// KT_GGUF_PREFETCH: reader threads that madvise(MADV_WILLNEED) the ranges the forwards queue, so many reads
+// are in flight at once (one thread issuing them one after another kept NVMe at 0.4 GB/s)
+struct KtGgufReaders {
+  std::mutex mu;
+  std::condition_variable cv;
+  std::deque<std::pair<uint8_t*, size_t>> q;
+  std::vector<std::thread> threads;
+  KtGgufReaders() {
+    int n = getenv("KT_GGUF_PREFETCH_THREADS") ? atoi(getenv("KT_GGUF_PREFETCH_THREADS")) : 16;
+    n = n < 1 ? 1 : (n > 64 ? 64 : n);
+    for (int i = 0; i < n; ++i) {
+      threads.emplace_back([this] {
+        for (;;) {
+          std::pair<uint8_t*, size_t> r;
+          {
+            std::unique_lock<std::mutex> lk(mu);
+            cv.wait(lk, [this] { return !q.empty(); });
+            r = q.front();
+            q.pop_front();
+          }
+          madvise(r.first, r.second, MADV_WILLNEED);
+        }
+      });
+      threads.back().detach();
+    }
+  }
+  void push(uint8_t* p, size_t n) {
+    {
+      std::lock_guard<std::mutex> lk(mu);
+      q.emplace_back(p, n);
+    }
+    cv.notify_one();
+  }
+};
+inline KtGgufReaders& kt_gguf_readers() {
+  static KtGgufReaders* r = new KtGgufReaders();
+  return *r;
+}
