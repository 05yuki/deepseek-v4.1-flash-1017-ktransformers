diff -ruN a/kt-kernel/cpu_backend/worker_pool.cpp b/kt-kernel/cpu_backend/worker_pool.cpp
--- a/kt-kernel/cpu_backend/worker_pool.cpp
+++ b/kt-kernel/cpu_backend/worker_pool.cpp
@@ -401,7 +401,8 @@
 
 void NumaJobDistributor::worker_thread(int numa_id) {
   auto start = std::chrono::high_resolution_clock::now();
-  set_memory_to_numa(numa_id);
+  // numa_id is the subpool's index; its memory goes on the subpool's node
+  set_memory_to_numa(numa_ids[numa_id]);
   status[numa_id] =
       std::move(std::unique_ptr<std::atomic<ThreadStatus>>(new std::atomic<ThreadStatus>(ThreadStatus::WAITING)));
   ready_bar->arrive_and_wait();
diff -ruN a/kt-kernel/ext_bindings.cpp b/kt-kernel/ext_bindings.cpp
--- a/kt-kernel/ext_bindings.cpp
+++ b/kt-kernel/ext_bindings.cpp
@@ -562,6 +562,13 @@
 
   // kt-kernel-live-knobs.py
   m.def("set_knob", [](const std::string& name, int value) { kt_knob_set(name, value); });
+  // the GGUF expert cache's resident experts for an outside reader
+  m.def("kt_gguf_cache_peek", [](int layer, int expert) -> py::object {
+    uintptr_t o[3];
+    if (!kt_gguf_cache_peek((uint64_t)layer, (int64_t)expert, o)) return py::none();
+    return py::make_tuple((unsigned long long)o[0], (unsigned long long)o[1], (unsigned long long)o[2]);
+  });
+  m.def("kt_gguf_cache_unpin", [](int layer, int expert) { kt_gguf_cache_unpin((uint64_t)layer, (int64_t)expert); });
   m.def("get_knob", [](const std::string& name) { return kt_knob_get(name); });
   py::class_<WorkerPool>(m, "WorkerPool").def(py::init<int>());
   py::class_<WorkerPoolConfig>(m, "WorkerPoolConfig")
