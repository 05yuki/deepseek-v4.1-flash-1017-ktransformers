+struct KtExpertCache {
+  size_t budget = 0, used = 0;
+  std::atomic<uint64_t> hits{0}, misses{0}, read_bytes{0}, read_ns{0};
+  struct Entry {
+    uint8_t* mem[3] = {nullptr, nullptr, nullptr};
+    uint8_t* data[3] = {nullptr, nullptr, nullptr};
+    size_t bytes = 0;
+    int pins = 0;
+    uint8_t* slot = nullptr;  // its slab slot (the three tensors carved from it), or malloc'd tensors
+    size_t slot_cls = 0;      // the slot's size class (0: the fixed slab)
+    uint8_t rep = 0;          // bit t set when tensor t has a repacked copy (kt_iq1mt)
+    uint8_t* tdata[3] = {nullptr, nullptr, nullptr};  // the repacked copies
+    std::shared_ptr<std::atomic<int>> left;  // pieces of its reads not done yet (asynchronous acquire)
