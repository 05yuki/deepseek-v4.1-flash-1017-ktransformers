+// KT_GGUF_EXPERT_CACHE_GIB: kt-kernel's own RAM tier for GGUF experts
+struct KtJobs {
+  std::mutex mu;
+  std::condition_variable cv, done;
+  std::deque<std::function<void()>> q;
+  size_t pending = 0;
+  // KT_GGUF_PREFETCH_CPUS: "a-b,c,d-e" -> the CPUs the reader threads are pinned to (none: unpinned)
+  static cpu_set_t reader_cpus(bool& any) {
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    any = false;
+    const char* e = getenv("KT_GGUF_PREFETCH_CPUS");
+    if (!e || !*e) return set;
+    std::string spec(e);
+    size_t pos = 0;
+    while (pos < spec.size()) {
+      size_t comma = spec.find(',', pos);
+      if (comma == std::string::npos) comma = spec.size();
+      std::string part = spec.substr(pos, comma - pos);
+      size_t dash = part.find('-');
+      int lo = atoi(part.c_str()), hi = dash == std::string::npos ? lo : atoi(part.c_str() + dash + 1);
+      for (int c = lo; c <= hi && c < CPU_SETSIZE; ++c) {
+        if (c >= 0) { CPU_SET(c, &set); any = true; }
+      }
+      pos = comma + 1;
+    }
+    return set;
+  }
+  KtJobs() {
+    int n = getenv("KT_GGUF_PREFETCH_THREADS") ? atoi(getenv("KT_GGUF_PREFETCH_THREADS")) : 16;
+    n = n < 1 ? 1 : (n > 64 ? 64 : n);
+    bool pin = false;
+    const cpu_set_t cpus = reader_cpus(pin);
+    if (pin) fprintf(stderr, "[kt-gguf-cache] %d reader threads pinned to %s\n", n, getenv("KT_GGUF_PREFETCH_CPUS"));
+    for (int i = 0; i < n; ++i) {
+      std::thread([this, pin, cpus] {
+        if (pin) pthread_setaffinity_np(pthread_self(), sizeof(cpu_set_t), &cpus);
+        for (;;) {
+          std::function<void()> job;
+          {
+            std::unique_lock<std::mutex> lk(mu);
+            cv.wait(lk, [this] { return !q.empty(); });
+            job = std::move(q.front());
+            q.pop_front();
+          }
+          job();
+          std::lock_guard<std::mutex> lk(mu);
+          if (--pending == 0) done.notify_all();
+        }
+      }).detach();
+    }
+  }
+  // queues the jobs and returns; whoever needs one waits on its own counter
+  void submit_all(std::vector<std::function<void()>>& jobs) {
+    if (jobs.empty()) return;
+    std::lock_guard<std::mutex> lk(mu);
+    pending += jobs.size();
+    for (auto& j : jobs) q.push_back(std::move(j));
+    cv.notify_all();
+  }
+  // runs every job on the threads and returns when all are done (one caller at a time)
+  void run_all(std::vector<std::function<void()>>& jobs) {
+    if (jobs.empty()) return;
+    std::unique_lock<std::mutex> lk(mu);
+    pending += jobs.size();
+    for (auto& j : jobs) q.push_back(std::move(j));
+    cv.notify_all();
+    done.wait(lk, [this] { return pending == 0; });
+  }
+};
