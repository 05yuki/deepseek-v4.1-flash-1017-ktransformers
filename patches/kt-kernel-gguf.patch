+  };
+  std::unordered_map<uint64_t, Entry> map;
+  std::list<uint64_t> lru;  // front = most recent
+  std::vector<Entry> transient;  // a wide forward's misses: read for it alone, freed at its end
+  // KT_GGUF_CACHE_SLOT_MIB: cached entries in fixed slots, 64 slots a block
+  size_t slot_bytes = 0;
+  std::vector<uint8_t*> slab_free;
+  size_t slab_slots = 0;
+  // KT_GGUF_CACHE_IQ1M_T=1 repacks IQ1_M tensors; their entries are larger than the
+  // others, so slots come in size classes of 64 KiB steps, 64 a block
+  static bool repack_on() {
+    static const bool on = getenv("KT_GGUF_CACHE_IQ1M_T") != nullptr && getenv("KT_GGUF_CACHE_IQ1M_T")[0] == '1';
+    return on;
+  }
+  std::unordered_map<size_t, std::vector<uint8_t*>> slab_cls;
+  static size_t slot_class(size_t need) { return (need + 65535) & ~size_t(65535); }
+  uint8_t* slab_take_cls(size_t need) {
+    const size_t cls = slot_class(need);
+    auto& fl = slab_cls[cls];
+    if (fl.empty()) {
+      void* blk = nullptr;
+      if (posix_memalign(&blk, 4096, cls * 64) != 0) return nullptr;
+      for (int i = 63; i >= 0; --i) fl.push_back((uint8_t*)blk + (size_t)i * cls);
+      slab_slots += 64;
+    }
+    uint8_t* sl = fl.back();
+    fl.pop_back();
+    return sl;
+  }
+  void slot_give_back(uint8_t* sl, size_t cls) {
+    if (cls) slab_cls[cls].push_back(sl);
+    else slab_free.push_back(sl);
+  }
+  uint8_t* slab_take(size_t need) {
+    if (repack_on()) return slab_take_cls(need);
+    if (slot_bytes == 0) {
+      const char* sm = getenv("KT_GGUF_CACHE_SLOT_MIB");
+      slot_bytes = sm ? (size_t)atof(sm) * (size_t(1) << 20) : (need * 5 / 4 + 4095) & ~size_t(4095);
+      fprintf(stderr, "[kt-gguf-cache] slots of %.2f MiB (first expert %.2f MiB)\n", slot_bytes / 1048576.0, need / 1048576.0);
+    }
+    if (need > slot_bytes) return nullptr;
+    if (slab_free.empty()) {
+      void* blk = nullptr;
+      if (posix_memalign(&blk, 4096, slot_bytes * 64) != 0) return nullptr;
+      for (int i = 63; i >= 0; --i) slab_free.push_back((uint8_t*)blk + (size_t)i * slot_bytes);
+      slab_slots += 64;
+    }
+    uint8_t* sl = slab_free.back();
+    slab_free.pop_back();
+    return sl;
+  }
+  void entry_free(Entry& e) {
+    if (e.slot) {
+      slot_give_back(e.slot, e.slot_cls);
+      e.slot = nullptr;
+    } else {
+      for (int t = 0; t < 3; ++t) free(e.mem[t]);
+    }
+  }
+  int keep_rows = 16;  // KT_GGUF_CACHE_KEEP_ROWS: forwards this wide or wider do not fill the cache
+  std::mutex mu;            // one forward prepares at a time
+  KtJobs jobs;
+  struct FileMap { uintptr_t lo, hi; uint64_t off; int fd_direct, fd; };
+  std::vector<FileMap> maps;
+
+  KtExpertCache() {
+    if (const char* kr = getenv("KT_GGUF_CACHE_KEEP_ROWS")) keep_rows = std::max(1, atoi(kr));
+    const char* e = getenv("KT_GGUF_EXPERT_CACHE_GIB");
+    budget = e ? (size_t)(atof(e) * (1ull << 30)) : 0;
+  }
+  bool on() const { return budget > 0; }
+
+  // the GGUF files mapped into this process (the loader's np.memmap), read once
+  void load_maps() {
+    FILE* f = fopen("/proc/self/maps", "r");
+    if (!f) return;
+    char line[4096];
+    while (fgets(line, sizeof(line), f)) {
+      unsigned long lo, hi, off;
+      char perms[8], dev[16], path[3072] = {0};
+      unsigned long inode;
+      if (sscanf(line, "%lx-%lx %7s %lx %15s %lu %3071[^\n]", &lo, &hi, perms, &off, dev, &inode, path) < 7) continue;
+      std::string ps(path);
+      size_t a = ps.find_first_not_of(' ');
+      if (a == std::string::npos) continue;
+      ps = ps.substr(a);
+      if (ps.size() < 5 || ps.compare(ps.size() - 5, 5, ".gguf") != 0) continue;
+      int fdd = open(ps.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+      int fd = open(ps.c_str(), O_RDONLY | O_CLOEXEC);
+      maps.push_back({(uintptr_t)lo, (uintptr_t)hi, (uint64_t)off, fdd, fd});
+    }
+    fclose(f);
+  }
+  const FileMap* find(const uint8_t* p) {
+    if (maps.empty()) load_maps();
+    for (auto& m : maps)
+      if ((uintptr_t)p >= m.lo && (uintptr_t)p < m.hi) return &m;
+    return nullptr;
+  }
+
+  // reads [src, src + n) of a mapped GGUF into a fresh 4 KiB-aligned buffer; the jobs fill it
+  bool plan_read(const uint8_t* src, size_t n, uint8_t*& mem, uint8_t*& data, std::vector<std::function<void()>>& out,
+                 uint8_t* at = nullptr, std::shared_ptr<std::atomic<int>> left = nullptr) {
+    const FileMap* m = find(src);
+    if (!m || m->fd < 0) return false;
+    const uint64_t off = m->off + ((uintptr_t)src - m->lo);
+    const uint64_t lo = off & ~uint64_t(4095);
+    const size_t len = ((off + n - lo) + 4095) & ~size_t(4095);
+    void* buf = at;
+    if (!buf && posix_memalign(&buf, 4096, len) != 0) return false;
+    mem = (uint8_t*)buf;
+    data = mem + (off - lo);
+    static const size_t piece = [] {
+      const char* e = getenv("KT_GGUF_CACHE_PIECE_KIB");
+      long k = e ? atol(e) : 1024;
+      return (size_t)(k < 64 ? 64 : k) << 10;
+    }();
+    for (size_t done = 0; done < len; done += piece) {
+      const size_t k = std::min(piece, len - done);
+      uint8_t* dst = mem + done;
+      const uint64_t at = lo + done;
+      const int fdd = m->fd_direct, fd = m->fd;
+      if (left) left->fetch_add(1, std::memory_order_relaxed);
+      out.push_back([this, dst, at, k, fdd, fd, left] {
+        size_t got = 0;
+        while (got < k) {
+          ssize_t r = fdd >= 0 ? pread(fdd, dst + got, k - got, at + got) : -1;
+          if (r < 0) r = pread(fd, dst + got, k - got, at + got);  // no O_DIRECT here: through the page cache
+          if (r <= 0) break;
+          got += size_t(r);
+        }
+        read_bytes.fetch_add(got, std::memory_order_relaxed);
+        if (left) left->fetch_sub(1, std::memory_order_release);
+      });
+    }
+    return true;
+  }
+
+  // an IQ1_M tensor of `rows` rows (n raw bytes) read with O_DIRECT into a scratch buffer
+  // a piece of rows at a time: the raw rows go to [at, at + n) and their repacked copy (rows * nb * 76 bytes) to
+  // tdata, after them (at: the slot, or a fresh buffer for both)
+  static size_t rep_bytes(size_t n, int rows) {
+    return (size_t)rows * (n / (size_t)rows / kt_iq1mt::RAW_BLOCK) * kt_iq1mt::T_BLOCK;
+  }
+  bool plan_read_rep(const uint8_t* src, size_t n, int rows, uint8_t*& mem, uint8_t*& data, uint8_t*& tdata,
+                     std::vector<std::function<void()>>& out, uint8_t* at, std::shared_ptr<std::atomic<int>> left) {
+    const FileMap* m = find(src);
+    if (!m || m->fd < 0 || rows <= 0) return false;
+    const size_t row_raw = n / (size_t)rows;
+    const int nb = (int)(row_raw / kt_iq1mt::RAW_BLOCK);
+    const size_t row_t = (size_t)nb * kt_iq1mt::T_BLOCK;
+    const size_t raw_span = (n + 4095) & ~size_t(4095);
+    void* buf = at;
+    if (!buf && posix_memalign(&buf, 4096, raw_span + (size_t)rows * row_t) != 0) return false;
+    mem = data = (uint8_t*)buf;
+    tdata = data + raw_span;
+    const uint64_t off0 = m->off + ((uintptr_t)src - m->lo);
+    static const size_t piece = [] {
+      const char* e = getenv("KT_GGUF_CACHE_PIECE_KIB");
+      long k = e ? atol(e) : 1024;
+      return (size_t)(k < 64 ? 64 : k) << 10;
+    }();
+    const int per = std::max<int>(1, (int)(piece / row_raw));
+    for (int r0 = 0; r0 < rows; r0 += per) {
+      const int r1 = std::min(rows, r0 + per);
+      const uint64_t off = off0 + (uint64_t)r0 * row_raw;
+      const uint64_t lo = off & ~uint64_t(4095);
+      const size_t len = ((off + (size_t)(r1 - r0) * row_raw - lo) + 4095) & ~size_t(4095);
+      uint8_t* rdst = data + (size_t)r0 * row_raw;
+      uint8_t* dst = tdata + (size_t)r0 * row_t;
+      const size_t rbytes = (size_t)(r1 - r0) * row_raw;
+      const int fdd = m->fd_direct, fd = m->fd;
+      if (left) left->fetch_add(1, std::memory_order_relaxed);
+      out.push_back([this, rdst, dst, rbytes, off, lo, len, r0, r1, nb, fdd, fd, left] {
+        void* tmp = nullptr;
+        if (posix_memalign(&tmp, 4096, len) == 0) {
+          size_t got = 0;
+          while (got < len) {
+            ssize_t r = fdd >= 0 ? pread(fdd, (uint8_t*)tmp + got, len - got, lo + got) : -1;
+            if (r < 0) r = pread(fd, (uint8_t*)tmp + got, len - got, lo + got);
+            if (r <= 0) break;
+            got += size_t(r);
+          }
+          read_bytes.fetch_add(got, std::memory_order_relaxed);
+          memcpy(rdst, (const uint8_t*)tmp + (off - lo), rbytes);
+          kt_iq1mt::repack_rows((const uint8_t*)tmp + (off - lo), dst, (size_t)(r1 - r0), nb);
+          free(tmp);
+        }
+        if (left) left->fetch_sub(1, std::memory_order_release);
+      });
+    }
+    return true;
+  }
+
+  void evict_for(size_t need) {
+    while (used + need > budget && !lru.empty()) {
+      bool freed = false;
+      for (auto it = lru.end(); it != lru.begin();) {
+        --it;
+        Entry& e = map[*it];
+        if (e.pins) continue;
+        entry_free(e);
+        used -= e.bytes;
+        map.erase(*it);
+        lru.erase(it);
+        freed = true;
+        break;
+      }
+      if (!freed) return;  // everything pinned: this forward needs more than the budget; it is let through
+    }
+  }
+
+  // the gate / up / down of each of the n experts (layer key), read where missing; pins them
+  void acquire(uint64_t layer_key, const int64_t* ids, int n, uint8_t* const src[][3], const size_t bytes[3],
+               uint8_t* out[][3], bool keep = true, bool async = false,
+               std::shared_ptr<std::atomic<int>>* left = nullptr, const int* rep_rows = nullptr,
+               uint8_t* rep_out = nullptr) {
+    const auto tl0 = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lk(mu);
+    const auto tl1 = std::chrono::steady_clock::now();
+    lock_ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(tl1 - tl0).count(), std::memory_order_relaxed);
+    std::vector<std::function<void()>> reads;
+    for (int i = 0; i < n; ++i) {
+      const uint64_t key = (layer_key << 32) | (uint64_t)ids[i];
+      auto f = map.find(key);
+      if (f != map.end()) {
+        Entry& e = f->second;
+        if (keep) lru.splice(lru.begin(), lru, e.at);  // a wide forward leaves the decode order alone
+        if (e.pins++ == 0) {}
+        for (int t = 0; t < 3; ++t) out[i][t] = (e.rep >> t) & 1 ? e.tdata[t] : e.data[t];
+        if (rep_out) rep_out[i] = e.rep;
+        // an entry another forward is still reading (its reads were asynchronous): wait on its counter
+        if (left) left[i] = (e.left && e.left->load(std::memory_order_acquire) > 0) ? e.left : nullptr;
+        hits.fetch_add(1, std::memory_order_relaxed);
+        continue;
+      }
+      if (left) left[i] = nullptr;
+      if (rep_out) rep_out[i] = 0;
+      // a repacked tensor keeps its raw rows and takes rows * nb * 76 bytes more
+      size_t tb[3];
+      for (int t = 0; t < 3; ++t)
+        tb[t] = rep_rows && rep_rows[t] > 0 ? ((bytes[t] + 4095) & ~size_t(4095)) + rep_bytes(bytes[t], rep_rows[t]) : bytes[t];
+      const size_t need = tb[0] + tb[1] + tb[2] + 3 * 8192;
+      Entry e;
+      if (keep) {
+        evict_for(need);
+        e.slot = slab_take(need);
+        if (e.slot && repack_on()) e.slot_cls = slot_class(need);
+      }
+      if (async) e.left = std::make_shared<std::atomic<int>>(0);
+      bool ok = true;
+      size_t o = 0;
+      for (int t = 0; t < 3 && ok; ++t) {
+        if (rep_rows && rep_rows[t] > 0) {
+          ok = plan_read_rep(src[i][t], bytes[t], rep_rows[t], e.mem[t], e.data[t], e.tdata[t], reads,
+                             e.slot ? e.slot + o : nullptr, e.left);
+          if (ok) e.rep |= (uint8_t)(1 << t);
+        } else {
+          ok = plan_read(src[i][t], bytes[t], e.mem[t], e.data[t], reads, e.slot ? e.slot + o : nullptr, e.left);
+        }
+        o += (tb[t] + 8191) & ~size_t(4095);
+      }
+      if (left) left[i] = e.left;
+      if (!ok) {  // not from a mapped GGUF: compute from the source as before
+        if (e.slot) slot_give_back(e.slot, e.slot_cls);
+        else for (int t = 0; t < 3; ++t) free(e.mem[t]);
+        for (int t = 0; t < 3; ++t) out[i][t] = src[i][t];
+        continue;
+      }
+      if (rep_out) rep_out[i] = e.rep;
+      if (!keep) {  // read for this forward only
+        for (int t = 0; t < 3; ++t) out[i][t] = (e.rep >> t) & 1 ? e.tdata[t] : e.data[t];
+        transient.push_back(e);
+        misses.fetch_add(1, std::memory_order_relaxed);
+        continue;
+      }
+      e.bytes = e.slot ? (e.slot_cls ? e.slot_cls : slot_bytes) : need;
+      e.pins = 1;
+      lru.push_front(key);
+      e.at = lru.begin();
+      used += e.bytes;
+      for (int t = 0; t < 3; ++t) out[i][t] = (e.rep >> t) & 1 ? e.tdata[t] : e.data[t];
+      map.emplace(key, e);
+      misses.fetch_add(1, std::memory_order_relaxed);
+    }
+    const auto t0 = std::chrono::steady_clock::now();
+    if (async) jobs.submit_all(reads);
+    else jobs.run_all(reads);
+    const auto t1 = std::chrono::steady_clock::now();
+    if (async) {
+      loop_ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(t0 - tl1).count(), std::memory_order_relaxed);
+      submit_ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count(), std::memory_order_relaxed);
+      acquires.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      read_ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count(), std::memory_order_relaxed);
+    }
+  }
+  std::atomic<uint64_t> submit_ns{0};
+  std::atomic<uint64_t> lock_ns{0}, loop_ns{0}, acquires{0};
+
+  void release(uint64_t layer_key, const int64_t* ids, int n) {
+    std::lock_guard<std::mutex> lk(mu);
+    for (int i = 0; i < n; ++i) {
+      auto f = map.find((layer_key << 32) | (uint64_t)ids[i]);
+      if (f != map.end() && f->second.pins > 0) f->second.pins--;
+    }
+    for (Entry& e : transient)
+      for (int t = 0; t < 3; ++t) free(e.mem[t]);
+    transient.clear();
+  }
+
+  void report() {
+    static std::atomic<uint64_t> last{0};
+    const uint64_t calls = hits.load() + misses.load();
+    if (calls - last.load() < 200000) return;
+    last = calls;
+    fprintf(stderr, "[kt-gguf-cache] %.1f of %.1f GiB, %llu experts, hits %.1f%%, %.2f GiB read at %.2f GB/s\n",
+            used / 1073741824.0, budget / 1073741824.0, (unsigned long long)map.size(),
+            100.0 * hits.load() / std::max<uint64_t>(1, calls), read_bytes.load() / 1073741824.0,
+            read_bytes.load() / std::max(1.0, (double)read_ns.load()));
+  }
+};
+// a resident expert's tensors for a reader outside kt-kernel
+// (the streamed prefill), pinned until kt_gguf_cache_unpin; 0 when absent or still being read
+inline int kt_gguf_cache_peek(uint64_t layer_key, int64_t id, uintptr_t out[3]);
+inline void kt_gguf_cache_unpin(uint64_t layer_key, int64_t id);
+inline KtExpertCache& kt_expert_cache() {
+  static KtExpertCache* c = new KtExpertCache();
+  return *c;
+}
+inline int kt_gguf_cache_peek(uint64_t layer_key, int64_t id, uintptr_t out[3]) {
+  KtExpertCache& c = kt_expert_cache();
+  std::lock_guard<std::mutex> lk(c.mu);
+  auto f = c.map.find((layer_key << 32) | (uint64_t)id);
+  if (f == c.map.end()) return 0;
+  KtExpertCache::Entry& e = f->second;
+  if (e.left && e.left->load(std::memory_order_acquire) > 0) return 0;  // its reads are still landing
+  e.pins++;
+  for (int t = 0; t < 3; ++t) out[t] = (uintptr_t)e.data[t];
+  return 1;
+}
+inline void kt_gguf_cache_unpin(uint64_t layer_key, int64_t id) {
+  KtExpertCache& c = kt_expert_cache();
+  std::lock_guard<std::mutex> lk(c.mu);
+  auto f = c.map.find((layer_key << 32) | (uint64_t)id);
+  if (f != c.map.end() && f->second.pins > 0) f->second.pins--;
+}
