+// kt_iq1mt.hpp: IQ1_M experts repacked for the CPU decode, and their GEMM.
+//
+// iqk's mul_mat_iq1_m_q8_K builds each 8-value group from iq1s_grid with a scalar index and a 64-bit table load,
+// 32 a block: on Zen 2 that, not memory, bounds it (28 threads read 28 GB/s of IQ1_M weights). The expert cache
+// (KT_GGUF_CACHE_IQ1M_T=1) stores IQ1_M tensors repacked when it reads them, 76 bytes a 256-value block
+// (IQ1_M: 56):
+//   codes[64]  the grid digit (0, 1, 2) of value b + 64k in bits 2k..2k+1 of byte b
+//   neg        bit g set when 8-value group g has delta -1/8
+//   scales[8]  IQ1_M's scale bytes unchanged (the 3-bit scales and the fp16 d's nibbles)
+// and the GEMM decodes 32 values with a shift, a mask, a 16-entry byte shuffle and one add, then does the same
+// integer dot products in the same order as iqk's kernel: the results are bit-identical, at 2.1x the speed on 28
+// threads (80 GB/s of repacked weights).
+#pragma once
+#include <immintrin.h>
+#include <cstdint>
+#include <cstring>
+
+namespace kt_iq1mt {
+
+constexpr int QK = 256;
+constexpr int RAW_BLOCK = 56;   // block_iq1_m
+constexpr int T_BLOCK = 76;     // the repacked block
+struct block_raw { uint8_t qs[32]; uint8_t qh[16]; uint8_t scales[8]; };
+struct block_t { uint8_t codes[64]; uint32_t neg; uint8_t scales[8]; };
+struct block_q8K { float d; int8_t qs[QK]; int16_t bsums[QK / 16]; };
+static_assert(sizeof(block_raw) == RAW_BLOCK && sizeof(block_t) == T_BLOCK && sizeof(block_q8K) == 292, "layouts");
