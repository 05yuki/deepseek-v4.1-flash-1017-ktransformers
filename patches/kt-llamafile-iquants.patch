+static bool iqk_type_disabled(int typeA) {
+    static const uint64_t mask = [] {
+        uint64_t m = 0;
+        const char * e = getenv("KT_IQK_DISABLE");
+        if (!e) return m;
+        for (const char * p = e; *p; ) {
+            char * end;
+            long v = strtol(p, &end, 10);
+            if (end == p) { ++p; continue; }
+            if (v >= 0 && v < 64) m |= uint64_t(1) << v;
+            p = end;
+        }
+        return m;
+    }();
+    return typeA >= 0 && typeA < 64 && (mask >> typeA) & 1;
+}
