--- /dev/null
+++ b/kt-kernel/operators/avx2/mxfp4-expert-cache.hpp
@@ -0,0 +1,469 @@
+// KT_MXFP4_EXPERT_CACHE_GIB=<n>: the routed experts of the MXFP4 backend live in a RAM cache of n GiB instead of
+// being copied whole into RAM at load. Each expert is read from the checkpoint's safetensors files (O_DIRECT) into a
+// fixed slot of one memfd arena: gate, up and down weights as the checkpoint packs them, then their ue8m0 scale
+// bytes, each piece at a 4 KiB boundary. The FP4 kernels read the scale bytes as their one-byte scale codes against
+// a fixed 256-entry table (ue8m0 e -> 2^(e-127), the values the bf16 load path gives bit for bit); forwards wider
+// than one token get their fp32 scales expanded into a scratch for the kernels that read them.
+//
+// Decode forwards (narrower than KT_MXFP4_CACHE_KEEP_ROWS, 16) keep what they read, least recently used out first;
+// wider forwards read their misses for themselves and leave the cache alone. The arena is a memfd so the GPU side
+// can map it and DMA hits straight from the slots (kt_cache_info()).
+#ifndef KT_MXFP4_EXPERT_CACHE_HPP
+#define KT_MXFP4_EXPERT_CACHE_HPP
+
+#include <fcntl.h>
+#include <sched.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <list>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace kt_mxc {
+
+inline double env_f(const char* n, double dflt) {
+  const char* e = std::getenv(n);
+  return e && e[0] ? std::atof(e) : dflt;
+}
+
+inline bool on() {
+  static const bool v = env_f("KT_MXFP4_EXPERT_CACHE_GIB", 0) > 0;
+  return v;
+}
+
+// ue8m0 -> fp32 as the bf16 load path converts it: e << 7 as bf16 (e = 0 gives +0, e = 255 gives +inf)
+inline float e8m0_f32(uint8_t e) {
+  uint32_t bits = (uint32_t)e << 23;
+  float f;
+  std::memcpy(&f, &bits, 4);
+  return f;
+}
+
+inline const float* e8m0_table() {
+  alignas(64) static float t[256];
+  static bool init = [] {
+    for (int i = 0; i < 256; i++) t[i] = e8m0_f32((uint8_t)i);
+    return true;
+  }();
+  (void)init;
+  return t;
+}
+
+inline std::vector<int> parse_cpus(const char* spec) {
+  std::vector<int> v;
+  if (!spec) return v;
+  std::string s(spec);
+  size_t p = 0;
+  while (p < s.size()) {
+    size_t q = s.find(',', p);
+    if (q == std::string::npos) q = s.size();
+    std::string part = s.substr(p, q - p);
+    size_t d = part.find('-');
+    if (!part.empty()) {
+      int lo = std::atoi(part.substr(0, d).c_str());
+      int hi = d == std::string::npos ? lo : std::atoi(part.substr(d + 1).c_str());
+      for (int c = lo; c <= hi; c++) v.push_back(c);
+    }
+    p = q + 1;
+  }
+  return v;
+}
+
+// reader threads (KT_MXFP4_CACHE_READERS, 16), on KT_IO_CPUS when set
+class Jobs {
+ public:
+  Jobs() {
+    int n = (int)env_f("KT_MXFP4_CACHE_READERS", 16);
+    if (n < 1) n = 1;
+    std::vector<int> cpus = parse_cpus(std::getenv("KT_IO_CPUS"));
+    for (int i = 0; i < n; i++)
+      th_.emplace_back([this, cpus] {
+        if (!cpus.empty()) {
+          cpu_set_t set;
+          CPU_ZERO(&set);
+          for (int c : cpus) CPU_SET(c, &set);
+          sched_setaffinity(0, sizeof(set), &set);
+        }
+        for (;;) {
+          std::function<void()> f;
+          {
+            std::unique_lock<std::mutex> lk(mu_);
+            cv_.wait(lk, [this] { return stop_ || !q_.empty(); });
+            if (stop_ && q_.empty()) return;
+            f = std::move(q_.front());
+            q_.pop_front();
+          }
+          f();
+          {
+            std::lock_guard<std::mutex> lk(mu_);
+            if (--pending_ == 0) done_.notify_all();
+          }
+        }
+      });
+  }
+  ~Jobs() {
+    {
+      std::lock_guard<std::mutex> lk(mu_);
+      stop_ = true;
+    }
+    cv_.notify_all();
+    for (auto& t : th_) t.join();
+  }
+  // queues the jobs on the readers
+  void submit(std::vector<std::function<void()>>& jobs) {
+    if (jobs.empty()) return;
+    {
+      std::lock_guard<std::mutex> lk(mu_);
+      for (auto& j : jobs) q_.push_back(std::move(j));
+      pending_ += jobs.size();
+    }
+    cv_.notify_all();
+    jobs.clear();
+  }
+  // returns when every queued job is done
+  void wait() {
+    std::unique_lock<std::mutex> lk(mu_);
+    done_.wait(lk, [this] { return pending_ == 0; });
+  }
+  void run_all(std::vector<std::function<void()>>& jobs) {
+    submit(jobs);
+    wait();
+  }
+
+ private:
+  std::vector<std::thread> th_;
+  std::deque<std::function<void()>> q_;
+  std::mutex mu_;
+  std::condition_variable cv_, done_;
+  size_t pending_ = 0;
+  bool stop_ = false;
+};
+
+class Cache {
+ public:
+  static Cache& get() {
+    static Cache c;
+    return c;
+  }
+
+  // the six pieces of a slot: gate, up, down weights, gate, up, down scale bytes
+  size_t off[6] = {0}, bytes[6] = {0};
+  size_t slot_bytes = 0, nslots = 0;
+  int fd = -1;
+  uint8_t* base = nullptr;
+  int keep_rows = 16;
+  std::atomic<uint64_t> hits{0}, misses{0}, transient_reads{0}, read_bytes{0}, read_ns{0}, evictions{0};
+
+  // the slot layout from the first layer's shapes (all layers share them); allocates the arena
+  void init(size_t n_inter, size_t hidden, size_t group) {
+    std::lock_guard<std::mutex> lk(mu_);
+    const size_t w13 = n_inter * hidden / 2, w2 = hidden * n_inter / 2;
+    const size_t s13 = n_inter * (hidden / group), s2 = hidden * (n_inter / group);
+    const size_t want[6] = {w13, w13, w2, s13, s13, s2};
+    if (base) {
+      for (int i = 0; i < 6; i++)
+        if (bytes[i] != want[i]) throw std::runtime_error("KT_MXFP4_EXPERT_CACHE_GIB: layers differ in expert shape");
+      return;
+    }
+    size_t o = 0;
+    for (int i = 0; i < 6; i++) {
+      off[i] = o;
+      bytes[i] = want[i];
+      o += (want[i] + 4095) & ~size_t(4095);
+    }
+    slot_bytes = (o + (size_t(2) << 20) - 1) & ~((size_t(2) << 20) - 1);  // whole 2 MB pages
+    const size_t budget = (size_t)(env_f("KT_MXFP4_EXPERT_CACHE_GIB", 0) * (double)(size_t(1) << 30));
+    nslots = budget / slot_bytes;
+    if (nslots < 64) throw std::runtime_error("KT_MXFP4_EXPERT_CACHE_GIB: under 64 experts' worth");
+    keep_rows = std::max(1, (int)env_f("KT_MXFP4_CACHE_KEEP_ROWS", 16));
+    fd = memfd_create("kt_mxfp4_cache", 0);
+    if (fd < 0) throw std::runtime_error("memfd_create failed for the expert cache");
+    if (ftruncate(fd, (off_t)(nslots * slot_bytes)) != 0) throw std::runtime_error("ftruncate of the expert cache");
+    void* m = mmap(nullptr, nslots * slot_bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (m == MAP_FAILED) throw std::runtime_error("mmap of the expert cache");
+    madvise(m, nslots * slot_bytes, MADV_HUGEPAGE);
+    base = (uint8_t*)m;
+    free_.reserve(nslots);
+    for (size_t i = nslots; i-- > 0;) free_.push_back((int)i);
+    std::printf("[kt-mxfp4-cache] %zu slots of %.2f MiB (%.1f GiB), expert %.2f MiB, keep rows < %d\n", nslots,
+                slot_bytes / 1048576.0, nslots * slot_bytes / 1073741824.0, o / 1048576.0, keep_rows);
+    std::fflush(stdout);
+  }
+
+  int file_index(const std::string& path) {
+    std::lock_guard<std::mutex> lk(mu_);
+    auto f = file_idx_.find(path);
+    if (f != file_idx_.end()) return f->second;
+    int fdd = open(path.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+    int fdb = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fdb < 0) throw std::runtime_error("KT_MXFP4_EXPERT_CACHE_GIB: cannot open " + path);
+    files_.push_back({fdd, fdb});
+    file_idx_[path] = (int)files_.size() - 1;
+    return (int)files_.size() - 1;
+  }
+
+  // where expert lid of a layer is in the checkpoint: per piece (as off/bytes above) a file and a byte offset
+  void set_source(int layer, uint64_t lid, const int file[6], const uint64_t foff[6], const uint64_t fbytes[6]) {
+    Src s;
+    for (int i = 0; i < 6; i++) {
+      if (fbytes[i] != bytes[i])
+        throw std::runtime_error("KT_MXFP4_EXPERT_CACHE_GIB: piece " + std::to_string(i) + " of layer " +
+                                 std::to_string(layer) + " expert " + std::to_string(lid) + " has " +
+                                 std::to_string(fbytes[i]) + " bytes, the slot " + std::to_string(bytes[i]));
+      s.file[i] = file[i];
+      s.off[i] = foff[i];
+    }
+    std::lock_guard<std::mutex> lk(mu_);
+    src_[key(layer, lid)] = s;
+  }
+
+  // Pins the n experts and gives each one's slot (or, for a forward that does not keep, a buffer of its own);
+  // reads what is missing. Every acquire is paired with release_all().
+  // missed[i] (when given) is set for the experts read now; async leaves their reads running (wait_reads())
+  void acquire(int layer, const uint64_t* lids, int n, uint8_t** out, bool keep, uint8_t* missed = nullptr,
+               bool async = false) {
+    std::vector<std::function<void()>> reads;
+    {
+      std::lock_guard<std::mutex> lk(mu_);
+      for (int i = 0; i < n; i++) {
+        const uint64_t k = key(layer, lids[i]);
+        held_.push_back(k);
+        auto f = map_.find(k);
+        if (missed) missed[i] = f == map_.end();
+        if (f != map_.end()) {
+          Entry& e = f->second;
+          if (keep) lru_.splice(lru_.begin(), lru_, e.at);
+          e.pins++;
+          out[i] = base + (size_t)e.slot * slot_bytes;
+          hits.fetch_add(1, std::memory_order_relaxed);
+          continue;
+        }
+        auto s = src_.find(k);
+        if (s == src_.end())
+          throw std::runtime_error("KT_MXFP4_EXPERT_CACHE_GIB: no source for layer " + std::to_string(layer) +
+                                   " expert " + std::to_string(lids[i]));
+        uint8_t* dst = nullptr;
+        if (keep) {
+          int slot = take_slot();
+          if (slot >= 0) {
+            Entry e;
+            e.slot = slot;
+            e.pins = 1;
+            lru_.push_front(k);
+            e.at = lru_.begin();
+            map_.emplace(k, e);
+            dst = base + (size_t)slot * slot_bytes;
+          }
+        }
+        if (!dst) {  // read for this forward only
+          void* b = nullptr;
+          if (posix_memalign(&b, 4096, slot_bytes) != 0) throw std::runtime_error("expert cache: out of memory");
+          dst = (uint8_t*)b;
+          transient_.push_back(dst);
+          held_.pop_back();  // not in the map: nothing to unpin
+          transient_reads.fetch_add(1, std::memory_order_relaxed);
+        }
+        misses.fetch_add(1, std::memory_order_relaxed);
+        plan_reads(s->second, dst, reads);
+        out[i] = dst;
+      }
+    }
+    if (async) {
+      jobs_.submit(reads);
+      return;
+    }
+    const auto t0 = std::chrono::steady_clock::now();
+    jobs_.run_all(reads);
+    read_ns.fetch_add(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count(),
+        std::memory_order_relaxed);
+  }
+
+  // waits for an asynchronous acquire's reads (the time counts as waiting on the drive)
+  void wait_reads() {
+    const auto t0 = std::chrono::steady_clock::now();
+    jobs_.wait();
+    read_ns.fetch_add(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count(),
+        std::memory_order_relaxed);
+  }
+
+  void release_all() {
+    std::lock_guard<std::mutex> lk(mu_);
+    for (uint64_t k : held_) {
+      auto f = map_.find(k);
+      if (f != map_.end() && f->second.pins > 0) f->second.pins--;
+    }
+    held_.clear();
+    for (uint8_t* p : transient_) std::free(p);
+    transient_.clear();
+  }
+
+  // at load: reads the layer's experts in the given order into free slots, up to `count` of them
+  size_t fill(int layer, const uint64_t* lids, int n, int count) {
+    std::vector<std::function<void()>> reads;
+    size_t got = 0;
+    {
+      std::lock_guard<std::mutex> lk(mu_);
