+  // the six pieces in reads of up to KT_MXFP4_CACHE_PIECE_KIB (1024) of 4 KiB-aligned file range each, through a
+  // per-thread bounce buffer (the pieces' file offsets are not aligned)
+  void plan_reads(const Src& s, uint8_t* dst, std::vector<std::function<void()>>& out) {
+    static const size_t piece = [] {
+      size_t k = (size_t)env_f("KT_MXFP4_CACHE_PIECE_KIB", 1024);
+      return (k < 64 ? 64 : k) << 10;
+    }();
+    for (int t = 0; t < 6; t++) {
+      const uint64_t a = s.off[t], b = a + bytes[t];
+      const uint64_t lo = a & ~uint64_t(4095);
+      const int fdd = files_[s.file[t]].first, fdb = files_[s.file[t]].second;
+      uint8_t* d = dst + off[t];
+      for (uint64_t p = lo; p < b; p += piece) {
+        const uint64_t q = std::min<uint64_t>(p + piece, (b + 4095) & ~uint64_t(4095));
+        out.push_back([this, p, q, a, b, d, fdd, fdb] {
+          static thread_local uint8_t* bounce = nullptr;
+          static thread_local size_t cap = 0;
+          const size_t len = q - p;
+          if (cap < len) {
+            std::free(bounce);
+            if (posix_memalign((void**)&bounce, 4096, len) != 0) throw std::runtime_error("expert cache bounce");
+            cap = len;
+          }
+          size_t got = 0;
+          while (got < len) {
+            ssize_t r = fdd >= 0 ? pread(fdd, bounce + got, len - got, p + got) : -1;
+            if (r < 0) r = pread(fdb, bounce + got, len - got, p + got);
+            if (r <= 0) break;
+            got += size_t(r);
+          }
+          read_bytes.fetch_add(got, std::memory_order_relaxed);
+          const uint64_t c0 = std::max(p, a), c1 = std::min<uint64_t>(std::min(q, p + got), b);
+          if (c1 > c0) std::memcpy(d + (c0 - a), bounce + (c0 - p), c1 - c0);
+          if (p + got < std::min(q, b)) {
+            std::fprintf(stderr, "[kt-mxfp4-cache] short read at %llu (%zu of %zu)\n", (unsigned long long)p, got,
+                         len);
+            std::abort();
+          }
+        });
+      }
+    }
+  }
+
+  std::mutex mu_;
+  std::vector<int> free_;
+  std::unordered_map<uint64_t, Entry> map_;
+  std::list<uint64_t> lru_;
+  std::unordered_map<uint64_t, Src> src_;
+  std::vector<std::pair<int, int>> files_;
+  std::unordered_map<std::string, int> file_idx_;
+  std::vector<uint64_t> held_;
+  std::vector<uint8_t*> transient_;
+  uint64_t ticks_ = 0;
+  Jobs jobs_;
+};
