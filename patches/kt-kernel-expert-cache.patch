+  int take_slot() {
+    if (!free_.empty()) {
+      int s = free_.back();
+      free_.pop_back();
+      return s;
+    }
+    for (auto it = lru_.end(); it != lru_.begin();) {
+      --it;
+      auto f = map_.find(*it);
+      if (f->second.pins) continue;
+      int s = f->second.slot;
+      map_.erase(f);
+      lru_.erase(it);
+      evictions.fetch_add(1, std::memory_order_relaxed);
+      return s;
+    }
+    return -1;
